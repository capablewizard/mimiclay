// Plasticine surface for ORDINARY geometry (engine primitives, imported meshes) — no SurfaceNets vertex
// data, so g_bUseVertexData is off: albedo comes from g_vTintColor alone instead of vertex colour, and
// roughness/metalness come from the sliders instead of the per-brush pair packed into TexCoord0.

Layer0
{
	shader "shaders/sdf_mesh.shader"

	//---- Fog ----
	g_bFogEnabled "1"

	//---- Surface ----
	g_bUseVertexData "0"
	g_flDarkSatBoost "1.000"
	g_flMetalness "0.000"
	g_flNormalStrength "1.000"
	g_flRoughness "0.950"
	g_flTriBlend "6.000"
	g_flTriTile "0.500"
	g_flTriTileNormal "0.500"
	g_vTintColor "[1.000000 1.000000 1.000000 0.000000]"
	TextureColor "materials/plasticine/plasticine_basecolor.png"
	TextureNormal "materials/plasticine/plasticine_normal_4.png"
	TextureRoughness "materials/default/default_rough.tga"
}
