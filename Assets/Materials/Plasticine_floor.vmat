// Ported from complex.shader to clay_world.shader (same texture/param names) so the
// floor participates in the camera-occlusion cutout — see clay_cutout.hlsl.

Layer0
{
	shader "shaders/clay_world.shader"

	//---- Material ----
	g_vColorTint "[1.000000 1.000000 1.000000]"
	TextureColor "materials/lambert1_green bad mix_mask.png"
	TextureNormal "materials/plasticine_imperfections_17.png"
	TextureRoughness "materials/default/default_rough.tga"
	g_flRoughnessScaleFactor "1.000"
	g_flMetalness "0.000"
	g_vTexCoordScale "[20.000 20.000]"
}
