@using System
@using System.Collections.Generic
@using System.Globalization
@using Sandbox
@using Sandbox.UI
@namespace Mimiclay
@inherits PanelComponent

@*
	In-game sculpt editor HUD. Binds to SculptEditSession.Current, so it's identical in prop-hunt or
	creative mode — drop this PanelComponent on a HUD GameObject and it shows two panels whenever a
	session is editing: left = add shapes + layer stack, right = selected-brush properties.
*@

<root class=@RootClass>

	@* While dragging a layer OR scrubbing a slider, a full-screen transparent surface keeps a pointer-events:all
	   region under the cursor so the native drag keeps firing OnDrag/OnDragEnd. Otherwise the thin slider track /
	   the gaps between floating cards click through to the world, stalling the drag and swallowing the mouse-up. *@
	@if ( _dragIndex >= 0 || ClaySlider.Dragging || ClayColorPicker.Dragging )
	{
		<div class="drag-capture"></div>
	}

	@* Transient refusal toast: the session just refused a layer action that would have left no solid
	   clay — deleting, hiding or carving the last additive brush (no shape means no collider, and a prop
	   pawn would fall through the floor). Same look and anchor as the validity toast below; it takes the
	   slot while active, being the direct response to the player's click. *@
	@if ( NoSolidToast )
	{
		<div class="validity-float" style="bottom: @((int)ToastBottom())px;">
			<div class="paper-card validity-toast">
				<span class="emoji">⚠️</span>
				<span>Must have at least 1 shape</span>
			</div>
		</div>
	}
	@* Sculpt-validity toast: shows whenever the LOCAL player's sculpt violates its SculptBounds and stays
	   until fixed, edit mode or not — the invalid shape is owner-local (never broadcast), so the player
	   has to know the world doesn't see what they see. Floats above the shape dock while the dock is
	   shown; hugs the bottom of the screen otherwise (see ToastPos). *@
	else if ( InvalidBounds is { } inv )
	{
		@* Full-width flex wrapper + a bottom anchor, so neither axis depends on the toast's own measured
		   size — a freshly mounted panel has no rect for a frame, and position computed from an estimated
		   size rendered one frame off-centre before snapping (the dock gets away with it because its width
		   never changes). CSS centres x exactly; growing up from `bottom` makes height irrelevant. *@
		<div class="validity-float" style="bottom: @((int)ToastBottom())px;">
			<div class="paper-card validity-toast">
				<span class="emoji">⚠️</span>
				<span>@(inv.TooBig ? "Sculpt too large" : "Sculpt too small")</span>
			</div>
		</div>
	}

	@* Exit-confirm dialog: leaving edit mode with an incompatible sculpt REVERTS it to the last valid
	   shape (see SculptEditSession.RequestExit) — this makes that a choice, not a surprise. The scrim
	   owns the pointer so nothing world-side fires underneath, and PointerOverUi reports true while it's
	   up so picks/stamps/scrubs stay parked too. *@
	@if ( Session is not null && Session.ExitConfirmPending )
	{
		<div class="exit-confirm">
			<div class="paper-card confirm-card">
				<div class="confirm-title">
					<span class="emoji">⚠️</span>
					<span>@(Session.ExitConfirmTooBig ? "Sculpt too large" : "Sculpt too small")</span>
				</div>
				<div class="confirm-body">We'll use your last good shape.</div>
				<div class="confirm-buttons">
					<div class="btn" @onclick=@(() => Session?.CancelExit())>Keep Editing</div>
					<div class="btn" @onclick=@(() => Session?.ConfirmExit())>Revert</div>
				</div>
			</div>
		</div>
	}

	@if ( Session is not null && Session.IsEditing )
	{
		@* (The alt-nav view hints that used to sit top-right are gone — the picker column lives there now,
		   and the alt gestures are covered by muscle memory / the menu's own copy.) *@

		@* Hotkey hint strip, bottom-centre — contextual: the stamp scheme while placing, the selection
		   scheme while editing. The S/D labels live-update with the active shape. *@
		@* Hidden while a guided tutorial step runs — the tutorial card teaches one thing at a time, and the
		   full key list underneath it would drown that. Back the moment guidance ends (free-play included). *@
		<div class="hint-strip @(TutorialDirector.HintStripHidden ? "hidden" : "")">
			@if ( Session.Tool == SculptTool.Sculpt && Session.ActiveShape == SdfShape.Spline )
			{
				@* Chain placement has its own verbs: click points along the curve, right-click/Enter ends it. *@
				<div class="hint"><span class="key">LMB</span><span>@(Session.ChainWillLoop ? "close loop" : "add point")</span></div>
				<div class="hint"><span class="key">RMB tap / Space</span><span>finish</span></div>
				<div class="hint"><span class="key">Scroll</span><span>depth</span></div>
				<div class="hint"><span class="key">R</span><span>point size</span></div>
				<div class="hint"><span class="key">Shift</span><span>snap</span></div>
				<div class="hint"><span class="key">A</span><span>add / carve / cutout</span></div>
				<div class="hint"><span class="key">S</span><span>blend</span></div>
				<div class="hint"><span class="key">D</span><span>smooth</span></div>
				<div class="hint"><span class="key">Tab</span><span>wireframe</span></div>
				<div class="hint"><span class="key">Esc</span><span>cancel</span></div>
			}
			else if ( Session.Tool == SculptTool.Sculpt )
			{
				<div class="hint"><span class="key">LMB</span><span>@(Session.StampOperation == SdfOperation.Subtract ? "carve" : Session.StampOperation == SdfOperation.Cutout ? "cutout" : "stamp")</span></div>
				<div class="hint"><span class="key">Scroll</span><span>depth</span></div>
				<div class="hint"><span class="key">RMB tap</span><span>done</span></div>
				<div class="hint"><span class="key">R</span><span>scale</span></div>
				<div class="hint"><span class="key">E</span><span>rotate</span></div>
				<div class="hint"><span class="key">Shift</span><span>snap</span></div>
				<div class="hint"><span class="key">A</span><span>add / carve / cutout</span></div>
				<div class="hint"><span class="key">S</span><span>blend</span></div>
				<div class="hint"><span class="key">D</span><span>@(SecondSliderName)</span></div>
				@if ( WildcardName is { } wc )
				{
					<div class="hint"><span class="key">F</span><span>@wc</span></div>
				}
				<div class="hint"><span class="key">1-7</span><span>shape</span></div>
				<div class="hint"><span class="key">Tab</span><span>wireframe</span></div>
				<div class="hint"><span class="key">Space</span><span>done</span></div>
				<div class="hint"><span class="key">Esc</span><span>cancel</span></div>
			}
			else
			{
				@if ( Session.SplineWillLoop )
				{
					<div class="hint hot"><span class="key">Release</span><span>close loop</span></div>
				}
				<div class="hint"><span class="key">LMB</span><span>select</span></div>
				<div class="hint"><span class="key">Ctrl+LMB</span><span>multi-select</span></div>
				@if ( Session.SelectedBrush is not null )
				{
					<div class="hint"><span class="key">Scroll</span><span>depth</span></div>
					<div class="hint"><span class="key">RMB tap</span><span>deselect</span></div>
					<div class="hint"><span class="key">W</span><span>move</span></div>
					<div class="hint"><span class="key">R</span><span>scale</span></div>
					<div class="hint"><span class="key">E</span><span>rotate</span></div>
					<div class="hint"><span class="key">Shift</span><span>snap</span></div>
					<div class="hint"><span class="key">A</span><span>add / carve / cutout</span></div>
					<div class="hint"><span class="key">S</span><span>blend</span></div>
					<div class="hint"><span class="key">D</span><span>@(SecondSliderName)</span></div>
					@if ( WildcardName is { } wc )
					{
						<div class="hint"><span class="key">F</span><span>@wc</span></div>
					}
					<div class="hint"><span class="key">1-7</span><span>shape</span></div>
					<div class="hint"><span class="key">Del</span><span>delete</span></div>
				}
				<div class="hint"><span class="key">Space</span><span>add shape</span></div>
				<div class="hint"><span class="key">Tab</span><span>wireframe</span></div>
				<div class="hint"><span class="key">Q</span><span>done</span></div>
			}
		</div>

		@* Part dock — Head / Weapon (whatever parts the pawn wired onto its sessions; see
		   SculptEditSession.EditParts). Bottom-centre, only while nothing is selected and no stamp is held:
		   the neutral state, when the shape dock and sliders are down and the slot is free. The active part
		   is the usual selected-orange chip; clicking the other one switches which session is editing. *@
		@if ( PartDockShown )
		{
			<div class="part-dock" @ref="PartDockPanel">
				@foreach ( var entry in Session.EditParts )
				{
					var part = entry;
					<div class="chip @(part.Active ? "on" : "")" @onclick=@(() => part.Select?.Invoke())>
						<span>@part.Label</span>
					</div>
				}
			</div>
		}

		@* The left column is just the layer stack now — shape choice moved to the bottom dock (it's a
		   property of the brush, not a tool), and the Add/Edit mode toggle is gone entirely. *@
		@if ( ShowLayers && EditHudGate.Visible( HudSection.Layers ) )
		{
		<div class="panel left @EditHudGate.PanelClass( HudSection.Layers )" @ref="LeftPanel">
			<div class="section-title"><div class="icon">layers</div><span>Shapes</span></div>

			<div class="layers">
				@{
					var brushes = Session.Target?.Brushes;
					// Only the AUTHORED prefix gets rows — the damage tail (shot craters) is invisible to
					// editing. Damage is contiguous at the end, so row/index math stays exact with this count.
					var authored = Session.Target?.AuthoredBrushCount ?? 0;
				}
				@if ( brushes is not null )
				{
					@* Top of the list = last authored brush (drawn on top of the field, below any damage). *@
					@for ( int i = authored - 1; i >= 0; i-- )
					{
						var idx = i;
						var b = brushes[idx];
						if ( b == Session.StampBrush )
							continue; // the pending stamp ghost isn't a real layer yet — no row
						<LayerRow @key=@b class=@(LayerClass( idx )) style=@(LayerStyle( idx ))
							Index=@idx Shape=@b.Shape Operation=@b.Operation Color=@b.Color
							Enabled=@b.Enabled SymmetryOn=@(b.MirrorX || b.MirrorY || b.MirrorZ)
							PressStart=@HandlePressStart Pick=@HandlePick DragBegin=@HandleDragBegin DragMove=@HandleDragMove DragEnd=@HandleDragEnd
							ToggleEnabled=@HandleToggleEnabled ToggleOperation=@HandleToggleOperation
							ToggleSymmetry=@HandleToggleSymmetry DeleteRow=@HandleDelete
							RowHover=@HandleRowHover RowUnhover=@HandleRowUnhover />
					}
				}
			</div>

			@* The menu customiser's Back button — under the shape list, pinned to the column's bottom by the
			   layers' flex-grow (right where the menu footer's Back sits on every other page, which this
			   replaces there — see MenuCustomise). Only mounted when a BackAction is wired; in game it never is. *@
			@if ( BackAction is not null )
			{
				<div class="back-btn" @onclick=@(() => BackAction?.Invoke())>
					<WobbleText Text="Back" />
				</div>
			}

			@if ( EditHudGate.Of( HudSection.Layers ) == SectionState.Locked )
			{
				<div class="tutorial-lock-shield"></div>
			}

		</div>
		}

		@* Per-axis symmetry for the selected brush. The row's symmetry button is a quick on/off (X);
		   this section picks which axes when you want quadrant/octant mirroring. Lives in its own right-hand
		   panel so the left column's full height is free for the layer stack. *@
		@if ( ShowTools && EditHudGate.Visible( HudSection.Tools ) )
		{
			<div class="panel right @EditHudGate.PanelClass( HudSection.Tools )" @ref="RightPanel">
				<div class="section-title"><span>Tools</span><div class="icon">auto_awesome</div></div>
				@* Vertical list: Add Shape keeps the SAME spot whatever the state; the selection-only tools
				   grow downward beneath it instead of shoving it sideways. *@
				<div class="tool-list">
					@* Toggles placing on/off — while a stamp is held it's the way back to plain editing
					   (same as a right-click or Esc). Stays the top button: it's the one users reach for
					   without looking. *@
					@if ( EditHudGate.Visible( HudSection.AddChip ) )
					{
						var placing = Session.Tool == SculptTool.Sculpt;
						<div class="chip action @(placing ? "on" : "") @EditHudGate.ChipClass( HudSection.AddChip )" @onclick=@(() => GateClick( HudSection.AddChip, () => Session.SetTool( placing ? SculptTool.Gizmo : SculptTool.Sculpt ) ))>
							<div class="icon">@(placing ? "check_circle" : "add_circle")</div><span>@(placing ? "Done" : "Add Shape")</span>
						</div>
					}

					@* Undo / redo pair up on one row directly under Add Shape, so both keep a fixed home and
					   the selection-only tools still grow downward beneath them. Dimmed (and inert) at the
					   ends of the history rather than hidden — a button that vanishes reads as a bug. *@
					@if ( EditHudGate.Visible( HudSection.UndoRedo ) )
					{
					<div class="undo-row">
						<div class="chip action @(Session.CanUndo ? "" : "disabled") @EditHudGate.ChipClass( HudSection.UndoRedo )" @onclick=@(() => GateClick( HudSection.UndoRedo, () => Session.Undo() ))>
							<div class="icon">@SdfIcons.Undo</div><span>Undo</span>
						</div>
						<div class="chip action @(Session.CanRedo ? "" : "disabled") @EditHudGate.ChipClass( HudSection.UndoRedo )" @onclick=@(() => GateClick( HudSection.UndoRedo, () => Session.Redo() ))>
							<div class="icon">@SdfIcons.Redo</div><span>Redo</span>
						</div>
					</div>
					}
					@if ( Session.Tool == SculptTool.Gizmo && Brush is not null && EditHudGate.Visible( HudSection.EditChips ) )
					{
						<div class="chip action @EditHudGate.ChipClass( HudSection.EditChips )" @onclick=@(() => GateClick( HudSection.EditChips, () => Session.DuplicateSelected() ))>
							<div class="icon">@SdfIcons.Duplicate</div><span>Duplicate</span>
						</div>
						<div class="chip action danger @EditHudGate.ChipClass( HudSection.EditChips )" @onclick=@(() => GateClick( HudSection.EditChips, () => Session.RemoveSelected() ))>
							<div class="icon">delete</div><span>Delete</span>
						</div>
					}
				</div>
				@if ( Brush is not null && EditHudGate.Visible( HudSection.Symmetry ) )
				{
				<div class="section-title"><span>Symmetry</span><div class="icon">@SdfIcons.Symmetry</div></div>
				<div class="shape-grid">
					<div class="chip @(Brush.MirrorX ? "on" : "") @EditHudGate.ChipClass( HudSection.Symmetry )" @onclick=@(() => GateClick( HudSection.Symmetry, () => ToggleMirror( 0 ) ))>X</div>
					<div class="chip @(Brush.MirrorY ? "on" : "") @EditHudGate.ChipClass( HudSection.Symmetry )" @onclick=@(() => GateClick( HudSection.Symmetry, () => ToggleMirror( 1 ) ))>Y</div>
					<div class="chip @(Brush.MirrorZ ? "on" : "") @EditHudGate.ChipClass( HudSection.Symmetry )" @onclick=@(() => GateClick( HudSection.Symmetry, () => ToggleMirror( 2 ) ))>Z</div>
				</div>
				}
				@if ( EditHudGate.Of( HudSection.Tools ) == SectionState.Locked )
				{
					<div class="tutorial-lock-shield"></div>
				}
			</div>
		}

		@* Workshop column — a second card stack just LEFT of the Tools panel, same paper style. Only mounted
		   when an owner wires the actions: the menu customiser (heads) and creative mode (props / faces —
		   see CreativeManager.UpdateWorkshopUi); round HUDs never do. *@
		@if ( WorkshopSave is not null || Game.IsEditor )
		{
			<div class="panel right workshop-col" @ref="WorkshopPanel">
				@if ( WorkshopSave is not null )
				{
				<div class="section-title"><span>Workshop</span><div class="icon">cloud</div></div>
				<div class="tool-list">
					<div class="chip action" @onclick=@(() => WorkshopSave?.Invoke())>
						<div class="icon">cloud_upload</div><span>Save</span>
					</div>
					<div class="chip action" @onclick=@(() => WorkshopLoad?.Invoke())>
						<div class="icon">cloud_download</div><span>Load</span>
					</div>
				</div>
				}
				@if ( Game.IsEditor )
				{
					<div class="section-title"><span>Prefab</span><div class="icon">widgets</div></div>
					<div class="tool-list">
						<div class="chip action" @onclick=@(() => SavePrefab( false ))>
							<div class="icon">save</div><span>Save</span>
						</div>
						<div class="chip action" @onclick=@(() => SavePrefab( true ))>
							<div class="icon">save_as</div><span>Save As...</span>
						</div>
					</div>
					@if ( _prefabSaveTarget == Session?.Target && _prefabSaveStatus is not null )
					{
						<div class="prefab-save-status">@_prefabSaveStatus</div>
					}
				}
			</div>

			@* The workshop library window — our own browser (loading is silent API; only publishing has an
			   engine dialog). Centre-screen paper card with the player's published heads as rounded image
			   tiles, thumbnails straight off each item's workshop preview. The WRAPPER is click-through so
			   the sculpt stays interactive around the window; the card opts in and is tracked in
			   PointerOverPanels so world picks/stamps stand down underneath it. *@
			@if ( WorkshopBrowserOpen )
			{
				<div class="workshop-window-wrap">
					<div class="paper-card workshop-window" @ref="WorkshopWindowPanel">
						<div class="window-head">
							<div class="section-title"><div class="icon">cloud</div><span>Workshop</span></div>
							<div class="chip mini window-close" @onclick=@(() => WorkshopClose?.Invoke())>
								<div class="icon">close</div>
							</div>
						</div>

						@if ( WorkshopStatus is not null )
						{
							<div class="workshop-status">@WorkshopStatus</div>
						}

						@if ( WorkshopItems is { Count: > 0 } )
						{
							<div class="workshop-grid">
								@foreach ( var entry in WorkshopItems )
								{
									var it = entry;
									@* No card behind each tile — the thumbnails carry their own ink outline,
									   so they sit on the window like photos: rounded image, name beneath. *@
									<div class="workshop-tile" @onclick=@(() => it.Apply?.Invoke())>
										@if ( string.IsNullOrEmpty( it.Image ) )
										{
											<div class="tile-fallback"><div class="icon">face</div></div>
										}
										else
										{
											@* Silhouette shadow, faked in CSS: the same image again UNDER the
											   real one, offset + blur() + brightness(0) — black keeps the alpha
											   shape. (filter: drop-shadow would be the real feature; it parses
											   but never draws on this engine build.) *@
											<div class="tile-stack">
												<div class="tile-img tile-shadow" style="background-image: url( @it.Image )"></div>
												<div class="tile-img" style="background-image: url( @it.Image )"></div>
											</div>
										}
										<span class="label">@it.Title</span>
									</div>
								}
							</div>
						}
					</div>
				</div>
			}
		}

		@* Palette + sliders fade in/out with the selection. They stay mounted while editing (a mount/unmount can't
		   animate) — content comes from _fadeBrush so they hold their last state while fading out after a deselect —
		   and opacity is driven by whether a brush is selected, so the CSS opacity transition animates both ways. *@
		if ( Brush is not null )
			_fadeBrush = Brush;

		var palettePos = PalettePos();
		if ( palettePos.HasValue )
			_palettePos = palettePos.Value;

		if ( ShowPalette && EditHudGate.Visible( HudSection.Palette ) )
		{
			var paletteGate = EditHudGate.Of( HudSection.Palette );
			var paletteShown = Brush is not null && palettePos.HasValue;
			@* The lock dim rides the inline opacity (a class can't override an inline style). *@
			var paletteOpacity = (!paletteShown ? 0f : (Session.IsManipulating ? EditTransparency : 1f))
				* (paletteGate == SectionState.Locked ? LockDim : 1f);
			var mats = ClayPalette.Default.Materials;
			<div @ref="PalettePanel" class="palette-float @(paletteGate == SectionState.Highlight ? "tutorial-highlight" : "")" style="left: @((int)_palettePos.x)px; top: @((int)_palettePos.y)px; width: @(PaletteWidth)px; opacity: @(paletteOpacity.ToString( "0.###", CultureInfo.InvariantCulture )); pointer-events: @(paletteOpacity > 0.01f && !Inert ? "all" : "none"); transition: opacity @(FadeTime.ToString( "0.###", CultureInfo.InvariantCulture ))s ease;">
				@for ( int i = 0; i < mats.Count; i++ )
				{
					var idx = i;
					var m = mats[idx];
					var sel = _fadeBrush is not null && m.Matches( _fadeBrush );
					var sc = (idx == _hoverIndex) ? HoverScale : 1f;
					@* Cell = gap-free hit target; the swatch inside is the visual. Hover scale is driven in C#
					   (s&box CSS :hover doesn't reliably apply transform here) and baked into the inline style,
					   so it survives the per-frame re-renders that track the gizmo instead of being wiped. *@
					<div class="swatch-cell" style="width: @(CellPx)px; height: @(CellPx)px;"
						@onclick=@(() => ApplyMaterial( m ))
						@onmouseover=@(() => _hoverIndex = idx)
						@onmouseout=@(() => { if ( _hoverIndex == idx ) _hoverIndex = -1; })>
						<div class="swatch" style="width: @((int)SwatchVisual)px; height: @((int)SwatchVisual)px; border-radius: @((int)SwatchRoundness)px; @SwatchBorder( m, sel ) @SwatchBg( m ) transform: scale(@(sc.ToString( "0.##", CultureInfo.InvariantCulture )));"></div>
					</div>
				}
				@* Last child so it paints (and hit-tests) ABOVE the swatches. *@
				@if ( paletteGate == SectionState.Locked )
				{
					<div class="tutorial-lock-shield"></div>
				}
			</div>
		}

		@* Colour wheel + metal/rough sliders, floating to the RIGHT of the palette — same fade/tracking as the
		   palette. The wheel edits the selected brush's colour directly; a palette click re-seats it (the wheel
		   resyncs whenever the brush colour changes underneath it), and dragging it just deselects every swatch. *@
		var pickerPos = PickerPos();
		if ( pickerPos.HasValue )
			_pickerPos = pickerPos.Value;

		if ( ShowPicker && EditHudGate.Visible( HudSection.Picker ) )
		{
			var pickerGate = EditHudGate.Of( HudSection.Picker );
			var pickerShown = Brush is not null && pickerPos.HasValue;
			var pickerOpacity = (!pickerShown ? 0f : (Session.IsManipulating ? EditTransparency : 1f))
				* (pickerGate == SectionState.Locked ? LockDim : 1f);
			var pfb = _fadeBrush;
			<div @ref="PickerPanel" class="picker-float @(pickerGate == SectionState.Highlight ? "tutorial-highlight" : "")" style="left: @((int)_pickerPos.x)px; top: @((int)_pickerPos.y)px; width: @((int)PickerSize)px; opacity: @(pickerOpacity.ToString( "0.###", CultureInfo.InvariantCulture )); pointer-events: @(pickerOpacity > 0.01f && !Inert ? "all" : "none"); transition: opacity @(FadeTime.ToString( "0.###", CultureInfo.InvariantCulture ))s ease;">
				<ClayColorPicker Size=@PickerSize Value=@(pfb?.Color ?? Color.White) OnInput=@((Color c) => SetColor( c )) OnCommit=@CommitEdit />
				<ClaySlider Label="Metal" Value=@(pfb?.Metallic ?? 0f) Min=@(0f) Max=@(1f)
					OnInput=@((float v) => SetMetallic( v )) OnCommit=@CommitEdit />
				<ClaySlider Label="Rough" Value=@(pfb?.Roughness ?? 1f) Min=@(0f) Max=@(1f)
					OnInput=@((float v) => SetRoughness( v )) OnCommit=@CommitEdit />
				<div class="mat-clipboard">
					<div class="chip action" @onclick=@CopyMaterial>
						<div class="icon">@SdfIcons.Copy</div><span>Copy</span>
					</div>
					<div class="chip action @(_materialClipboard.HasValue ? "" : "disabled")" @onclick=@PasteMaterial>
						<div class="icon">@SdfIcons.Paste</div><span>Paste</span>
					</div>
				</div>
				@* Last child so it paints (and hit-tests) above the wheel/sliders. *@
				@if ( pickerGate == SectionState.Locked )
				{
					<div class="tutorial-lock-shield"></div>
				}
			</div>
		}

		@* Blend / roundness sliders, floating under the gizmo (replacing the old 3D slider handles). They track the
		   gizmo's screen position like the palette, fade out while a handle is manipulated, and fade in/out with the
		   selection the same way. *@
		var sliderPos = SliderPos();
		if ( sliderPos.HasValue )
			_sliderPos = sliderPos.Value;

		if ( ShowSliders && EditHudGate.Visible( HudSection.Sliders ) )
		{
			var sliderGate = EditHudGate.Of( HudSection.Sliders );
			var slidersShown = Brush is not null && sliderPos.HasValue;
			// No manipulation fade (unlike the palette/picker): the sliders sit BELOW the gizmo, so a drag
			// doesn't need them cleared out of the way — and the validity toast anchors off this stack's
			// slot, so keeping it solid keeps that anchor readable too.
			var sliderOpacity = (slidersShown ? 1f : 0f) * (sliderGate == SectionState.Locked ? LockDim : 1f);
			var fb = _fadeBrush;
			@* The first additive brush's blend folds against empty space — a field no-op that would only
			   inflate the SculptBounds size padding — so its slider parks at 0, greyed (mirror symmetry
			   un-parks it: the blend then smooths the copies' seams; see Sdf.BlendInert). A multi-selection
			   un-greys it — the edit fans out to the whole group, and SetBlend skips the inert member. *@
			var blendLocked = fb is not null && !Session.IsMultiSelection
				&& Session.Target?.Brushes is { } blendList && Sdf.BlendInert( blendList, fb );
			var blendVal = blendLocked ? 0f : fb?.Blend ?? 0f;
			var roundVal = fb?.Rounding ?? GizmoSettingsRoundingMin;
			var roundMax = fb is not null ? fb.MaxRounding() : 1f;
			var isSpline = fb?.Shape == SdfShape.Spline;
			var isExtruded = fb?.Shape == SdfShape.Extruded;
			var isSphere = fb?.Shape == SdfShape.Sphere;
			var isCone = fb?.Shape == SdfShape.Cone;
			var isText = fb?.Shape == SdfShape.Text;
			var xsVal = fb?.CrossSection ?? SdfCrossSection.Triangle;
			var curveVal = fb?.Curvature ?? 0f;
			var sliceVal = fb?.Slice ?? 0f;
			var canLoop = (fb?.Points?.Count ?? 0) >= 3;
			<div @ref="SliderStackPanel" class="slider-stack @(sliderGate == SectionState.Highlight ? "tutorial-highlight" : "")" style="left: @((int)_sliderPos.x)px; top: @((int)_sliderPos.y)px; opacity: @(sliderOpacity.ToString( "0.###", CultureInfo.InvariantCulture )); pointer-events: @(sliderOpacity > 0.01f && !Inert ? "all" : "none"); transition: opacity @(FadeTime.ToString( "0.###", CultureInfo.InvariantCulture ))s ease;">
				@* Add/Carve/Cutout cycle for the active brush (ghost or selection) — same cycle the A key steps. *@
				@{ var opNow = fb?.Operation ?? SdfOperation.Add; }
				<div class="chip op-chip @(opNow == SdfOperation.Subtract ? "carve" : opNow == SdfOperation.Cutout ? "cutout" : "")" @onclick=@ToggleActiveOperation>
					<span>@(opNow == SdfOperation.Subtract ? "Carve" : opNow == SdfOperation.Cutout ? "Cutout" : "Add")</span>
				</div>
				<ClaySlider Label="Blend" Value=@blendVal Min=@(0f) Max=@SdfBrush.MaxBlend Curve=@BlendCurve
					Disabled=@blendLocked OnInput=@((float v) => SetBlend( v )) OnCommit=@CommitEdit />
				@* Per-shape sliders: spline gets curvature (rounding doesn't apply to the tube); everything
				   else keeps Round (on the sphere it rounds the sliced rim); the sliceable shapes (sphere,
				   cone) add Slice as a third slider. *@
				@if ( isSpline && Session.Tool == SculptTool.Sculpt )
				{
					@* While PLACING: just smoothness. Each point's size is set as you place it (R + move),
					   and the loop closes itself by snapping to the first point — so the uniform Size
					   slider and the Loop chip would both fight the flow. *@
					<ClaySlider Label="Smooth" Value=@curveVal Min=@(0f) Max=@(1f)
						OnInput=@((float v) => SetCurvature( v )) OnCommit=@CommitEdit />
				}
				else if ( isSpline )
				{
					@* Curve slider with the Loop chip riding beside it (close the ring; needs 3+ points).
					   No Size slider / per-point toggle: every point carries its own radius (set as it was
					   placed) and is resized by its 3D radius ring, so a uniform slider would flatten them. *@
					<div class="slider-row">
						<ClaySlider Label="Curve" Value=@curveVal Min=@(0f) Max=@(1f)
							OnInput=@((float v) => SetCurvature( v )) OnCommit=@CommitEdit />
						<div class="chip mini @(fb?.SplineClosed == true ? "on" : "") @(canLoop ? "" : "disabled")" @onclick=@(() => ToggleSplineClosed())>
							<div class="icon">loop</div>
						</div>
					</div>
				}
				else
				{
					<ClaySlider Label="Round" Value=@roundVal Min=@GizmoSettingsRoundingMin Max=@roundMax
						OnInput=@((float v) => SetRounding( v )) OnCommit=@CommitEdit />
					@if ( isSphere || isCone )
					{
						<ClaySlider Label="Slice" Value=@sliceVal Min=@(0f) Max=@SdfBrush.MaxSlice
							OnInput=@((float v) => SetSlice( v )) OnCommit=@CommitEdit />
					}
				}
				@* Extruded "Shape" brush: pick the 2D profile it sweeps — a row of icon chips in the same
				   paper style, riding along under the sliders (same fade/tracking, it's inside the stack). *@
				@if ( isExtruded )
				{
					<div class="xsection-row">
						@foreach ( var xs in CrossSections )
						{
							var cs = xs;
							<div class="chip mini @(xsVal == cs ? "on" : "")" @onclick=@(() => SetCrossSection( cs ))>
								<div class="icon">@SdfIcons.CrossSection( cs )</div>
							</div>
						}
					</div>
				}
				@* Text brush: edit the string in place, riding under the sliders like the profile chips. *@
				@if ( isText )
				{
					<div class="text-row paper-card">
						<div class="icon">@SdfIcons.Shape( SdfShape.Text )</div>
						<TextEntry @ref="TextInput" class="text-input" Value:bind=@SelectedText onblur=@OnTextEntryBlur />
					</div>
				}
				@* Last child so it paints (and hit-tests) above the sliders/chips. *@
				@if ( sliderGate == SectionState.Locked )
				{
					<div class="tutorial-lock-shield"></div>
				}
			</div>
		}

		@* Shape row — docked above the sliders, because shape is a PROPERTY of the brush, not a tool:
		   with a stamp held it re-moulds the ghost, with a selection it converts the brush in place.
		   Hidden with no active brush — the Tools panel's "Add Shape" button (or Q / number keys) is the
		   entry point then. *@
		@if ( ShowTools && Brush is not null && EditHudGate.Visible( HudSection.ShapeDock ) )
		{
			var shapeDockPos = ShapeDockPos();
			if ( shapeDockPos.HasValue )
				_shapeDockPos = shapeDockPos.Value;

			@* No manipulation fade — the dock sits well below the gizmo, and the validity toast anchors
			   above this row, so both stay solid through a handle drag. *@
			<div @ref="ShapeDockPanel" class="shape-dock @EditHudGate.PanelClass( HudSection.ShapeDock )" style="left: @((int)_shapeDockPos.x)px; top: @((int)_shapeDockPos.y)px;">
				<div class="shape-grid">
					@foreach ( var entry in VisibleShapes )
					{
						var shape = entry.Shape;
						var active = Brush?.Shape == shape;
						<div class="paper-card shape-tile @(active ? "active" : "")" @onclick=@(() => GateClick( HudSection.ShapeDock, () => ShapeClicked( shape ) ))>
							<div class="shape-img" style="background-image: url( @SdfIcons.ShapeImage( shape ) )"></div>
							<span class="label">@entry.Label</span>
						</div>
					}
				</div>
				@* (No Add/Carve chips — the A key toggles the op, and the 3D preview + red carve wireframe
				   already make the mode obvious.) *@
				@* Last child so it paints (and hit-tests) above the tiles. *@
				@if ( EditHudGate.Of( HudSection.ShapeDock ) == SectionState.Locked )
				{
					<div class="tutorial-lock-shield"></div>
				}
			</div>
		}
	}

	@* Bounding-sphere silhouette of the selected shape (Bounds toggle in Tools). A flat circle is the sphere's
	   exact on-screen silhouette; it sits at the same anchor the palette/sliders use. *@
	@{
		// Call unconditionally so the out vars are always assigned (a && short-circuit would leave them unset).
		bool hasBounds = BrushScreenSphere( out var boundsC, out var boundsR );
		bool boundsShown = ShowBounds && hasBounds;
	}
	@if ( boundsShown )
	{
		<div class="bounds-circle" style="left: @((int)(boundsC.x - boundsR))px; top: @((int)(boundsC.y - boundsR))px; width: @((int)(boundsR * 2f))px; height: @((int)(boundsR * 2f))px;"></div>
	}

	@* Spline add-point cursor. Mouse.CursorType doesn't reliably paint the WORLD cursor here (the engine only
	   shows it when the mouse is in UI state, and the orbit "cursor" is actually a drawn div) — but the UI DOES
	   paint a hovered panel's CSS `cursor`. So while hovering a spline line we put up a full-screen pointer-events
	   zone whose `cursor` the UI shows over the scene. It's only present while hovering, and the gizmo's hover/
	   click are ray + raw-input (not UI events), so this doesn't block selecting the line or inserting a point. *@
	@* Mounted while hovering the line AND for the whole insert-and-place drag that follows — the mousedown's
	   gesture is UI-swallowed, so this panel's mouseup is the only visible release to end the drag with. *@
	@if ( ( Session?.HoveringSplineLine ?? false ) || ( Session?.SplinePointUiDragging ?? false ) )
	{
		@* LEFT button only — onmousedown fires for every button, and right-click means delete-a-point, not add.
		   While the insert-and-place drag runs the point is GRABBED, so the zone swaps to the closed hand. *@
		<div class="add-point-cursor @(Session?.SplinePointUiDragging == true ? "dragging" : "")"
			@onmousedown=@(( PanelEvent e ) => { if ( e is MousePanelEvent m && m.MouseButton == MouseButtons.Left ) Session?.InsertHoveredSplinePoint(); })
			@onmouseup=@(() => Session?.EndSplinePointUiDrag())></div>
	}

	@* (The world grab cursor — point hand over grabbables, closed hand while grabbed — is painted via the
	   Mouse.CursorType fallback in OnUpdate, NOT a cursor zone like the add-point panel above. A hovered
	   pointer-events surface routes the mouse buttons to the UI, swallowing Attack1 — which killed world
	   selection and every gizmo grab when this was first tried as a full-screen zone. See WorldCursorName. *@

	@* Drawn dot cursor at the frozen drag anchor (the real cursor is hidden by the mouse-capture during an
	   alt-nav drag or a hold param scrub). *@
	@if ( (AltNav.Dragging || (Session?.IsScrubbing ?? false)) && Session is not null && Session.IsEditing )
	{
		<div class="alt-cursor" style=@AltCursorStyle()></div>
	}

</root>

@code
{
	static SculptEditSession Session => SculptEditSession.Current;

	// The brush the panels edit: the SELECTED brush in edit mode, the STAMP GHOST in add mode (palette /
	// sliders / symmetry pre-style the next stamp). Identical to SelectedBrush when the edit tool is up.
	SdfBrush Brush => Session?.ActiveBrush;

	// The shape row's shapes — all of them; a spline is placed as a CHAIN of points rather than one stamp,
	// but it's picked from the same row. The tutorial's first shape lesson trims to the primitives
	// (the extruded profile, spline and text deserve their own lessons, not a first-contact wall of tiles).
	IEnumerable<(SdfShape Shape, string Label)> VisibleShapes => EditHudGate.BasicShapesOnly
		? AddShapes.Where( e => e.Shape is not (SdfShape.Extruded or SdfShape.Spline or SdfShape.Text) )
		: AddShapes;

	// Shape-row click — shape is a brush PROPERTY, so the verb depends on the current subject:
	// stamp held → re-mould the ghost; brush selected → convert it in place; nothing → pick up a new stamp.
	void ShapeClicked( SdfShape shape )
	{
		if ( Session is null )
			return;

		if ( Session.Tool == SculptTool.Sculpt )
		{
			Session.SetShape( shape );
			return;
		}

		// A tile always converts the selection in place — splines included (to one = a 2-point tube filling
		// the same box; from one = the solid takes the curve's bounds).
		if ( Session.SelectedBrush is not null )
		{
			Session.ConvertSelectedShape( shape );
			return;
		}

		Session.SetTool( SculptTool.Sculpt );
		Session.SetShape( shape );
	}

	// The strip's Add/Carve/Cutout chip: cycle the active brush's operation — the stamp's in sculpt mode,
	// the selected brush's in gizmo mode (identical to the A key).
	void ToggleActiveOperation()
	{
		if ( Session is null )
			return;

		if ( Session.Tool == SculptTool.Sculpt )
			Session.SetStampOperation( SculptEditSession.NextOperation( Session.StampOperation ) );
		else if ( Session.Selected >= 0 )
			Session.ToggleOperation( Session.Selected );
	}

	// Hint-strip labels for the shape-dependent scrubs: D = the second slider, F = the wildcard third.
	// A spline being PLACED has neither a Round nor a Size slot — just smoothness on the wildcard.
	bool PlacingSpline => Session?.Tool == SculptTool.Sculpt && Brush?.Shape == SdfShape.Spline;

	string SecondSliderName => Brush?.Shape == SdfShape.Spline ? (PlacingSpline ? "smooth" : "curve") : "round";
	string WildcardName => Brush?.Shape switch
	{
		SdfShape.Sphere or SdfShape.Cone => "slice",
		SdfShape.Extruded => "profile",
		SdfShape.Spline => PlacingSpline ? null : "size", // placing: each point is sized as it's dropped
		_ => null,
	};


	// True while a camera navigation input is held in edit mode. Read from the camera controller (a regular component
	// where Input.Down reads reliably — it doesn't from UI panel code). While set, the HUD goes pointer-events:none
	// (via the root's "alt-nav" class) so the camera-driven cursor drift can't grab the layer rows / palette, AND
	// the navigation mouse buttons fall straight through to the scene so the camera actually gets them.
	static bool AltNavActive => AltNav.Held && (Session?.IsEditing ?? false);

	// The HUD goes click-through (its interactive cards drop pointer-events, via the "alt-nav" class) both during
	// alt camera-nav AND while the pause menu is open — so its buttons don't hover/click behind the pause overlay
	// (separate ScreenPanels don't block each other's hover, so a higher z-index alone isn't enough).
	static bool Inert => AltNavActive || PauseMenu.IsOpen;
	string RootClass => Inert ? "edit-hud alt-nav" : "edit-hud";

	// The "must have at least 1 shape" toast's lifetime — a quick flash; each blocked click re-arms it.
	const float NoSolidToastTime = 1f;
	static bool NoSolidToast => Session is { } s && s.SinceNoSolidRefusal < NoSolidToastTime;

	// The local player's SculptBounds currently in violation (or null) — drives the persistent validity
	// toast. Scanned rather than bound to the session, because the toast outlives edit mode: an invalid
	// shape stays owner-local until fixed, whoever's HUD state we're in.
	SculptBounds InvalidBounds
	{
		get
		{
			foreach ( var sb in Scene.GetAllComponents<SculptBounds>() )
			{
				if ( !sb.LocallyEditable || sb.IsSculptValid )
					continue;
				return sb;
			}
			return null;
		}
	}

	// --- Which parts of the HUD show. All default on, so the in-game editor is unchanged; turn pieces off for a
	// trimmed HUD (e.g. the main-menu sculpt toy wants colours only — no add-shape/layer/symmetry panels). The
	// gizmo itself is owned by SculptEditSession (ShowGizmo there), since it renders in-world, not in this panel. ---
	/// <summary>Show the "Add Shape" grid and the right-hand Duplicate/Symmetry tools.</summary>
	[Property, Group( "Panels" )] public bool ShowTools { get; set; } = true;
	/// <summary>Show the layer/shape stack (the reorderable brush list).</summary>
	[Property, Group( "Panels" )] public bool ShowLayers { get; set; } = true;
	/// <summary>Show the floating colour palette anchored to the gizmo.</summary>
	[Property, Group( "Panels" )] public bool ShowPalette { get; set; } = true;
	/// <summary>Show the floating colour wheel + metal/rough sliders to the right of the palette.</summary>
	[Property, Group( "Panels" )] public bool ShowPicker { get; set; } = true;
	/// <summary>Show the floating blend/round sliders under the gizmo.</summary>
	[Property, Group( "Panels" )] public bool ShowSliders { get; set; } = true;
	/// <summary>Draw the selected shape's bounding-sphere silhouette (toggled by the Bounds chip in Tools).</summary>
	[Property, Group( "Panels" )] public bool ShowBounds { get; set; }

	// --- Tutorial gating (EditHudGate): every gated section consults the static gate in the markup; while no
	// tutorial is active it reports Normal everywhere and none of this changes a pixel. ---

	// How far a Locked section dims. The floats bake it into their INLINE opacity (a class can't override an
	// inline style); .tutorial-dim carries the same value for panels styled without one.
	const float LockDim = 0.45f;

	// A chip in a gated section routes its click through this: Locked/Hidden swallow it. Belt-and-braces on
	// top of .tutorial-locked's pointer-events:none — a latched hover bit or a same-frame gate flip can't
	// sneak a click through.
	static void GateClick( HudSection section, Action action )
	{
		if ( EditHudGate.Interactive( section ) )
			action();
	}

	/// <summary>When set, a "Back" button (footer-style WobbleText) mounts under the layer stack and invokes
	/// this on click. Wired by the menu customiser — whose session has no pawn and so no Q toggler, and whose
	/// page hides the normal menu footer (see MenuCustomise); null everywhere else, including in game.</summary>
	public Action BackAction { get; set; }

	/// <summary>When set, a Workshop column (Save To Workshop / Load From Workshop) mounts just left of the
	/// Tools panel. Wired by the menu customiser and by creative mode while editing (both through
	/// <see cref="SculptWorkshop"/>); null everywhere else — round HUDs never mount it.</summary>
	public Action WorkshopSave { get; set; }

	string _prefabSaveStatus;
	SdfSculpture _prefabSaveTarget;

	void SavePrefab( bool saveAs )
	{
		if ( !Game.IsEditor || Session is null ) return;
		_prefabSaveTarget = Session.Target;
		_prefabSaveStatus = Session.IsManipulating
			? "Finish the current edit before saving."
			: SdfSculpture.SavePrefabHandler?.Invoke( Session.Target, saveAs )
				?? "The editor save tool is not ready yet.";
	}

	/// <summary>The Workshop column's second button — see <see cref="WorkshopSave"/>.</summary>
	public Action WorkshopLoad { get; set; }

	/// <summary>The workshop library window is up (see the markup for what it is). Opened/closed by the
	/// customiser; the window's own close button routes through <see cref="WorkshopClose"/>.</summary>
	public bool WorkshopBrowserOpen { get; set; }

	/// <summary>The library window's close action — owned by the customiser so its state stays consistent.</summary>
	public Action WorkshopClose { get; set; }

	/// <summary>Status line inside the library window ("Searching…", "No saved heads found"). Null hides it.</summary>
	public string WorkshopStatus { get; set; }

	/// <summary>The library window's tiles: title, thumbnail URL (the item's workshop preview; empty = glyph
	/// fallback), and the click action. Null/empty hides the grid.</summary>
	public IReadOnlyList<(string Title, string Image, Action Apply)> WorkshopItems { get; set; }

	// The shapes the "Add Shape" grid offers, with their button labels. Centralised here; the glyphs come
	// from SdfIcons.Shape().
	static readonly (SdfShape Shape, string Label)[] AddShapes =
	{
		(SdfShape.Sphere, "Sphere"),
		(SdfShape.Box, "Box"),
		(SdfShape.Cylinder, "Cylinder"),
		(SdfShape.Cone, "Cone"),
		(SdfShape.Extruded, "Shape"),
		(SdfShape.Spline, "Spline"),
		(SdfShape.Text, "Text"),
	};

	// The cross-section profiles the extruded "Shape" brush offers, with their button glyphs — the picker
	// row under the blend/round sliders. Glyphs come from SdfIcons.CrossSection().
	static readonly SdfCrossSection[] CrossSections =
	{
		SdfCrossSection.Triangle,
		SdfCrossSection.Star,
		SdfCrossSection.Pentagon,
		SdfCrossSection.Hexagon,
	};

	Panel PalettePanel { get; set; }
	Panel SliderStackPanel { get; set; }
	Panel PickerPanel { get; set; }
	Panel LeftPanel { get; set; }
	Panel RightPanel { get; set; }
	Panel ShapeDockPanel { get; set; }
	Panel WorkshopWindowPanel { get; set; }
	Panel WorkshopPanel { get; set; }
	Panel PartDockPanel { get; set; }
	Vector2 _shapeDockPos;

	// The Head/Weapon part dock is up: a session wired parts, and the editor sits in the neutral state
	// (gizmo tool, nothing selected, no stamp ghost). One place for the markup AND the toast anchor.
	bool PartDockShown => (Session?.IsEditing ?? false) && Session.EditParts is { Count: > 0 }
		&& Session.Tool == SculptTool.Gizmo && Brush is null;

	// The validity toast's BOTTOM edge, from the bottom of the screen (its wrapper centres x — see the
	// markup for why neither axis may depend on the toast's measured size). Two anchors: just above the
	// shape dock while the dock is shown, or the sliders' 64px hotkey-bar allowance any other time
	// (nothing selected, or not editing at all).
	float ToastBottom()
	{
		bool dockShown = (Session?.IsEditing ?? false) && ShowTools && Brush is not null;
		if ( dockShown && ShapeDockPos() is { } dock )
		{
			float sc = Panel?.ScaleFromScreen ?? 1f;
			return MathF.Max( 64f, Screen.Height * sc - dock.y + 28f );
		}

		// The Head/Weapon part dock owns the bottom-centre slot while nothing is selected — float above it.
		if ( PartDockShown )
			return 112f;

		return 64f;
	}

	// The shape row sits centred, directly above the slider stack (measured sizes; estimates pre-layout).
	Vector2? ShapeDockPos()
	{
		float sc = Panel?.ScaleFromScreen ?? 1f;
		float w = 480f, h = 100f;
		if ( ShapeDockPanel is { } sd && sd.Box.Rect.Width > 0f )
		{
			w = sd.Box.Rect.Width * sc;
			h = sd.Box.Rect.Height * sc;
		}

		float slidersTop = Screen.Height * sc - SliderStackHeight - 64f;
		if ( SliderPos() is { } sl )
			slidersTop = sl.y;

		return new Vector2(
			MathF.Max( 8f, (Screen.Width * sc - w) * 0.5f ),
			MathF.Max( 8f, slidersTop - h - 12f ) );
	}

	// Retained state so the palette + sliders can fade OUT after a deselect (a mount/unmount can't animate, so the
	// panels stay rendered and just drop opacity). _fadeBrush is the last selected brush — its colour/values fill
	// the panels while they fade; _palettePos/_sliderPos hold their last on-screen spot so they fade in place.
	SdfBrush _fadeBrush;
	Vector2 _palettePos;
	Vector2 _sliderPos;
	Vector2 _pickerPos;

	/// <summary>True while the cursor is over the palette. The edit session reads this to stop world
	/// clicks/picks/gizmo-grabs from falling through the UI.</summary>
	public static bool PointerOverPalette { get; private set; }

	/// <summary>True while the cursor is over the blend/round slider stack — same gate as the palette.</summary>
	public static bool PointerOverSliders { get; private set; }

	/// <summary>True while the cursor is over the colour wheel / metal / rough picker column — same gate.</summary>
	public static bool PointerOverPicker { get; private set; }

	/// <summary>True while the cursor is over the left toolbar/layers column or the right tools panel. Matters
	/// far more with the stamp tool — a toolbar click must never also stamp a shape into the world.</summary>
	public static bool PointerOverPanels { get; private set; }

	/// <summary>Cursor is over any interactive HUD card that should swallow world clicks/picks/gizmo-grabs — or a
	/// slider is pressed/scrubbing, so a drag that drifts off the thin track still can't highlight world shapes.</summary>
	public static bool PointerOverUi => PointerOverPalette || PointerOverSliders || PointerOverPicker
		|| PointerOverPanels || ClaySlider.Pressed || ClayColorPicker.Pressed
		|| (Session?.ExitConfirmPending ?? false); // the exit-confirm scrim owns ALL input while it's up

	// Is the cursor over this card RIGHT NOW? HasHovered alone can't answer that: it's a stored pseudo-class
	// bit, and the engine only clears it by walking UP from the previously-hovered panel — so a button that
	// deletes its own panel (the Delete chip, a layer row's bin) detaches before that walk runs and leaves the
	// enclosing card's Hover bit latched ON forever. That latched bit reads as "pointer over UI" for the rest
	// of the session, which kills world picking AND every gizmo handle while the layer list keeps working.
	// So: keep HasHovered (it carries the pointer-events/visibility rules — click-through while alt-navving,
	// the opacity-0 palette with no selection) but AND it with a live hit test, which a latch can't survive.
	// IsValid/IsDeleting cover the other half: a @ref left pointing at a deleted panel (the shape dock unmounts
	// with the selection) keeps its bit set too, and a deleted panel has no YogaNode.
	static bool Over( Panel p ) =>
		p is { IsValid: true, IsDeleting: false } && p.HasHovered && p.IsInside( Mouse.Position );

	// The world cursor name fed to the Mouse.CursorType fallback each frame (via AltNav.HoverCursor — the
	// single writer). The engine paints this ONLY when no hovered panel claims the cursor, which is exactly
	// the "over the world" case; every HUD card's own CSS cursor wins the moment the pointer is over it.
	// NEVER paint this with a full-screen pointer-events panel instead: a hovered pointer-events surface
	// routes the mouse buttons to the UI, swallowing Attack1 — which kills world selection and every gizmo
	// grab. (The add-point zone survives that only because it handles the click itself.)
	string WorldCursorName()
	{
		var s = Session;
		if ( s is null || !s.IsEditing )
			return null;
		if ( s.ExitConfirmPending )
			return null; // the scrim declares no CSS cursor, so the fallback would show through it
		if ( s.SplinePointUiDragging )
			return "hand_closed"; // the freshly inserted point is held — matches the zone's .dragging CSS
		if ( s.HoveringSplineLine )
			return AddPointCursor; // keep the fallback in sync with the add-point zone's CSS cursor

		return s.WorldCursor switch
		{
			GrabCursor.Closed => "hand_closed",
			GrabCursor.Open => "pointer", // the point hand (hand_point.png via Cursors.config)
			_ => null,
		};
	}

	// Hovered swatch index, set from the cells' mouse-over/out. Drives the inline hover scale (see markup).
	int _hoverIndex = -1;

	// Layer drag-reorder state, fed by the LayerRow panels' native drag events. _dragIndex = the brush
	// being dragged (-1 = none); _dropIndex = the row currently under it (where it'll land). Both index
	// into Target.Brushes. _dragOffsetY = how far (style px) the floating row has moved from its slot;
	// _stride = one row's height + gap, so the others can shift by exactly one slot. All feed BuildHash.
	int _dragIndex = -1;
	int _dropIndex = -1;
	float _dragOffsetY;
	float _stride;

	// Build a layer row's class list as one expression (component attributes can't mix literal + markup).
	string LayerClass( int idx )
	{
		string c = "paper-card layer";
		if ( Session.IsSelected( idx ) ) c += " selected";

		if ( _dragIndex >= 0 )
			c += idx == _dragIndex ? " dragging" : " shuffle"; // dragged row tracks instantly; others ease

		return c;
	}

	// Per-row inline transform that produces the sortable shuffle. The list renders top = last brush, so
	// "visual slot" runs opposite to brush index; we work in visual slots and convert once.
	// Always returns an explicit transform — an empty style won't reliably CLEAR a prior inline transform,
	// which leaves rows stuck/overlapping after a drop. The lifted look + transition:none for the dragged
	// row live in the .dragging CSS class (reliable), not inline.
	string LayerStyle( int idx )
	{
		int n = Session?.Target?.AuthoredBrushCount ?? 0; // rows cover the authored prefix only

		if ( _dragIndex < 0 || n <= 0 )
			return "transform: translateY( 0px );";

		// translateY is a CSS length = logical (style) px, but _dragOffsetY (raw drag delta) and _stride
		// (Box.Rect) are both physical screen px. Convert with ScaleFromScreen (physical → logical) so the float
		// tracks the cursor 1:1 at ANY window size — feeding raw screen px moves the row by offset × ScaleToScreen
		// on screen, so it desyncs off unity scale and gets worse the shorter the window. (The drop-slot maths in
		// HandleDragMove stays in screen px: offset / stride is a unitless ratio, so it needs no scaling.)
		float scale = Panel?.ScaleFromScreen ?? 1f;

		// The dragged row floats under the cursor (z-index / no-transition come from the .dragging class).
		if ( idx == _dragIndex )
			return $"transform: translateY( {Px( _dragOffsetY * scale )} ) scale( 1.03 );";

		// Everyone between the pickup slot and the drop slot slides one row over to open the gap.
		int vs = (n - 1) - _dragIndex;   // pickup visual slot
		int vt = (n - 1) - _dropIndex;   // drop visual slot
		int vj = (n - 1) - idx;          // this row's visual slot

		int shift = 0;
		if ( vt > vs && vj > vs && vj <= vt ) shift = -1;       // dragging down: rows below slide up
		else if ( vt < vs && vj >= vt && vj < vs ) shift = 1;    // dragging up: rows above slide down

		return $"transform: translateY( {Px( shift * _stride * scale )} );";
	}

	static string Px( float v ) => v.ToString( "0.#", CultureInfo.InvariantCulture ) + "px";

	// Inline position for the drawn alt-drag dot: a 64px cursor image (its hotspot is the centre) placed at the
	// frozen anchor. Everything is converted from screen px to panel px (the same scale the palette uses).
	string AltCursorStyle()
	{
		float scale = Panel?.ScaleFromScreen ?? 1f;
		// With a stamp ghost up, the drawn dot RIDES THE SHAPE through the gesture — the world moves while
		// the cursor is locked to the ghost, so a screen-frozen dot reads as wrong. Without a stamp (edit
		// mode), each frozen-cursor gesture pins the dot at its own start point as before.
		Vector2 a;
		if ( Session is { } s && s.TryGetStampScreenPos( out var stampPx ) )
			a = stampPx;
		else
			a = AltNav.Dragging ? AltNav.Anchor : BrushScrub.Anchor;
		float size = 64f * scale;
		float x = a.x * scale - size * 0.5f;
		float y = a.y * scale - size * 0.5f;
		return $"left: {Px( x )}; top: {Px( y )}; width: {Px( size )}; height: {Px( size )};";
	}

	// Did the current gesture become a drag? Set on drag-begin, reset on each press. A click selects only
	// when it didn't drag. Lives here (not on LayerRow) because the drop reorder can recreate/move the row
	// panel before its trailing click fires, which would reset a per-row flag.
	bool _gestureDragged;

	// OnMouseDown on a row: a fresh gesture — assume it's a click until a drag actually starts.
	void HandlePressStart() => _gestureDragged = false;

	// Click on a row: select it — ctrl toggles it in/out of the group, shift range-selects from the anchor
	// (the s&box hierarchy scheme) — unless this gesture was a drag (drag only reorders). Modifiers come
	// from the session's per-frame samples: Input doesn't read reliably inside UI event dispatch.
	void HandlePick( int idx )
	{
		if ( !_gestureDragged )
			Session?.Select( idx, SculptEditSession.CtrlHeld, SculptEditSession.ShiftHeld );
	}

	// Per-row icon buttons.
	void HandleToggleEnabled( int idx ) => Session?.ToggleEnabled( idx );
	void HandleToggleOperation( int idx ) => Session?.ToggleOperation( idx );
	void HandleToggleSymmetry( int idx ) => Session?.ToggleSymmetry( idx );
	void HandleDelete( int idx ) => Session?.Remove( idx );

	// Hovering a layer row highlights its shape in the scene (the session feeds it the same hover path a
	// 3D pick uses). Unhover clears it, but only if this row is still the one we set — guards against a
	// stale unhover from a row that was swapped out by a reorder landing after another row's hover.
	void HandleRowHover( int idx ) => SculptEditSession.UiHoverBrush = idx;
	void HandleRowUnhover( int idx )
	{
		if ( SculptEditSession.UiHoverBrush == idx )
			SculptEditSession.UiHoverBrush = -1;
	}

	// Engine OnDragStart on a row: mark it dragged and record the slot stride (measured row-to-row by the
	// LayerRow, in screen px — matches the drag offset's units). Deliberately does NOT select — dragging
	// only reorders; selection is a plain click (the trailing click after a drag is swallowed in LayerRow).
	void HandleDragBegin( int idx, float stride )
	{
		_dragIndex = idx;
		_dropIndex = idx;
		_dragOffsetY = 0f;
		_stride = stride;
		_gestureDragged = true; // this gesture is a drag → the trailing click won't select
	}

	// Engine OnDrag: the floating row's offset from where it was grabbed. The drop slot is whichever slot
	// the row has been dragged over — offset rounded to whole rows — so it includes the original slot
	// (offset ≈ 0 → drop back where you started) and always matches the previewed gap.
	void HandleDragMove( float offsetY )
	{
		int n = Session?.Target?.AuthoredBrushCount ?? 0; // rows cover the authored prefix only
		if ( n <= 0 || _stride <= 0f )
		{
			_dragOffsetY = offsetY;
			return;
		}

		// Visual slots run opposite to brush index (top = last brush); a downward (positive) offset moves
		// the row to a higher visual slot. Clamp the float so the row stays inside the list: it can slide
		// from the top slot (0) down to the bottom slot (n-1), but no further.
		int vs = (n - 1) - _dragIndex;
		_dragOffsetY = Math.Clamp( offsetY, -vs * _stride, (n - 1 - vs) * _stride );

		int vDrop = Math.Clamp( vs + (int)MathF.Round( _dragOffsetY / _stride ), 0, n - 1 );
		_dropIndex = (n - 1) - vDrop;
	}

	// Engine OnDragEnd on the dragged row: reorder if it'll land somewhere new, then clear the drag.
	void HandleDragEnd()
	{
		if ( _dragIndex < 0 )
			return;

		int from = _dragIndex, to = _dropIndex;
		_dragIndex = -1;
		_dropIndex = -1;
		_dragOffsetY = 0f;

		if ( to >= 0 && to != from )
			Session?.MoveBrush( from, to );
	}

	protected override void OnUpdate()
	{
		base.OnUpdate();
		// The session reads these to stop world clicks/picks falling through the palette or slider stack. (During
		// alt-nav both panels go pointer-events:none, so HasHovered reads false and can't spuriously block picks.)
		// Read through Over(), never HasHovered directly — see Over() for the latched-hover trap.
		PointerOverPalette = Over( PalettePanel );
		PointerOverSliders = Over( SliderStackPanel );
		PointerOverPicker = Over( PickerPanel );
		PointerOverPanels = Over( LeftPanel ) || Over( RightPanel ) || Over( ShapeDockPanel )
			|| Over( WorkshopWindowPanel ) || Over( WorkshopPanel ) || Over( PartDockPanel );

		// Safety net for the layer-row hover highlight: if we're not in an editing session the rows can't be
		// hovered, so make sure a stale highlight (e.g. the HUD closed mid-hover) can't linger.
		if ( !(Session?.IsEditing ?? false) )
			SculptEditSession.UiHoverBrush = -1;

		// While an alt-nav drag OR a hold-key param scrub is in progress, capture the mouse on the HUD root.
		// This hands them clean relative-mode Mouse.Delta and hides the real cursor (we draw the dot) WITHOUT
		// switching to game mouse-state — so the UI still gets the button release and won't stay stuck
		// "mouse-down" (which would start a phantom layer drag the moment you hover a row after orbiting).
		bool wantCapture = (AltNav.Dragging || (Session?.IsScrubbing ?? false)) && (Session?.IsEditing ?? false);
		bool hasCapture = Panel?.HasMouseCapture ?? false;
		if ( wantCapture != hasCapture )
		{
			Panel?.SetMouseCapture( wantCapture );

			// Releasing a frozen-cursor gesture with a stamp ghost up: the camera (or gesture) may have moved
			// the shape's on-screen position while the cursor was hidden — land the cursor exactly on the
			// shape at the release, so it reappears already there instead of visibly snapping over a frame
			// later. (Doing it at the release point kills the component-update-order race.)
			if ( !wantCapture && Session is { } s && s.TryGetStampScreenPos( out var stampPx ) )
				Mouse.Position = stampPx;
		}

		// The world cursor: add-point over a spline's line, else the grab language (point hand over
		// grabbables, closed hand while grabbed). Routed through AltNav (the single writer of
		// Mouse.CursorType each frame) — setting Mouse.CursorType directly here just gets clobbered by
		// AltNav.Tick's per-frame reset. null = back to the default arrow. Safe against UI clobbering the
		// other way too: PanelInput writes the cursor only on hover CHANGES (with a claim latch), so this
		// per-frame write stands whenever the pointer is over the world.
		AltNav.HoverCursor = WorldCursorName();
	}

	/// <summary>Cursor for the AltNav backup path while hovering a spline's line. The VISIBLE cursor is the
	/// add-point panel's CSS <c>cursor</c> (in the .scss — currently "pointer"/hand); this only feeds the
	/// fallback <c>Mouse.CursorType</c> route. Keep them in sync if you change the cursor.</summary>
	[Property, Group( "Cursors" )] public string AddPointCursor { get; set; } = "pointer";

	// --- Palette tuning (live-editable: select the runtime "Edit HUD" object in play mode) ---
	/// <summary>SUPERSEDED for sizing: swatches now fill PickerSize/Columns cells so the palette matches the
	/// wheel's width. Kept so scene-serialized values still deserialize.</summary>
	[Property, Group( "Palette" )] public float SwatchSize { get; set; } = 30f;
	[Property, Group( "Palette" )] public float SwatchSpacing { get; set; } = 5f;
	[Property, Group( "Palette" )] public float SwatchRoundness { get; set; } = 14f;

	// Fixed palette layout: 5 columns of the shared 190px column width (smaller swatches, shorter palette —
	// it was overlapping the Tools/Symmetry panel at 4). Was a scene-tweakable property during layout
	// iteration; the layout is settled, so it's code-owned now.
	const int Columns = 5;

	/// <summary>Gap between the shape's bounding circle and the palette to its right (design px — scales with
	/// the screen). It's added BEYOND the projected radius, so it's a small margin, not the full offset.</summary>
	[Property, Group( "Palette" )] public float DistanceFromGizmo { get; set; } = 40f;

	/// <summary>Anchor the palette / colour wheel / sliders to the SELECTED SHAPE's bounding circle (the
	/// default). Off = anchor to the WHOLE sculpt's bounds instead, so the floats frame the finished shape.
	/// Either way the circle is grown to cover the gizmo's handles, so the floats never sit on them.</summary>
	[Property, Group( "Palette" )] public bool UseShapeBounds { get; set; } = true;

	// --- Colour wheel picker (floats right of the palette, with the metal/rough sliders underneath) ---
	/// <summary>Diameter of the colour wheel (design px). The metal/rough sliders underneath match its width.</summary>
	[Property, Group( "Picker" )] public float PickerSize { get; set; } = 190f;
	/// <summary>Gap between the palette's right edge and the colour wheel (design px).</summary>
	[Property, Group( "Picker" )] public float PickerGap { get; set; } = 18f;

	// Wheel + the two slider rows (each ≈ a 46px pill + the 10px column gap), for centring + clamping.
	float PickerStackHeight => PickerSize + 112f;

	// --- Blend / roundness sliders (float under the gizmo) ---
	[Property, Group( "Sliders" )] public float SliderWidth { get; set; } = 400f;
	/// <summary>Blend slider response curve: 1 = linear, &gt;1 gives finer control over small blends (most-used
	/// range) by stretching the low end across more of the track. Roundness stays linear.</summary>
	[Property, Group( "Sliders" ), Range( 1f, 4f )] public float BlendCurve { get; set; } = 2.5f;
	/// <summary>Gap between the bottom of the shape's bounding circle and the slider stack (design px — scales
	/// with the screen). Added BEYOND the projected radius, so it's a small margin, not the full drop.</summary>
	[Property, Group( "Sliders" )] public float SliderDropFromGizmo { get; set; } = 40f;
	/// <summary>Roughly the slider stack's height, for centring + on-screen clamping (device px).</summary>
	[Property, Group( "Sliders" )] public float SliderStackHeight { get; set; } = 92f;

	// The rounding slider's minimum mirrors the gizmo's old SliderRoundingMin so the 2D slider and the brush
	// inspector agree on the floor (SDF shapes look odd perfectly sharp). MaxRounding() is floored at the
	// same const, so this end can never cross the slider's max however small the brush gets.
	float GizmoSettingsRoundingMin => SdfBrush.MinRounding;

	// Top-left of the slider stack (panel px): centred horizontally on the gizmo, dropped below it, clamped
	// on-screen. Mirrors the palette's tracking so both follow the gizmo as the view orbits.
	// Continuous slider edits PREVIEW (live surface + throttled network stream); the slider's OnCommit fires
	// CommitEdit on release for the one full commit — the same split gizmo handle drags use. Discrete one-shot
	// edits (palette click, cross-section swap) still commit directly via NotifyChanged.
	void CommitEdit() => Session?.CommitChanged();

	// Property edits fan out to every brush the session says they act on — the stamp ghost in add mode, or
	// the WHOLE selection in edit mode (multi-select edits every member, per-brush clamps intact). `Brush`
	// (the primary) still provides the panels' displayed values, like any multi-object inspector.
	void EditEach( Action<SdfBrush> edit )
	{
		if ( Session is null || Brush is null )
			return;
		foreach ( var b in Session.EditTargets )
			edit( b );
	}

	void SetBlend( float v )
	{
		if ( Brush is null )
			return;
		var list = Session?.Target?.Brushes;
		EditEach( b =>
		{
			// Belt-and-braces behind the greyed slider: a blend-inert brush's blend stays untouched.
			if ( list is not null && Sdf.BlendInert( list, b ) )
				return;
			b.Blend = Math.Clamp( v, 0f, SdfBrush.MaxBlend );
		} );
		Session?.PreviewChanged();
	}

	void SetRounding( float v )
	{
		if ( Brush is null )
			return;
		EditEach( b => b.Rounding = Math.Clamp( v, GizmoSettingsRoundingMin, b.MaxRounding() ) );
		Session?.PreviewChanged();
	}

	void SetCurvature( float v )
	{
		if ( Brush is null )
			return;
		EditEach( b =>
		{
			if ( b.Shape == SdfShape.Spline )
				b.Curvature = Math.Clamp( v, 0f, 1f );
		} );
		Session?.PreviewChanged();
	}

	void SetSlice( float v )
	{
		if ( Brush is null )
			return;
		EditEach( b =>
		{
			if ( b.Shape is SdfShape.Sphere or SdfShape.Cone )
				b.Slice = Math.Clamp( v, 0f, SdfBrush.MaxSlice );
		} );
		Session?.PreviewChanged();
	}

	// Close/open the spline ring (the old gizmo gap-midpoint handle, now a chip). Needs 3+ points to be a
	// ring. The primary picks the direction; every selected spline that CAN loop follows it.
	void ToggleSplineClosed()
	{
		if ( Brush is null || Brush.Points is not { Count: >= 3 } )
			return;
		bool closed = !Brush.SplineClosed;
		EditEach( b =>
		{
			if ( b.Shape == SdfShape.Spline && b.Points is { Count: >= 3 } )
				b.SplineClosed = closed;
		} );
		Session?.NotifyChanged();
	}

	/// <summary>The selected text brush's string, two-way bound to the HUD's TextEntry. Setting it re-bakes
	/// the glyph field and resizes the quad so the LETTERS keep a constant world height — the quad grows
	/// with the string. The quad stays locked to the glyph slot's 2:1 aspect: the slot→world mapping must be
	/// uniform (matching the quad to the STRING's aspect is what squished the glyphs as you typed).
	/// A cleared-out entry does NOT reach the brush (SdfBrush.Text drops blank strings — no-letter text is
	/// invisible geometry): the entry can sit empty while it has focus, because TextEntry's bound-value
	/// refresh skips a focused panel, so you can delete everything and retype — the shape keeps its last
	/// string meanwhile, and leaving the field snaps it back (see <see cref="OnTextEntryBlur"/>).</summary>
	string SelectedText
	{
		get => Brush?.Text ?? "";
		set
		{
			if ( Brush is null || string.IsNullOrWhiteSpace( value ) || Brush.Text == value )
				return;

			// Letter height before the change: the quad maps the full slot; letters fill ContentHeightFrac of it.
			float letterH = Brush.Size.y * (Brush.TextData?.ContentHeightFrac ?? 0.5f);

			Brush.Text = value;
			var baked = SdfTextSdf.Get( Brush.Text, Brush.Font ); // main thread — safe to bake here
			Brush.TextData = baked;

			float newY = MathF.Max( letterH / baked.ContentHeightFrac, 1f );
			Brush.Size = new Vector3( newY * (SdfTextData.Width / (float)SdfTextData.Height), newY, Brush.Size.z );
			// Typing is a continuous gesture with no release event: preview per keystroke, and the session's
			// commit debounce runs the full commit once the typing goes quiet.
			Session?.PreviewChanged();
		}
	}

	TextEntry TextInput { get; set; }

	/// <summary>Enter, Escape and click-away all end in a Blur. If the entry was left cleared, the two-way
	/// bind won't refill it — after pushing the blank at <see cref="SelectedText"/> (which dropped it) the
	/// bind considers both sides in sync — so snap the entry back to the brush's real string here. A no-op
	/// when the field holds what the brush holds, i.e. after any normal accepted edit.</summary>
	void OnTextEntryBlur()
	{
		if ( TextInput.IsValid() )
			TextInput.Text = SelectedText;
	}

	// Swap the extruded brush's 2D profile — every selected extruded brush takes it. Rounding is re-clamped
	// because the profiles have different caps (a star's erosion limit is far smaller than a hexagon's
	// apothem), so the slider stays honest.
	void SetCrossSection( SdfCrossSection cs )
	{
		if ( Brush is null || (Brush.CrossSection == cs && !(Session?.IsMultiSelection ?? false)) )
			return;
		EditEach( b =>
		{
			if ( b.Shape != SdfShape.Extruded )
				return;
			b.CrossSection = cs;
			b.Rounding = Math.Clamp( b.Rounding, GizmoSettingsRoundingMin, b.MaxRounding() );
		} );
		Session?.NotifyChanged();
	}

	/// <summary>Palette opacity while a gizmo handle is being dragged (0 = hidden, 1 = unchanged), so it
	/// gets out of the way while you're shaping.</summary>
	[Property, Group( "Palette" ), Range( 0f, 1f )] public float EditTransparency { get; set; } = 0f;

	/// <summary>How long the palette takes to fade in/out as you start/stop dragging (seconds).</summary>
	[Property, Group( "Palette" ), Range( 0f, 1f )] public float FadeTime { get; set; } = 0.12f;

	/// <summary>How much a swatch grows when hovered (1 = no change).</summary>
	[Property, Group( "Palette" ), Range( 1f, 2f )] public float HoverScale { get; set; } = 1.25f;

	// --- Metallic sheen (swatches whose material metalness is above the threshold get a diagonal gradient) ---
	[Property, Group( "Metallic Sheen" ), Range( 0f, 1f )] public float MetalThreshold { get; set; } = 0.5f;
	/// <summary>How much darker the gradient's dark stops are than the base colour.</summary>
	[Property, Group( "Metallic Sheen" ), Range( 0f, 1f )] public float MetalDarken { get; set; } = 0.35f;
	/// <summary>How much more saturated the dark stops are.</summary>
	[Property, Group( "Metallic Sheen" ), Range( 0f, 2f )] public float MetalSaturate { get; set; } = 0.4f;
	/// <summary>How much lighter the central sheen stop is.</summary>
	[Property, Group( "Metallic Sheen" ), Range( 0f, 1f )] public float MetalSheen { get; set; } = 0.3f;
	/// <summary>Diagonal angle of the sheen, in degrees.</summary>
	[Property, Group( "Metallic Sheen" ), Range( 0f, 360f )] public float MetalAngle { get; set; } = 135f;

	// --- Swatch outline (derived from each swatch's own colour; selected swatches get a white outline) ---
	[Property, Group( "Outline" )] public float OutlineThickness { get; set; } = 2f;
	/// <summary>How much darker the outline is than the swatch colour.</summary>
	[Property, Group( "Outline" ), Range( 0f, 1f )] public float OutlineDarken { get; set; } = 0.3f;
	/// <summary>How much more saturated the outline is.</summary>
	[Property, Group( "Outline" ), Range( 0f, 2f )] public float OutlineSaturate { get; set; } = 0.3f;
	/// <summary>Outline opacity.</summary>
	[Property, Group( "Outline" ), Range( 0f, 1f )] public float OutlineOpacity { get; set; } = 0.5f;

	// The colour column shares ONE width — PickerSize, the wheel's — so the palette's edges line up with
	// the wheel and sliders above it: the cells divide that width evenly and the visual swatch fills the
	// cell minus the spacing (SwatchSize no longer drives sizing). CellPx is the single integer logical-px
	// value used for BOTH the cells and the container width, so they can never disagree (a fractional Cell
	// would make (int)(Columns*Cell) ≠ Columns*(int)Cell and silently drop a column).
	float Cell => PickerSize / MathF.Max( 1, Columns );
	int CellPx => (int)Cell;
	float SwatchVisual => MathF.Max( 8f, CellPx - SwatchSpacing );

	// Container width = the columns of cells PLUS a hair of slack so flex-wrap never drops a column. At an exact
	// fit (width == Columns*cell) the renderer rounds each cell to whole PHYSICAL px and the rounded sum can land
	// a fraction over the rounded container → the last cell wraps, intermittently, depending on resolution. The
	// overflow is ~½ physical px per cell, which is MORE logical px the smaller the window, so the slack scales
	// with ScaleFromScreen (physical→logical). It stays well under one cell, so it never fits an extra column.
	int PaletteWidth => CellPx * Columns + (int)MathF.Ceiling( (Columns + 1) * (Panel?.ScaleFromScreen ?? 1f) );

	int PaletteRows
	{
		get
		{
			int n = ClayPalette.Default?.Materials?.Count ?? 0;
			return Math.Max( 1, (int)Math.Ceiling( n / (float)Math.Max( 1, Columns ) ) );
		}
	}

	float PaletteHeight => PaletteRows * CellPx;

	// Toggle a mirror-symmetry axis (0=X, 1=Y, 2=Z): the chip flips the PRIMARY's axis and the whole
	// selection lands on that same state, then rebuild.
	void ToggleMirror( int axis )
	{
		if ( Brush is null )
			return;

		bool on = axis switch { 0 => !Brush.MirrorX, 1 => !Brush.MirrorY, _ => !Brush.MirrorZ };
		EditEach( b =>
		{
			switch ( axis )
			{
				case 0: b.MirrorX = on; break;
				case 1: b.MirrorY = on; break;
				default: b.MirrorZ = on; break;
			}

			b.SnapToMirrorPlanes(); // symmetry turned on near the plane = "centre this" — magnetize now
		} );

		Session?.NotifyChanged();
	}

	// Apply a palette preset (colour + metalness + roughness) to every selected brush.
	void ApplyMaterial( ClayMaterial m )
	{
		if ( Brush is null )
			return;

		EditEach( m.ApplyTo );
		SculptEditSession.RememberMaterial( Brush ); // becomes the material new shapes are born with
		Session?.NotifyChanged();
	}

	// Apply colour-wheel / metal / rough edits from the picker column onto every selected brush.
	// These scrub continuously, so they PREVIEW; the control's OnCommit fires the full commit on release.
	// Each also updates the remembered "current material" (see SculptEditSession.LastMaterial).
	void SetColor( Color c )
	{
		if ( Brush is null )
			return;
		EditEach( b => b.Color = c.WithAlpha( 1f ) );
		SculptEditSession.RememberMaterial( Brush );
		Session?.PreviewChanged();
	}

	void SetMetallic( float v )
	{
		if ( Brush is null )
			return;
		EditEach( b => b.Metallic = Math.Clamp( v, 0f, 1f ) );
		SculptEditSession.RememberMaterial( Brush );
		Session?.PreviewChanged();
	}

	void SetRoughness( float v )
	{
		if ( Brush is null )
			return;
		EditEach( b => b.Roughness = Math.Clamp( v, 0f, 1f ) );
		SculptEditSession.RememberMaterial( Brush );
		Session?.PreviewChanged();
	}

	// The copied material (colour + metal/rough). Static on purpose: one clipboard for the whole game, so a
	// material copied from one brush/sculpt can be pasted onto another (and it survives selection changes).
	static (Color Color, float Metallic, float Roughness)? _materialClipboard;

	void CopyMaterial()
	{
		if ( Brush is null )
			return;
		_materialClipboard = (Brush.Color, Brush.Metallic, Brush.Roughness);
	}

	void PasteMaterial()
	{
		if ( Brush is null || _materialClipboard is not { } m )
			return;
		EditEach( b =>
		{
			b.Color = m.Color;
			b.Metallic = m.Metallic;
			b.Roughness = m.Roughness;
		} );
		SculptEditSession.RememberMaterial( Brush );
		Session?.PreviewChanged();
		CommitEdit();
	}

	// Swatch background: a flat colour, or a diagonal dark→light→dark sheen for metallic materials. The
	// sheen maths live in ClayLook so the layer-row icons render the same metal; the palette's inspector
	// tunables are passed through as overrides.
	string SwatchBg( ClayMaterial m )
	{
		var baseHex = ClayLook.Hex( m.Color );
		if ( m.Metalness <= MetalThreshold )
			return $"background-color: {baseHex};";

		var grad = ClayLook.MetalGradient( m.Color, MetalDarken, MetalSaturate, MetalSheen, MetalAngle );
		return $"background-color: {baseHex}; background-image: {grad};";
	}

	// Swatch outline: white when selected, otherwise a darker/more-saturated version of its own colour.
	string SwatchBorder( ClayMaterial m, bool selected )
	{
		int t = (int)OutlineThickness;
		if ( selected )
			return $"border: {t}px solid rgba(255, 255, 255, 1);";

		var c = ClayLook.Saturate( ClayLook.Darken( m.Color, OutlineDarken ), OutlineSaturate );
		string a = OutlineOpacity.ToString( "0.##", CultureInfo.InvariantCulture );
		return $"border: {t}px solid rgba({(int)(c.r * 255)}, {(int)(c.g * 255)}, {(int)(c.b * 255)}, {a});";
	}

	// The selected brush's world bounding SPHERE projected to screen (logical panel px = screen px × scale):
	// its centre + radius. Drives the Bounds silhouette (a per-shape debug view). Returns false when there's
	// no selection or the centre is behind the camera.
	bool BrushScreenSphere( out Vector2 centrePx, out float radiusPx )
	{
		centrePx = default;
		radiusPx = 0f;

		var brush = Brush;
		if ( brush is null )
			return false;

		brush.LocalBounds( out var mn, out var mx, includeBlend: false ); // the visible primitive extent, not the blend-padded mesher bounds
		return ScreenSphere( mn, mx, out centrePx, out radiusPx );
	}

	// The WHOLE sculpt's bounding sphere on screen. Falls back to the selected brush's sphere when the union
	// has no additive brushes to bound (e.g. everything is subtract).
	bool ModelScreenSphere( out Vector2 centrePx, out float radiusPx )
	{
		centrePx = default;
		radiusPx = 0f;

		var brushes = Session?.Target?.Brushes;
		if ( brushes is not null && Sdf.TryGetBounds( brushes, out var bb ) )
			return ScreenSphere( bb.Mins, bb.Maxs, out centrePx, out radiusPx );

		return BrushScreenSphere( out centrePx, out radiusPx );
	}

	// The circle the palette / picker / sliders float around: the shape's (or, with UseShapeBounds off, the
	// whole sculpt's) bounding circle, grown to cover the gizmo's on-screen footprint — whichever is larger
	// wins, so a small shape's floats still clear the handles instead of sitting on top of them. Anchoring
	// to a projected sphere (rather than a gizmo handle) keeps the floats roughly put as you orbit.
	bool AnchorScreenSphere( out Vector2 centrePx, out float radiusPx )
	{
		bool ok = UseShapeBounds
			? BrushScreenSphere( out centrePx, out radiusPx )
			: ModelScreenSphere( out centrePx, out radiusPx );
		if ( !ok )
			return false;

		if ( Session?.TryGetGizmoScreenCircle( out var gizmoCentre, out var gizmoRadius ) ?? false )
		{
			// Screen px → panel px, then grow to the gizmo circle's FAR edge — it's usually concentric with
			// the shape, but the whole-sculpt bounds centre can sit elsewhere.
			float scale = Panel?.ScaleFromScreen ?? 1f;
			var gc = new Vector2( gizmoCentre.x * scale, gizmoCentre.y * scale );
			radiusPx = MathF.Max( radiusPx, (gc - centrePx).Length + gizmoRadius * scale );
		}

		return true;
	}

	// Project a local-space AABB's bounding sphere to screen (shared by the brush + whole-model anchors).
	bool ScreenSphere( Vector3 mn, Vector3 mx, out Vector2 centrePx, out float radiusPx )
	{
		centrePx = default;
		radiusPx = 0f;

		var s = Session;
		var cam = Scene?.Camera;
		if ( s is null || cam is null || !s.Target.IsValid() )
			return false;

		var tx = s.Target.WorldTransform;
		var worldCentre = tx.PointToWorld( (mn + mx) * 0.5f );
		float worldRadius = MathF.Max( (mx - mn).Length * 0.5f, 1f );

		if ( Vector3.Dot( worldCentre - cam.WorldPosition, cam.WorldRotation.Forward ) <= 0f )
			return false; // behind the camera

		float scale = Panel?.ScaleFromScreen ?? 1f;
		var c = cam.PointToScreenPixels( worldCentre );
		var e = cam.PointToScreenPixels( worldCentre + cam.WorldRotation.Right * worldRadius );
		centrePx = new Vector2( c.x * scale, c.y * scale );
		radiusPx = new Vector2( e.x - c.x, e.y - c.y ).Length * scale; // sphere radius in panel px
		return true;
	}

	// Palette: just off the RIGHT of the anchor circle, vertically centred on it. DistanceFromGizmo is the
	// gap beyond the silhouette. Clamped so the palette AND the picker column to its right both stay on
	// screen — the palette gives ground early so the wheel never has to choose between the screen edge and
	// overlapping the swatches.
	// Both tools dock the panels to the screen edges now (nothing anchors to the shape — the ghost tracks
	// the cursor in add mode, and a stable home beats chasing the selection in edit mode). The colour stack
	// is anchored to the BOTTOM-RIGHT — picker column (wheel / metal / rough / copy-paste) on top, palette
	// beneath it, palette flush with the bottom — so it sits in the exact same place in Add and Edit and
	// clear of the top-right Tools/Symmetry panel.
	Vector2? PalettePos()
	{
		float sc = Panel?.ScaleFromScreen ?? 1f;
		const float m = 24f; // matches $panel-inset, so the whole right column shares one edge
		return new Vector2(
			MathF.Max( m, Screen.Width * sc - PaletteWidth - m ),
			MathF.Max( m, Screen.Height * sc - PaletteHeight - m ) );
	}

	// Picker column (colour wheel + metal/rough sliders): just off the RIGHT of the palette, top-aligned
	// with it. Takes the palette's slot (and centres on the bounding circle) when the palette is hidden.
	// The picker column: right edge, sitting directly ABOVE the bottom-anchored palette (its rendered
	// height is measured — the estimate misses the copy/paste row). Without the palette it takes the
	// bottom-right corner itself.
	Vector2? PickerPos()
	{
		float sc = Panel?.ScaleFromScreen ?? 1f;
		const float m = 24f; // matches $panel-inset, so the whole right column shares one edge

		float ph = PickerStackHeight;
		if ( PickerPanel is { } pp && pp.Box.Rect.Height > 0f )
			ph = pp.Box.Rect.Height * sc;

		float bottom = Screen.Height * sc - m;
		if ( ShowPalette && PalettePos() is { } pal )
			bottom = pal.y - PickerGap;

		return new Vector2(
			MathF.Max( m, Screen.Width * sc - PickerSize - m ),
			MathF.Max( m, bottom - ph ) );
	}

	// Sliders: under the BOTTOM of the anchor circle, horizontally centred on it. Clamped to the screen, so
	// on a big/zoomed-in shape they ride up against the bottom edge instead of falling off it.
	// The blend/round/etc. sliders: ONE horizontal strip docked bottom-centre, above the hint strip — a
	// stable home and the live READOUT for the A/S/D hold scrubs. Width and height are measured (the
	// slider count and the profile/text rows vary by shape); estimates cover the pre-first-layout frame.
	Vector2? SliderPos()
	{
		float sc = Panel?.ScaleFromScreen ?? 1f;
		float sw = SliderWidth * 2f;
		float sh = 52f;
		if ( SliderStackPanel is { } sp && sp.Box.Rect.Width > 0f )
		{
			sw = sp.Box.Rect.Width * sc;
			sh = sp.Box.Rect.Height * sc;
		}

		return new Vector2(
			MathF.Max( 8f, (Screen.Width * sc - sw) * 0.5f ),
			MathF.Max( 8f, Screen.Height * sc - sh - 40f ) );
	}

	// Re-render when the session/selection/brush state or the gizmo's screen position changes (so the palette
	// follows the gizmo). While dragging a handle the palette is fading out, so freeze the tracked position
	// out of the hash — else the brush moving each frame would re-render and restart the fade transition.
	protected override int BuildHash()
	{
		var s = Session;
		var b = Brush;
		bool manip = s?.IsManipulating ?? false;
		var pos = PalettePos();
		int px = (pos.HasValue && !manip) ? (int)pos.Value.x : int.MinValue;
		int py = (pos.HasValue && !manip) ? (int)pos.Value.y : int.MinValue;
		var ppos = PickerPos();
		int ppx = (ppos.HasValue && !manip) ? (int)ppos.Value.x : int.MinValue;
		int ppy = (ppos.HasValue && !manip) ? (int)ppos.Value.y : int.MinValue;

		var hc = new HashCode();
		hc.Add( s );
		hc.Add( s?.IsEditing ?? false );
		hc.Add( InvalidBounds is { } iv ? (iv.TooBig ? 1 : 2) : 0 ); // validity toast appears/disappears/relabels
		hc.Add( NoSolidToast ); // transient "must have at least 1 shape" toast appears/disappears
		hc.Add( s?.ExitConfirmPending ?? false ); // exit-confirm dialog mounts/unmounts
		hc.Add( s?.ExitConfirmTooBig ?? false );
		hc.Add( ShowTools ); hc.Add( ShowLayers ); hc.Add( ShowPalette ); hc.Add( ShowSliders ); hc.Add( ShowBounds );
		hc.Add( ShowPicker );
		hc.Add( TutorialDirector.HintStripHidden ); // the tutorial hides the hint-strip while guiding
		hc.Add( EditHudGate.Version ); // per-section tutorial gating (hide/lock/highlight) — bumped on every change
		hc.Add( BackAction is not null ); // the customiser's Back button mounts/unmounts with its wiring
		hc.Add( WorkshopSave is not null ); // ditto the customiser's Workshop column
		hc.Add( Game.IsEditor );
		hc.Add( s?.Target );
		hc.Add( _prefabSaveStatus );
		hc.Add( WorkshopBrowserOpen );     // the library window mounts/unmounts
		hc.Add( WorkshopStatus );          // search/download status line appears/relabels/clears
		hc.Add( WorkshopItems?.Count ?? -1 ); // tiles mount/unmount
		hc.Add( s?.HoveringSplineLine ?? false ); // re-render so the add-point cursor panel appears/disappears on hover
		hc.Add( s?.SplinePointUiDragging ?? false ); // keep it mounted through the insert-and-place drag, drop it on release
		hc.Add( (int)(s?.Tool ?? SculptTool.Gizmo) );          // tool toggle highlight + add-mode layout swap
		hc.Add( (int)(s?.ActiveShape ?? SdfShape.Sphere) );   // active stamp-shape tile highlight
		hc.Add( (int)(s?.StampOperation ?? SdfOperation.Add) ); // Add/Carve chip highlight + LMB hint label
		hc.Add( s?.ChainWillLoop ?? false );                   // spline LMB hint flips to "close loop"
		hc.Add( s?.StampBrush is not null );                  // ghost row skip + panel visibility
		hc.Add( s?.IsScrubbing ?? false );                    // scrub dot + capture
		hc.Add( s?.ChainWillLoop ?? false );                  // "close loop" hints, both modes
		hc.Add( s?.SplineWillLoop ?? false );
		// Hash the FRESHLY COMPUTED dock positions, not the stored fields — the stored ones only change
		// during a render, so hashing them can never trigger the re-render that re-centres the strips
		// after their measured size changes (2 vs 3 sliders left the row misaligned until something else
		// happened to redraw).
		if ( ShapeDockPos() is { } sdp ) { hc.Add( (int)sdp.x ); hc.Add( (int)sdp.y ); }
		if ( SliderPos() is { } slp ) { hc.Add( (int)slp.x ); hc.Add( (int)slp.y ); }
		hc.Add( (int)ToastBottom() );

		// While a frozen-cursor gesture runs with a stamp up, the dot rides the shape — fold its projected
		// position in so the dot re-renders as the camera moves it across the screen.
		if ( s is not null && (AltNav.Dragging || s.IsScrubbing)
			&& s.TryGetStampScreenPos( out var stampDotPx ) )
		{
			hc.Add( (int)stampDotPx.x );
			hc.Add( (int)stampDotPx.y );
		}
		hc.Add( (int)BrushScrub.Active );
		hc.Add( s?.CanUndo ?? false ); // undo/redo buttons dim at the ends of the history
		hc.Add( s?.CanRedo ?? false );
		hc.Add( s?.Selected ?? -1 );
		// The whole multi-selection: rows highlight off membership, and group ops re-target with it.
		if ( s is not null )
		{
			foreach ( var selIdx in s.Selection )
				hc.Add( selIdx );
		}
		hc.Add( s?.Target?.AuthoredBrushCount ?? 0 ); // damage-tail changes (a shot landing) don't churn the rows

		// Each row shows per-brush state (shape / op / colour / visibility / symmetry), so fold all of it in
		// — otherwise toggling a NON-selected row wouldn't re-render its icons.
		if ( s?.Target?.Brushes is { } rows )
			foreach ( var br in rows )
			{
				hc.Add( (int)br.Shape );
				hc.Add( (int)br.Operation );
				hc.Add( br.Enabled );
				hc.Add( br.Color );
				hc.Add( br.MirrorX ); hc.Add( br.MirrorY ); hc.Add( br.MirrorZ );
			}

		hc.Add( _dragIndex );
		hc.Add( _dropIndex );
		hc.Add( _dragOffsetY );
		hc.Add( _stride );
		hc.Add( AltNav.Dragging );
		hc.Add( AltNav.Anchor );
		hc.Add( AltNav.Held );
		hc.Add( PauseMenu.IsOpen ); // re-render so the HUD goes inert (alt-nav class) while paused
		hc.Add( b?.Color );
		hc.Add( b?.Metallic ?? 0f );
		hc.Add( b?.Roughness ?? 0f );
		hc.Add( b?.Blend ?? 0f );      // drives the 2D blend slider's fill
		hc.Add( b is not null && s?.Target?.Brushes is { } bl && Sdf.BlendInert( bl, b ) ); // blend-slider lock
		hc.Add( b?.Rounding ?? 0f );   // drives the 2D roundness slider's fill
		hc.Add( b?.Slice ?? 0f );      // drives the slice slider's fill (sphere/cone)
		hc.Add( b?.Curvature ?? 0f );  // drives the spline curvature slider's fill
		hc.Add( b?.SplineClosed ?? false );         // highlights the Loop chip
		hc.Add( b?.Points is { Count: > 0 } bp ? bp[0].w : 0f ); // drives the uniform Size slider's fill
		hc.Add( b?.Points?.Count ?? 0 );            // enables/disables the Loop chip (3+ points)
		hc.Add( (int)(b?.Shape ?? SdfShape.Sphere) ); // show/hide the curvature slider (spline only)
		hc.Add( (int)(b?.CrossSection ?? SdfCrossSection.Triangle) ); // highlight the picked profile chip
		hc.Add( b?.Text ); // show/refresh the text-entry row
		hc.Add( b?.Font );
		hc.Add( b?.MirrorX ?? false );
		hc.Add( b?.MirrorY ?? false );
		hc.Add( b?.MirrorZ ?? false );
		hc.Add( ClayPalette.Default?.Materials?.Count ?? 0 );
		hc.Add( px );
		hc.Add( py );
		hc.Add( ppx );
		hc.Add( ppy );
		hc.Add( PickerSize );
		hc.Add( PickerGap );
		hc.Add( UseShapeBounds );
		hc.Add( ClayColorPicker.Dragging ); // raise/drop the drag-capture overlay for wheel scrubs too
		hc.Add( _materialClipboard.HasValue ); // un-dims the Paste chip after the first Copy
		hc.Add( manip );
		hc.Add( SwatchSize );
		hc.Add( SwatchSpacing );
		hc.Add( SwatchRoundness );
		hc.Add( DistanceFromGizmo );
		hc.Add( SliderWidth );           // so inspector tweaks to the slider tunables re-render live
		hc.Add( BlendCurve );
		hc.Add( ClaySlider.Dragging );   // raise/drop the drag-capture overlay as a scrub starts/ends
		hc.Add( SliderDropFromGizmo );
		hc.Add( SliderStackHeight );
		hc.Add( EditTransparency );
		hc.Add( FadeTime );
		hc.Add( HoverScale );
		hc.Add( _hoverIndex );
		hc.Add( MetalThreshold );
		hc.Add( MetalDarken );
		hc.Add( MetalSaturate );
		hc.Add( MetalSheen );
		hc.Add( MetalAngle );
		hc.Add( OutlineThickness );
		hc.Add( OutlineDarken );
		hc.Add( OutlineSaturate );
		hc.Add( OutlineOpacity );
		return hc.ToHashCode();
	}
}
