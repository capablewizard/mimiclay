	// The shape list's scroll container (see .layers-wrap). Scrollable = the rows overflow it.
	Panel LayersPanel { get; set; }
	bool LayersScrollable => LayersPanel.IsValid() && LayersPanel.HasScrollY && LayersPanel.ScrollSize.y > 0.5f;

	// A shape picked in the 3D view scrolls its row into the shape list's view (StepScrollList.Reveal). Keyed on the
	// BRUSH, not its index, so a reorder doesn't count as a new pick; a pick made from the HUD itself (clicking a row) is
	// skipped — that row is under the cursor, and the list mustn't slide out from under it. A brand-new shape's row only
	// exists a frame or two later, so the reveal waits for it (briefly).
	SdfBrush _revealSeen;
	bool _revealPending;
	RealTimeSince _sinceRevealAsked;

	void RevealSelectedRow()
	{
		var sel = Session is { IsEditing: true } s ? s.SelectedBrush : null;
		if ( !ReferenceEquals( sel, _revealSeen ) )
		{
			_revealSeen = sel;
			_revealPending = sel is not null && !PointerOverPanels;
			_sinceRevealAsked = 0f;
		}

		if ( !_revealPending || !LayersPanel.IsValid() )
			return;
		if ( _sinceRevealAsked > 1f || Session is null )
		{
			_revealPending = false;
			return;
		}

		int idx = Session.Selected;
		foreach ( var child in LayersPanel.Children )
		{
			if ( child is LayerRow row && row.Index == idx && row.Box.Rect.Height > 1f )
			{
				_listFx.Reveal( LayersPanel, row );
				_revealPending = false;
				return;
			}
		}
	}

