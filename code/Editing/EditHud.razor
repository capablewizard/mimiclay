	// leaves slides back out while that space closes (negative bottom margin = its height + the column gap, scaled by
	// the room) — nothing below it jumps. Snapped to rest when the column itself mounts: it slides in whole then.
	UiSpring _editChipsSlide, _symSlide;
	float _editChipsH, _symH;
