@using System
@using System.Collections.Generic
@using System.Globalization
@using Sandbox
@using Sandbox.UI
@namespace Mimiclay
@inherits PanelComponent

@*
	In-game sculpt editor HUD. Binds to SculptEditSession.Current, so it's identical in prop-hunt or
	creative mode — drop this PanelComponent on a HUD GameObject and it shows two panels whenever a
	session is editing: left = add shapes + layer stack, right = selected-brush properties.
*@

<root class=@RootClass>

	@* While dragging a layer OR scrubbing a slider, a full-screen transparent surface keeps a pointer-events:all
	   region under the cursor so the native drag keeps firing OnDrag/OnDragEnd. Otherwise the thin slider track /
	   the gaps between floating cards click through to the world, stalling the drag and swallowing the mouse-up.
	   The shape list's scroll thumb too: without it a fast thumb drag flicked the cursor between the thumb's hand, the
	   rows' and the world cursor every frame — the suspect behind the editor's 50–200 ms frames during one (profiled). *@
	@if ( _dragIndex >= 0 || ClaySlider.Dragging || ClayColorPicker.Dragging || (ListThumb?.Dragging ?? false) )
	{
		<div class="drag-capture"></div>
	}

	@* Transient refusal toast: the session just refused a layer action that would have left no solid
	   clay — deleting, hiding or carving the last additive brush (no shape means no collider, and a prop
	   pawn would fall through the floor). Same look and anchor as the validity toast below; it takes the
	   slot while active, being the direct response to the player's click. *@
	@if ( NoSolidToast )
	{
		<div class="validity-float" style="bottom: @((int)ToastBottom())px;">
			<div class="paper-card validity-toast">
				<span class="emoji">⚠️</span>
				<span>Must have at least 1 shape</span>
			</div>
		</div>
	}
	@* Sculpt-validity toast: shows whenever the LOCAL player's sculpt violates its SculptBounds and stays
	   until fixed, edit mode or not — the invalid shape is owner-local (never broadcast), so the player
	   has to know the world doesn't see what they see. Floats above the shape dock while the dock is
	   shown; hugs the bottom of the screen otherwise (see ToastPos). *@
	else if ( InvalidBounds is { } inv )
	{
		@* Full-width flex wrapper + a bottom anchor, so neither axis depends on the toast's own measured
		   size — a freshly mounted panel has no rect for a frame, and position computed from an estimated
		   size rendered one frame off-centre before snapping (the dock gets away with it because its width
		   never changes). CSS centres x exactly; growing up from `bottom` makes height irrelevant. *@
		<div class="validity-float" style="bottom: @((int)ToastBottom())px;">
			<div class="paper-card validity-toast">
				<span class="emoji">⚠️</span>
				<span>@(inv.TooBig ? "Sculpt too large" : "Sculpt too small")</span>
			</div>
		</div>
	}

	@* Exit-confirm dialog: leaving edit mode with an incompatible sculpt REVERTS it to the last valid
	   shape (see SculptEditSession.RequestExit) — this makes that a choice, not a surprise. The scrim
	   owns the pointer so nothing world-side fires underneath, and PointerOverUi reports true while it's
	   up so picks/stamps/scrubs stay parked too. *@
	@if ( Session is not null && Session.ExitConfirmPending )
	{
		<div class="exit-confirm">
			<div class="paper-card confirm-card">
				<div class="confirm-title">
					<span class="emoji">⚠️</span>
					<span>@(Session.ExitConfirmTooBig ? "Sculpt too large" : "Sculpt too small")</span>
				</div>
				<div class="confirm-body">We'll use your last good shape.</div>
				<div class="confirm-buttons">
					<div class="btn" @onclick=@(() => Session?.CancelExit())>Keep Editing</div>
					<div class="btn" @onclick=@(() => Session?.ConfirmExit())>Revert</div>
				</div>
			</div>
		</div>
	}

	@if ( Session is not null && (Session.IsEditing || Closing) )
	{
		@* (The alt-nav view hints that used to sit top-right are gone — the picker column lives there now,
		   and the alt gestures are covered by muscle memory / the menu's own copy.) *@

		@* Hotkey bar, bottom-centre — the shared HotkeyBar (the round HUD's controls bar): contextual cards for the
		   current mode (EditHotkeys), with the wobble, grow-in / exit, press punch and click. Faded (still laid out)
		   while a guided tutorial step runs — the tutorial card teaches one thing at a time, and the full key list
		   underneath would drown that. Back the moment guidance ends (free-play included). *@
		@* WobbleStrength 0: the edit bar holds still — it sits under the sliders and shape row, where the motion was noise. *@
		<HotkeyBar Source=@EditHotkeySource Hidden=@TutorialDirector.HintStripHidden ClearCorner=@true WobbleStrength=@(0f)
			Clickable=@BarClickable />

		@* Part dock — Head / Weapon (whatever parts the pawn wired onto its sessions; see
		   SculptEditSession.EditParts). Bottom-centre, only while nothing is selected and no stamp is held:
		   the neutral state, when the shape dock and sliders are down and the slot is free. The active part
		   is the usual selected-orange chip; clicking the other one switches which session is editing.
		   Mounted whenever the session has parts; the chips are PopFlex `pop` items (StepPops), `gone` outside the
		   neutral state, so they pop UP together like the shape tiles instead of blinking in. *@
		@if ( ((Session?.IsEditing ?? false) || Closing) && Session.EditParts is { Count: > 0 } parts )
		{
			var partsOn = PartDockShown;
			<div class="part-dock" @ref="PartDockPanel" style="bottom: @((int)(BarClearance + 16f))px;">
				@foreach ( var entry in parts )
				{
					var part = entry;
					<div class="pop @(partsOn ? "" : "gone")" @key=@part.Label>
						<div class="chip @(part.Active ? "on" : "")" @onclick=@(() => part.Select?.Invoke())>
							<span>@part.Label</span>
						</div>
					</div>
				}
			</div>
		}

		@* The left column is just the layer stack now — shape choice moved to the bottom dock (it's a
		   property of the brush, not a tool), and the Add/Edit mode toggle is gone entirely. *@
		@if ( ShowLayers && EditHudGate.Visible( HudSection.Layers ) )
		{
		<div class="panel left @EditHudGate.PanelClass( HudSection.Layers )" @ref="LeftPanel">
			<div class="section-title"><div class="icon">layers</div><span>Shapes</span></div>

			@* Scrolls once the rows no longer fit (they never squash — see .layer); the thumb rides its right edge
			   and the bottom fades out while there's more below (LayersClass). *@
			<div class="layers-wrap">
			@* The fade mask sits on this wrapper, not the list: a masked panel draws through a layer clipped at its CONTENT box,
			   so on the padded list it cut off the rows' hover grow and shadow (they live in that padding). This one has no
			   padding — its content box is the list's whole padded rect. *@
			<div class="layers-mask" @ref="LayersMaskPanel">
			<div class="layers" @ref="LayersPanel">
				@{
					var brushes = Session.Target?.Brushes;
					// Only the AUTHORED prefix gets rows — the damage tail (shot craters) is invisible to
					// editing. Damage is contiguous at the end, so row/index math stays exact with this count.
					var authored = Session.Target?.AuthoredBrushCount ?? 0;
				}
				@if ( brushes is not null )
				{
					@* Top of the list = last authored brush (drawn on top of the field, below any damage). *@
					@for ( int i = authored - 1; i >= 0; i-- )
					{
						var idx = i;
						var b = brushes[idx];
						if ( b == Session.StampBrush )
							continue; // the pending stamp ghost isn't a real layer yet — no row
						<LayerRow @key=@b class=@(LayerClass( idx )) style=@(LayerStyle( idx ))
							Index=@idx Shape=@b.Shape Operation=@b.Operation Color=@b.Color
							Enabled=@b.Enabled SymmetryOn=@(b.MirrorX || b.MirrorY || b.MirrorZ) Amount=@b.Blend
							AmountScrubBegin=@HandleAmountScrubBegin AmountScrubMove=@HandleAmountScrubMove AmountScrubEnd=@HandleAmountScrubEnd
							PressStart=@HandlePressStart Pick=@HandlePick DragBegin=@HandleDragBegin DragMove=@HandleDragMove DragEnd=@HandleDragEnd
							ToggleEnabled=@HandleToggleEnabled ToggleOperation=@HandleToggleOperation
							ToggleSymmetry=@HandleToggleSymmetry DeleteRow=@HandleDelete
							RowHover=@HandleRowHover RowUnhover=@HandleRowUnhover />
					}
				}
			</div>
			</div>
			<ListScrollThumb List=@LayersPanel @ref="ListThumb" />
			</div>

			@* The menu customiser's Back button — under the shape list, pinned to the column's bottom by the
			   layers' flex-grow (right where the menu footer's Back sits on every other page, which this
			   replaces there — see MenuCustomise). Only mounted when a BackAction is wired; in game it never is. *@
			@if ( BackAction is not null )
			{
				<div class="back-btn" @onclick=@(() => BackAction?.Invoke())>
					<WobbleText Text="Back" />
				</div>
			}

			@if ( EditHudGate.Of( HudSection.Layers ) == SectionState.Locked )
			{
				<div class="tutorial-lock-shield"></div>
			}

		</div>
		}

		@* Per-axis symmetry for the selected brush. The row's symmetry button is a quick on/off (X);
		   this section picks which axes when you want quadrant/octant mirroring. Lives in its own right-hand
		   panel so the left column's full height is free for the layer stack. *@
		@if ( ShowTools && EditHudGate.Visible( HudSection.Tools ) )
		{
			<div class="panel right @EditHudGate.PanelClass( HudSection.Tools )" @ref="RightPanel">
				<div class="section-title"><span>Tools</span><div class="icon">auto_awesome</div></div>
				@* Vertical list: Add Shape keeps the SAME spot whatever the state; the selection-only tools
				   grow downward beneath it instead of shoving it sideways. *@
				<div class="tool-list">
					@* Toggles placing on/off — while a stamp is held it's the way back to plain editing
					   (same as a right-click or Esc). Stays the top button: it's the one users reach for
					   without looking. *@
					@if ( EditHudGate.Visible( HudSection.AddChip ) )
					{
						var placing = Session.Tool == SculptTool.Sculpt;
						@* Its key (Space — adds a shape, or finishes placing one) in front of the label: the hotkey cards'
						   style, standing in for the icon (a key-cap AND an icon don't fit the column beside the name). *@
						<div class="chip action @(placing ? "on" : "") @(StripFired( "space" ) ? "fired" : "") @EditHudGate.ChipClass( HudSection.AddChip )" @onclick=@(() => GateClick( HudSection.AddChip, () => Session.SetTool( placing ? SculptTool.Gizmo : SculptTool.Sculpt ) ))>
							<div class="slider-key">Space</div><span>@(placing ? "Done" : "Add Shape")</span>
						</div>
					}

					@* Undo / redo pair up on one row directly under Add Shape, so both keep a fixed home and
					   the selection-only tools still grow downward beneath them. Dimmed (and inert) at the
					   ends of the history rather than hidden — a button that vanishes reads as a bug. *@
					@if ( EditHudGate.Visible( HudSection.UndoRedo ) )
					{
					<div class="undo-row">
						<div class="chip action @(Session.CanUndo ? "" : "disabled") @EditHudGate.ChipClass( HudSection.UndoRedo )" @onclick=@(() => GateClick( HudSection.UndoRedo, () => Session.Undo() ))>
							<div class="icon">@SdfIcons.Undo</div><span>Undo</span>
						</div>
						<div class="chip action @(Session.CanRedo ? "" : "disabled") @EditHudGate.ChipClass( HudSection.UndoRedo )" @onclick=@(() => GateClick( HudSection.UndoRedo, () => Session.Redo() ))>
							<div class="icon">@SdfIcons.Redo</div><span>Redo</span>
						</div>
					</div>
					}
					@* Smooth: adds a Smooth MODIFIER layer — no shape of its own, it smooths every layer under it in the
					   stack (SdfModifiers). Lands just above the selected layer, or on top of the stack with nothing
					   selected. Always offered (not a selection-only tool); hidden while the tutorial trims to basics. *@
					@if ( EditHudGate.Visible( HudSection.EditChips ) && !EditHudGate.BasicShapesOnly )
					{
						<div class="chip action @EditHudGate.ChipClass( HudSection.EditChips )" @onclick=@(() => GateClick( HudSection.EditChips, () => Session.AddModifier( SdfShape.Smooth ) ))>
							<div class="icon">@SdfIcons.Modifier</div><span>Add Smooth</span>
						</div>
					}
					@* Selection-only tools: always mounted, slid in from the right edge and out again (StepToolGroups) while
					   the list below closes up; they used to blink in and out. *@
					@if ( EditHudGate.Visible( HudSection.EditChips ) )
					{
						<div class="tool-slide @(Session.Tool == SculptTool.Gizmo && ToolsBrush is not null ? "" : "gone")" @ref="EditChipsGroup">
							<div class="chip action @EditHudGate.ChipClass( HudSection.EditChips )" @onclick=@(() => GateClick( HudSection.EditChips, () => Session.DuplicateSelected() ))>
								<div class="icon">@SdfIcons.Duplicate</div><span>Duplicate</span>
							</div>
							<div class="chip action danger @(StripFired( "delete" ) ? "fired" : "") @EditHudGate.ChipClass( HudSection.EditChips )" @onclick=@(() => GateClick( HudSection.EditChips, () => Session.RemoveSelected() ))>
								<div class="slider-key">Del</div><span>Delete</span>
							</div>
						</div>
					}
				</div>
				@if ( EditHudGate.Visible( HudSection.Symmetry ) )
				{
				<div class="tool-slide sym-group @(ToolsBrush is not null ? "" : "gone")" @ref="SymGroup">
					@* One Symmetry button (the layer row's quick toggle: off remembers the axes, on restores them, X by default)
					   with the per-axis picks in a compact row under it. *@
					<div class="tool-list">
						<div class="chip action @(SymOn ? "on" : "") @EditHudGate.ChipClass( HudSection.Symmetry )" @onclick=@(() => GateClick( HudSection.Symmetry, ToggleSymmetryAll ))>
							<div class="icon">@SdfIcons.Symmetry</div><span>Symmetry</span>
						</div>
						<div class="axis-row">
							<div class="chip axis @(SymBrush?.MirrorX == true ? "on" : "") @EditHudGate.ChipClass( HudSection.Symmetry )" @onclick=@(() => GateClick( HudSection.Symmetry, () => ToggleMirror( 0 ) ))>X</div>
							<div class="chip axis @(SymBrush?.MirrorY == true ? "on" : "") @EditHudGate.ChipClass( HudSection.Symmetry )" @onclick=@(() => GateClick( HudSection.Symmetry, () => ToggleMirror( 1 ) ))>Y</div>
							<div class="chip axis @(SymBrush?.MirrorZ == true ? "on" : "") @EditHudGate.ChipClass( HudSection.Symmetry )" @onclick=@(() => GateClick( HudSection.Symmetry, () => ToggleMirror( 2 ) ))>Z</div>
						</div>
					</div>
				</div>
				}
				@if ( EditHudGate.Of( HudSection.Tools ) == SectionState.Locked )
				{
					<div class="tutorial-lock-shield"></div>
				}
			</div>
		}

		@* Workshop column — a second card stack just LEFT of the Tools panel, same paper style. Only mounted
		   when an owner wires the actions: the menu customiser (heads) and creative mode (props / faces —
		   see CreativeManager.UpdateWorkshopUi); round HUDs never do. *@
		@if ( WorkshopShown || Game.IsEditor )
		{
			<div class="panel right workshop-col" @ref="WorkshopPanel">
				@if ( WorkshopShown )
				{
				<div class="section-title"><span>Workshop</span><div class="icon">cloud</div></div>
				<div class="tool-list">
					<div class="chip action" @onclick=@(() => WorkshopSave?.Invoke())>
						<div class="icon">cloud_upload</div><span>Save</span>
					</div>
					<div class="chip action" @onclick=@(() => WorkshopLoad?.Invoke())>
						<div class="icon">cloud_download</div><span>Load</span>
					</div>
				</div>
				}
				@if ( Game.IsEditor )
				{
					<div class="section-title"><span>Prefab</span><div class="icon">widgets</div></div>
					<div class="tool-list">
						<div class="chip action" @onclick=@(() => SavePrefab( false ))>
							<div class="icon">save</div><span>Save</span>
						</div>
						<div class="chip action" @onclick=@(() => SavePrefab( true ))>
							<div class="icon">save_as</div><span>Save As...</span>
						</div>
					</div>
					@if ( _prefabSaveTarget == Session?.Target && _prefabSaveStatus is not null )
					{
						<div class="prefab-save-status">@_prefabSaveStatus</div>
					}
				}
			</div>

			@* The workshop library window — our own browser (loading is silent API; only publishing has an
			   engine dialog). Centre-screen paper card with the player's published heads as rounded image
			   tiles, thumbnails straight off each item's workshop preview. The WRAPPER is click-through so
			   the sculpt stays interactive around the window; the card opts in and is tracked in
			   PointerOverPanels so world picks/stamps stand down underneath it. *@
			@if ( WorkshopBrowserOpen )
			{
				<div class="workshop-window-wrap">
					<div class="paper-card workshop-window" @ref="WorkshopWindowPanel">
						<div class="window-head">
							<div class="section-title"><div class="icon">cloud</div><span>Workshop</span></div>
							<div class="chip mini window-close" @onclick=@(() => WorkshopClose?.Invoke())>
								<div class="icon">close</div>
							</div>
						</div>

						@if ( WorkshopStatus is not null )
						{
							<div class="workshop-status">@WorkshopStatus</div>
						}

						@if ( WorkshopItems is { Count: > 0 } )
						{
							<div class="workshop-grid">
								@foreach ( var entry in WorkshopItems )
								{
									var it = entry;
									@* No card behind each tile — the thumbnails carry their own ink outline,
									   so they sit on the window like photos: rounded image, name beneath. *@
									<div class="workshop-tile" @onclick=@(() => it.Apply?.Invoke())>
										@if ( string.IsNullOrEmpty( it.Image ) )
										{
											<div class="tile-fallback"><div class="icon">face</div></div>
										}
										else
										{
											@* Silhouette shadow, faked in CSS: the same image again UNDER the
											   real one, offset + blur() + brightness(0) — black keeps the alpha
											   shape. (filter: drop-shadow would be the real feature; it parses
											   but never draws on this engine build.) *@
											<div class="tile-stack">
												<div class="tile-img tile-shadow" style="background-image: url( @it.Image )"></div>
												<div class="tile-img" style="background-image: url( @it.Image )"></div>
											</div>
										}
										<span class="label">@it.Title</span>
									</div>
								}
							</div>
						}
					</div>
				</div>
			}
		}

		@* Palette + sliders fade in/out with the selection. They stay mounted while editing (a mount/unmount can't
		   animate) — content comes from _fadeBrush so they hold their last state while fading out after a deselect —
		   and opacity is driven by whether a brush is selected, so the CSS opacity transition animates both ways. *@
		if ( Brush is not null )
			_fadeBrush = Brush;
		if ( Brush is not null && !Brush.IsModifier )
			_shapeBrush = Brush; // the shape-only controls (op chip, shape tiles) keep showing this while they pop OUT for a Smooth layer

		var palettePos = PalettePos();
		if ( palettePos.HasValue )
			_palettePos = palettePos.Value;

		@* The colour column (palette + picker) rides one full-screen, click-through layer that SLIDES in from the right
		   edge it's docked to, on a spring (OnUpdate → StepColourSlide) — rather than fading: it's out whenever the
		   active brush has no material (none, or a Smooth layer). Opacity is left to the manipulation fade + lock dim. *@
		var colourOn = Brush is not null && !Brush.IsModifier;
		var pickerPos = PickerPos();
		if ( pickerPos.HasValue )
			_pickerPos = pickerPos.Value;
		<div @ref="ColourSlidePanel" class="colour-slide">
		@if ( PaletteOn && EditHudGate.Visible( HudSection.Palette ) )
		{
			var paletteGate = EditHudGate.Of( HudSection.Palette );
			var paletteShown = colourOn && palettePos.HasValue; // a modifier has no material
			@* The lock dim rides the inline opacity (a class can't override an inline style). *@
			var paletteOpacity = (Session.IsManipulating ? EditTransparency : 1f)
				* (paletteGate == SectionState.Locked ? LockDim : 1f);
			var mats = ClayPalette.Default.Materials;
			<div @ref="PalettePanel" class="palette-float @(paletteGate == SectionState.Highlight ? "tutorial-highlight" : "")" style="left: @((int)_palettePos.x)px; top: @((int)_palettePos.y)px; width: @(PaletteWidth)px; opacity: @(paletteOpacity.ToString( "0.###", CultureInfo.InvariantCulture )); pointer-events: @(paletteShown && paletteOpacity > 0.01f && !Inert ? "all" : "none"); transition: opacity @(FadeTime.ToString( "0.###", CultureInfo.InvariantCulture ))s ease;">
				@for ( int i = 0; i < mats.Count; i++ )
				{
					var idx = i;
					var m = mats[idx];
					var sel = _fadeBrush is not null && m.Matches( _fadeBrush );
					var sc = (idx == _hoverIndex) ? HoverScale : 1f;
					@* Cell = gap-free hit target; the swatch inside is the visual. Hover scale is driven in C#
					   (s&box CSS :hover doesn't reliably apply transform here) and baked into the inline style,
					   so it survives the per-frame re-renders that track the gizmo instead of being wiped. *@
					<div class="swatch-cell" style="width: @(CellPx)px; height: @(CellPx)px;"
						@onclick=@(() => ApplyMaterial( m ))
						@onmouseover=@(() => _hoverIndex = idx)
						@onmouseout=@(() => { if ( _hoverIndex == idx ) _hoverIndex = -1; })>
						<div class="swatch" style="width: @((int)SwatchVisual)px; height: @((int)SwatchVisual)px; border-radius: @((int)SwatchRoundness)px; @SwatchBorder( m, sel ) @SwatchBg( m ) transform: scale(@(sc.ToString( "0.##", CultureInfo.InvariantCulture )));"></div>
					</div>
				}
				@* Last child so it paints (and hit-tests) ABOVE the swatches. *@
				@if ( paletteGate == SectionState.Locked )
				{
					<div class="tutorial-lock-shield"></div>
				}
			</div>
		}

		@* Colour wheel + metal/rough sliders, floating to the RIGHT of the palette — same fade/tracking as the
		   palette. The wheel edits the selected brush's colour directly; a palette click re-seats it (the wheel
		   resyncs whenever the brush colour changes underneath it), and dragging it just deselects every swatch. *@
		@if ( ShowPicker && EditHudGate.Visible( HudSection.Picker ) )
		{
			var pickerGate = EditHudGate.Of( HudSection.Picker );
			var pickerShown = colourOn && pickerPos.HasValue;
			var pickerOpacity = (Session.IsManipulating ? EditTransparency : 1f)
				* (pickerGate == SectionState.Locked ? LockDim : 1f);
			var pfb = _fadeBrush;
			<div @ref="PickerPanel" class="picker-float @(pickerGate == SectionState.Highlight ? "tutorial-highlight" : "")" style="left: @((int)_pickerPos.x)px; top: @((int)_pickerPos.y)px; width: @((int)PickerSize)px; opacity: @(pickerOpacity.ToString( "0.###", CultureInfo.InvariantCulture )); pointer-events: @(pickerShown && pickerOpacity > 0.01f && !Inert ? "all" : "none"); transition: opacity @(FadeTime.ToString( "0.###", CultureInfo.InvariantCulture ))s ease;">
				<ClayColorPicker Size=@PickerSize Value=@(pfb?.Color ?? Color.White) OnInput=@((Color c) => SetColor( c )) OnCommit=@CommitEdit />
				<ClaySlider Label="Metal" Value=@(pfb?.Metallic ?? 0f) Min=@(0f) Max=@(1f)
					OnInput=@((float v) => SetMetallic( v )) OnCommit=@CommitEdit />
				<ClaySlider Label="Rough" Value=@(pfb?.Roughness ?? 1f) Min=@(0f) Max=@(1f)
					OnInput=@((float v) => SetRoughness( v )) OnCommit=@CommitEdit />
				<div class="mat-clipboard">
					<div class="chip action" @onclick=@CopyMaterial>
						<div class="icon">@SdfIcons.Copy</div><span>Copy</span>
					</div>
					<div class="chip action @(_materialClipboard.HasValue ? "" : "disabled")" @onclick=@PasteMaterial>
						<div class="icon">@SdfIcons.Paste</div><span>Paste</span>
					</div>
				</div>
				@* Last child so it paints (and hit-tests) above the wheel/sliders. *@
				@if ( pickerGate == SectionState.Locked )
				{
					<div class="tutorial-lock-shield"></div>
				}
			</div>
		}
		</div>

		@* Blend / roundness sliders, floating under the gizmo (replacing the old 3D slider handles). They track the
		   gizmo's screen position like the palette, fade out while a handle is manipulated, and fade in/out with the
		   selection the same way. *@
		var sliderPos = SliderPos();
		if ( sliderPos.HasValue )
			_sliderPos = sliderPos.Value;

		if ( ShowSliders && EditHudGate.Visible( HudSection.Sliders ) )
		{
			var sliderGate = EditHudGate.Of( HudSection.Sliders );
			var slidersShown = Brush is not null && sliderPos.HasValue;
			// No manipulation fade (unlike the palette/picker): the sliders sit BELOW the gizmo, so a drag
			// doesn't need them cleared out of the way — and the validity toast anchors off this stack's
			// slot, so keeping it solid keeps that anchor readable too.
			var sliderOpacity = sliderGate == SectionState.Locked ? LockDim : 1f; // shown / hidden is the items popping (PopFlex), not a fade
			var fb = _fadeBrush;
			@* The first additive brush's blend folds against empty space — a field no-op that would only
			   inflate the SculptBounds size padding — so its slider parks at 0, greyed (mirror symmetry
			   un-parks it: the blend then smooths the copies' seams; see Sdf.BlendInert). A multi-selection
			   un-greys it — the edit fans out to the whole group, and SetBlend skips the inert member. *@
			var blendLocked = fb is not null && !Session.IsMultiSelection
				&& Session.Target?.Brushes is { } blendList && Sdf.BlendInert( blendList, fb );
			var blendVal = blendLocked ? 0f : fb?.Blend ?? 0f;
			var gapVal = fb?.Gap ?? 0f;
			var roundVal = fb?.Rounding ?? GizmoSettingsRoundingMin;
			var roundMax = fb is not null ? fb.MaxRounding() : 1f;
			var isSpline = fb?.Shape == SdfShape.Spline;
			var isExtruded = fb?.Shape == SdfShape.Extruded;
			var isSphere = fb?.Shape == SdfShape.Sphere;
			var isCone = fb?.Shape == SdfShape.Cone;
			var isText = fb?.Shape == SdfShape.Text;
			var isGroup = fb?.Shape == SdfShape.Group; // add-only, no roundness: just Blend (+ material elsewhere)
			var isModifier = fb?.IsModifier == true; // Smooth: one amount slider, no op / round / material
			var xsVal = fb?.CrossSection ?? SdfCrossSection.Triangle;
			var curveVal = fb?.Curvature ?? 0f;
			var sliceVal = fb?.Slice ?? 0f;
			var canLoop = (fb?.Points?.Count ?? 0) >= 3;
			@* Every control is ALWAYS mounted, as a `pop` item that's `gone` when it doesn't apply: the shared PopFlex
			   (UI/PopFlex.cs, stepped from OnUpdate) pops each one in / out while its neighbours slide to make or close the
			   room — a Smooth layer's lone slider and a box's Add · Blend · Round morph into each other instead of
			   swapping in one frame. (Conditional markup can't animate out: razor parks a deleting panel at the row's
			   end.) `grow` items share the strip (flex-basis 0); the op chip is a fixed width. With nothing selected
			   every item is gone, so selecting pops the whole strip in. *@
			var stripOn = slidersShown;
			var placingSpline = isSpline && Session.Tool == SculptTool.Sculpt;
			var opNow = (isModifier ? _shapeBrush : fb)?.Operation ?? SdfOperation.Add; // a modifier has no op: the leaving chip keeps the last one
			<div @ref="SliderStackPanel" class="slider-stack @(sliderGate == SectionState.Highlight ? "tutorial-highlight" : "")" style="left: @((int)_sliderPos.x)px; bottom: @((int)StripBottom)px; width: @((int)SliderStripWidth)px; opacity: @(sliderOpacity.ToString( "0.###", CultureInfo.InvariantCulture )); pointer-events: @(slidersShown && !Inert ? "all" : "none");">
				@* Add/Carve/Cutout/Colour cycle for the active brush (ghost or selection) — same cycle the A key steps. *@
				<div class="pop @(stripOn && !isGroup && !isModifier ? "" : "gone")">
					<div class="chip op-chip @(opNow == SdfOperation.Subtract ? "carve" : opNow == SdfOperation.Cutout ? "cutout" : opNow == SdfOperation.Colour ? "colour" : "") @(StripFired( "a" ) ? "fired" : "")" @onclick=@ToggleActiveOperation>
						<div class="slider-key">A</div><span>@(opNow == SdfOperation.Subtract ? "Carve" : opNow == SdfOperation.Cutout ? "Cutout" : opNow == SdfOperation.Colour ? "Colour" : "Add")</span>
					</div>
				</div>
				@* A modifier's amount rides in Blend (SdfModifiers) — same S key + scrub, its own label. *@
				<div class="pop grow capped @(stripOn ? "" : "gone")">
					<ClaySlider Label=@(isModifier ? "Smooth" : "Blend") Key="S" Fired=@StripFired( "s" ) Value=@blendVal Min=@(0f) Max=@SdfBrush.MaxBlend Curve=@BlendCurve
						Disabled=@blendLocked OnInput=@((float v) => SetBlend( v )) OnCommit=@CommitEdit />
				</div>
				@* Per-shape sliders: spline gets curvature (rounding doesn't apply to the tube); everything
				   else keeps Round (on the sphere it rounds the sliced rim); the sliceable shapes (sphere,
				   cone) add Slice as a third slider. *@
				@* Spline while PLACING: just smoothness. Each point's size is set as you place it (R + move),
				   and the loop closes itself by snapping to the first point — so the uniform Size
				   slider and the Loop chip would both fight the flow. *@
				<div class="pop grow capped @(stripOn && placingSpline ? "" : "gone")">
					<ClaySlider Label="Smooth" Key="D" Fired=@StripFired( "d" ) Value=@curveVal Min=@(0f) Max=@(1f)
						OnInput=@((float v) => SetCurvature( v )) OnCommit=@CommitEdit />
				</div>
				@* Spline otherwise: Curve with the Loop chip riding beside it (close the ring; needs 3+ points).
				   No Size slider / per-point toggle: every point carries its own radius (set as it was
				   placed) and is resized by its 3D radius ring, so a uniform slider would flatten them. *@
				<div class="pop grow capped @(stripOn && isSpline && !placingSpline ? "" : "gone")">
					<div class="slider-row">
						<ClaySlider Label="Curve" Key="D" Fired=@StripFired( "d" ) Value=@curveVal Min=@(0f) Max=@(1f)
							OnInput=@((float v) => SetCurvature( v )) OnCommit=@CommitEdit />
						<div class="chip mini @(fb?.SplineClosed == true ? "on" : "") @(canLoop ? "" : "disabled")" @onclick=@(() => ToggleSplineClosed())>
							<div class="icon">loop</div>
						</div>
					</div>
				</div>
				<div class="pop grow capped @(stripOn && !isSpline && !isGroup && !isModifier ? "" : "gone")">
					<ClaySlider Label="Round" Key="D" Fired=@StripFired( "d" ) Value=@roundVal Min=@GizmoSettingsRoundingMin Max=@roundMax
						OnInput=@((float v) => SetRounding( v )) OnCommit=@CommitEdit />
				</div>
				<div class="pop grow capped @(stripOn && (isSphere || isCone) ? "" : "gone")">
					<ClaySlider Label="Slice" Key="F" Fired=@StripFired( "f" ) Value=@sliceVal Min=@(0f) Max=@SdfBrush.MaxSlice
						OnInput=@((float v) => SetSlice( v )) OnCommit=@CommitEdit />
				</div>
				@* Extruded "Shape" brush: pick the 2D profile it sweeps — a row of icon chips in the same
				   paper style, riding along under the sliders (same fade/tracking, it's inside the stack). *@
				<div class="pop grow @(stripOn && isExtruded ? "" : "gone")">
					<div class="xsection-row @(StripFired( "f" ) ? "fired" : "")"><div class="slider-key">F</div>
						@foreach ( var xs in CrossSections )
						{
							var cs = xs;
							<div class="chip mini @(xsVal == cs ? "on" : "")" @onclick=@(() => SetCrossSection( cs ))>
								<div class="icon">@SdfIcons.CrossSection( cs )</div>
							</div>
						}
					</div>
				</div>
				@* Cutout only: the slot's half-width — Blend then rounds the slot's lip instead of doubling
				   as its size. LAST in the strip so it reads in keyboard order: S blend · D round · F wildcard
				   · G gap. Keys bind to MEANING, not position — a shape with no wildcard just collapses that
				   slot (like a box already does for F), so G is as stable as S and D. *@
				<div class="pop grow capped @(stripOn && !isModifier && !isGroup && opNow == SdfOperation.Cutout ? "" : "gone")">
					<ClaySlider Label="Gap" Key="G" Fired=@StripFired( "g" ) Value=@gapVal Min=@(0f) Max=@SdfBrush.MaxGap Curve=@BlendCurve
						OnInput=@((float v) => SetGap( v )) OnCommit=@CommitEdit />
				</div>
				@* Text brush: edit the string in place, riding under the sliders like the profile chips. *@
				<div class="pop grow @(stripOn && isText ? "" : "gone")">
					<div class="text-row paper-card">
						<div class="icon">@SdfIcons.Shape( SdfShape.Text )</div>
						<TextEntry @ref="TextInput" class="text-input" Value:bind=@SelectedText onblur=@OnTextEntryBlur />
					</div>
				</div>
				@* Last child so it paints (and hit-tests) above the sliders/chips. *@
				@if ( sliderGate == SectionState.Locked )
				{
					<div class="tutorial-lock-shield"></div>
				}
			</div>
		}

		@* Shape row — docked above the sliders, because shape is a PROPERTY of the brush, not a tool:
		   with a stamp held it re-moulds the ghost, with a selection it converts the brush in place.
		   Its tiles are gone with no active brush — the Tools panel's "Add Shape" button (or Q / number keys) is the
		   entry point then — and on a Smooth layer (a modifier isn't a shape). The dock stays MOUNTED and its tiles
		   are PopFlex items (stepped from OnUpdate), so they pop up / down together instead of blinking; the dock is centred
		   by CSS (full width, justify centre), never from a measured width — a remount measured nothing on its first
		   frame and drew off-centre, then jumped. *@
		@if ( ShowTools && ((Session?.IsEditing ?? false) || Closing) && EditHudGate.Visible( HudSection.ShapeDock ) )
		{
			var dockOn = Brush is not null && !Brush.IsModifier;
			var tileBrush = _shapeBrush; // the last SHAPE brush, so the active tile holds while the row pops out
			var shapeDockPos = ShapeDockPos();
			if ( shapeDockPos.HasValue )
				_shapeDockPos = shapeDockPos.Value;

			@* No manipulation fade — the dock sits well below the gizmo, and the validity toast anchors
			   above this row, so both stay solid through a handle drag. *@
			<div @ref="ShapeDockPanel" class="shape-dock @EditHudGate.PanelClass( HudSection.ShapeDock )" style="bottom: @((int)DockBottom)px;">
				<div class="shape-grid">
					@foreach ( var entry in VisibleShapes )
					{
						var shape = entry.Shape;
						var active = tileBrush?.Shape == shape;
						<div class="pop @(dockOn ? "" : "gone")">
							<div class="paper-card shape-tile @(active ? "active" : "")" @onclick=@(() => GateClick( HudSection.ShapeDock, () => ShapeClicked( shape ) ))>
								@* The shape's number key in front of its picture, the name underneath. *@
								<div class="tile-top">
									@if ( ShapeKey( shape ) is { } key )
									{
										<div class="slider-key">@key</div>
									}
									<div class="shape-img" style="background-image: url( @SdfIcons.ShapeImage( shape ) )"></div>
								</div>
								<span class="label">@entry.Label</span>
							</div>
						</div>
					}
					@* Group tiles (prefab-backed multi-brush shapes — a mouth) follow the primitives. Head sessions
					   only for the head-only kinds; see SculptEditSession.GroupKinds / HotkeyGroup for the verb. *@
					@if ( !EditHudGate.BasicShapesOnly )
					{
						var firstGroup = true; // only the first group kind has a key (8 — SculptEditSession's Slot8)
						foreach ( var kind in Session.GroupKinds )
						{
							var k = kind;
							var groupKey = firstGroup ? InputGlyphs.KeyFor( "Slot8", "8" ) : null;
							firstGroup = false;
							var groupActive = tileBrush?.Shape == SdfShape.Group && string.Equals( tileBrush.GroupKind, k.Id, StringComparison.OrdinalIgnoreCase );
							<div class="pop @(dockOn ? "" : "gone")">
								<div class="paper-card shape-tile @(groupActive ? "active" : "")" @onclick=@(() => GateClick( HudSection.ShapeDock, () => Session.HotkeyGroup( k.Id ) ))>
									<div class="tile-top">
										@if ( groupKey is not null )
										{
											<div class="slider-key">@groupKey</div>
										}
										<div class="shape-img" style="background-image: url( @SdfIcons.GroupImage( k.Id ) )"></div>
									</div>
									<span class="label">@k.Label</span>
								</div>
							</div>
						}
					}
				</div>
				@* (No Add/Carve chips — the A key toggles the op, and the 3D preview + red carve wireframe
				   already make the mode obvious.) *@
				@* Last child so it paints (and hit-tests) above the tiles. *@
				@if ( EditHudGate.Of( HudSection.ShapeDock ) == SectionState.Locked )
				{
					<div class="tutorial-lock-shield"></div>
				}
			</div>
		}
	}

	@* Bounding-sphere silhouette of the selected shape (Bounds toggle in Tools). A flat circle is the sphere's
	   exact on-screen silhouette; it sits at the same anchor the palette/sliders use. *@
	@{
		// Call unconditionally so the out vars are always assigned (a && short-circuit would leave them unset).
		bool hasBounds = BrushScreenSphere( out var boundsC, out var boundsR );
		bool boundsShown = ShowBounds && hasBounds;
	}
	@if ( boundsShown )
	{
		<div class="bounds-circle" style="left: @((int)(boundsC.x - boundsR))px; top: @((int)(boundsC.y - boundsR))px; width: @((int)(boundsR * 2f))px; height: @((int)(boundsR * 2f))px;"></div>
	}

	@* Spline add-point cursor. Mouse.CursorType doesn't reliably paint the WORLD cursor here (the engine only
	   shows it when the mouse is in UI state, and the orbit "cursor" is actually a drawn div) — but the UI DOES
	   paint a hovered panel's CSS `cursor`. So while hovering a spline line we put up a full-screen pointer-events
	   zone whose `cursor` the UI shows over the scene. It's only present while hovering, and the gizmo's hover/
	   click are ray + raw-input (not UI events), so this doesn't block selecting the line or inserting a point. *@
	@* Mounted while hovering the line AND for the whole insert-and-place drag that follows — the mousedown's
	   gesture is UI-swallowed, so this panel's mouseup is the only visible release to end the drag with. *@
	@if ( ( Session?.HoveringSplineLine ?? false ) || ( Session?.SplinePointUiDragging ?? false ) )
	{
		@* LEFT button only — onmousedown fires for every button, and right-click means delete-a-point, not add.
		   While the insert-and-place drag runs the point is GRABBED, so the zone swaps to the closed hand. *@
		<div class="add-point-cursor @(Session?.SplinePointUiDragging == true ? "dragging" : "")"
			@onmousedown=@(( PanelEvent e ) => { if ( e is MousePanelEvent m && m.MouseButton == MouseButtons.Left ) Session?.InsertHoveredSplinePoint(); })
			@onmouseup=@(() => Session?.EndSplinePointUiDrag())></div>
	}

	@* (The world grab cursor — point hand over grabbables, closed hand while grabbed — is painted via the
	   Mouse.CursorType fallback in OnUpdate, NOT a cursor zone like the add-point panel above. A hovered
	   pointer-events surface routes the mouse buttons to the UI, swallowing Attack1 — which killed world
	   selection and every gizmo grab when this was first tried as a full-screen zone. See WorldCursorName. *@

	@* Drawn dot cursor at the frozen drag anchor (the real cursor is hidden by the mouse-capture during an
	   alt-nav drag or a hold param scrub). *@
	@if ( !EditPointer.Locked && (((AltNav.Dragging || (Session?.IsScrubbing ?? false)) && Session is not null && Session.IsEditing) || _captureHandover) )
	{
		<div class="alt-cursor" style=@AltCursorStyle()></div>
	}

</root>

@code
{
	// The session the HUD draws. While edit mode is OPEN that's SculptEditSession.Current; for CloseLinger seconds after
	// it closes it's the session that just closed (the object outlives the exit — only Current is cleared), so the HUD
	// stays drawn while everything leaves: the side columns slide out to their edges, and with no brush (Brush) and an
	// empty hotkey source every bottom row pops out on its PopFlex springs. Inert throughout, so nothing takes the
	// mouse. Static like before (GateClick and friends read it); the linger fields reset in OnAwake / OnDestroy.
	static SculptEditSession Session => SculptEditSession.Current ?? (Closing ? _lingerSession : null);

	static SculptEditSession _lingerSession;
	static float _lingerUntil;
	static bool _wasOpen;
	const float CloseLinger = 0.6f;

	/// <summary>Edit mode just closed and the HUD is still animating out. _wasOpen covers the gap before TrackOpenClose
	/// sees the close: the panel can BUILD in that frame before our update runs, and without it Session read null for one
	/// frame: the whole HUD was deleted, then rebuilt from scratch the next frame (the exit flicker).</summary>
	static bool Closing => SculptEditSession.Current is null && _lingerSession.IsValid() && (_wasOpen || RealTime.Now < _lingerUntil);

	// Per frame, first thing: notice the open → closed edge and start the linger.
	static void TrackOpenClose()
	{
		var cur = SculptEditSession.Current;
		if ( cur.IsValid() && cur.IsEditing )
		{
			_lingerSession = cur;
			_lingerUntil = 0f;
			_wasOpen = true;
		}
		else if ( _wasOpen )
		{
			_wasOpen = false;
			_lingerUntil = RealTime.Now + CloseLinger;
		}
	}

	/// <summary>The one live EditHud. The system scene (merged into every map with WantsSystemScene) places one,
	/// and some map scenes ALSO placed their own — two identical HUDs then stacked exactly on top of each other,
	/// double-handling hover/click state and drawing every panel twice. Same guard as RoundHud / PauseMenu: first
	/// instance wins, later copies destroy themselves in OnAwake.</summary>
	public static EditHud Current { get; private set; }

	protected override void OnAwake()
	{
		base.OnAwake();

		if ( Current.IsValid() && Current != this )
		{
			Log.Warning( $"EditHud: a second instance appeared on '{GameObject.Name}' — destroying it. " +
				"A scene is placing its own EditHud alongside the system scene's; remove the scene's copy." );
			DestroySurplus();
			return;
		}

		Current = this;
		ResetLinger(); // statics outlive Stop → Play
	}

	static void ResetLinger()
	{
		_lingerSession = null;
		_lingerUntil = 0f;
		_wasOpen = false;
	}

	// Take the host object with us when it exists only to carry this HUD (a ScreenPanel and us, nothing else) —
	// otherwise a dead root panel would be left behind.
	void DestroySurplus()
	{
		var hostIsOurs = !GameObject.Children.Any()
			&& GameObject.Components.GetAll( FindMode.EverythingInSelf ).All( c => c == this || c is ScreenPanel );

		if ( hostIsOurs )
			GameObject.Destroy();
		else
			Destroy();
	}

	protected override void OnDestroy()
	{
		base.OnDestroy();
		_listFx.Clear(); // the shape list's cached fade textures

		if ( Current == this )
		{
			Current = null;
			ResetLinger();
		}
	}

	// The brush the panels edit: the SELECTED brush in edit mode, the STAMP GHOST in add mode (palette /
	// sliders / symmetry pre-style the next stamp). Identical to SelectedBrush when the edit tool is up.
	SdfBrush Brush => Closing ? null : Session?.ActiveBrush; // closing: no brush, so every brush-driven control pops out

	// The side columns slide out whole, so while closing they keep showing what they showed on the last open frame —
	// clearing them (no brush → Duplicate / Delete / Symmetry gone; the owner nulling the workshop actions on exit)
	// emptied them the instant edit mode closed, before the slide had moved them.
	SdfBrush _closeBrush;
	bool _closeWorkshop;
	SdfBrush ToolsBrush => Closing ? _closeBrush : Brush;
	bool WorkshopShown => WorkshopSave is not null || (Closing && _closeWorkshop);

	// The Symmetry chips' brush: the live one, else the last one shown — so the section keeps its X/Y/Z state while it
	// slides out after a deselect instead of flipping every axis off first.
	SdfBrush _lastSymBrush;
	SdfBrush SymBrush => ToolsBrush ?? _lastSymBrush;

	void LatchSideContents()
	{
		if ( ToolsBrush is { } tb )
			_lastSymBrush = tb;
		if ( SculptEditSession.Current is not { IsEditing: true } cur )
			return;
		_closeBrush = cur.ActiveBrush;
		_closeWorkshop = WorkshopSave is not null;
	}

	// The shape row's shapes — all of them; a spline is placed as a CHAIN of points rather than one stamp,
	// but it's picked from the same row. The tutorial's first shape lesson trims to the primitives
	// (the extruded profile, spline and text deserve their own lessons, not a first-contact wall of tiles).
	IEnumerable<(SdfShape Shape, string Label)> VisibleShapes => EditHudGate.BasicShapesOnly
		? AddShapes.Where( e => e.Shape is not (SdfShape.Extruded or SdfShape.Spline or SdfShape.Text) )
		: AddShapes;

	// Shape-row click — shape is a brush PROPERTY, so the verb depends on the current subject:
	// stamp held → re-mould the ghost; brush selected → convert it in place; nothing → pick up a new stamp.
	void ShapeClicked( SdfShape shape )
	{
		if ( Session is null )
			return;

		if ( Session.Tool == SculptTool.Sculpt )
		{
			Session.SetShape( shape );
			return;
		}

		// A tile always converts the selection in place — splines included (to one = a 2-point tube filling
		// the same box; from one = the solid takes the curve's bounds).
		if ( Session.SelectedBrush is not null )
		{
			Session.ConvertSelectedShape( shape );
			return;
		}

		Session.SetTool( SculptTool.Sculpt );
		Session.SetShape( shape );
	}

	// The strip's Add/Carve/Cutout/Colour chip: cycle the active brush's operation — the stamp's in sculpt mode,
	// the selected brush's in gizmo mode (identical to the A key).
	void ToggleActiveOperation()
	{
		if ( Session is null )
			return;

		if ( Session.Tool == SculptTool.Sculpt )
			Session.SetStampOperation( SculptEditSession.NextOperation( Session.StampOperation ) );
		else if ( Session.Selected >= 0 )
			Session.ToggleOperation( Session.Selected );
	}

	// Hint-strip labels for the shape-dependent scrubs: D = the second slider, F = the wildcard third.
	// A spline being PLACED has neither a Round nor a Size slot — just smoothness on the wildcard.
	bool PlacingSpline => Session?.Tool == SculptTool.Sculpt && Brush?.Shape == SdfShape.Spline;

	// ── Hotkey bar ───────────────────────────────────────────────────────────────────────────────────────────────────
	// The shared HotkeyBar, fed per mode. Triggers: input actions where the session reads one (LMB/RMB, Q, Tab, Alt,
	// the 1-7 slots); RAW keys for the scrubs the session reads as Keyboard.Down (W/E/R/A/S/D/F/G, Shift, Space, Del).
	// Scroll, Ctrl+LMB and Esc never punch (no clean press to read, or the press leaves the mode). Glyphs are the cards'
	// identities, so each must be unique within one mode's set.
	HotkeyBar HintBar; // found + stepped from OnUpdate (HotkeyBar.StepIn); BarClearance measures it

	/// <summary>How far up from the screen's bottom edge the hotkey bar reaches (style px): its MEASURED top, so the
	/// bottom-centre docks (sliders, part dock, shape dock, validity toast) sit above it however many rows it wraps to.
	/// One compact row at $panel-inset before the first layout.</summary>
	// Measured only while the bar is SETTLED (no card mid-pop) and held otherwise: the rows stacked on it (slider strip,
	// shape dock, part dock, toast) must never move during a transition — a card swelling in near the width limit
	// briefly wrapped the bar onto two lines, which lifted every row above it for a few frames.
	float _barClearance;
	float BarClearance
	{
		get
		{
			if ( HintBar is { IsValid: true } bar && bar.Box.Rect.Height > 0f && (bar.Settled || _barClearance <= 0f) )
				_barClearance = MathF.Max( 0f, (Screen.Height - bar.Box.Rect.Top) * bar.ScaleFromScreen );
			return _barClearance > 0f ? _barClearance : 74f; // 74: one compact row (≈50 with its slots) at $panel-inset
		}
	}
	Func<IEnumerable<HotkeyHint>> _hintSource;
	Func<IEnumerable<HotkeyHint>> EditHotkeySource => _hintSource ??= () => EditHotkeys;

	static string[] Act( string action ) => HotkeyActs.Act( action );

	// Clickable bar (a free cursor): the one-shot cards' actions — the same verbs their keys reach. Cached: the hint
	// list is rebuilt every frame. Q goes through RequestExit (the confirm-aware exit every player-driven path uses;
	// the pawns reconcile after any exit — see HunterController's weapon-edit teardown).
	Action _clickWireframe, _clickDone, _clickStopPlacing, _clickDelete;
	Action ClickWireframe => _clickWireframe ??= () => Session?.ToggleWireframes();
	Action ClickDone => _clickDone ??= () => Session?.RequestExit();
	Action ClickStopPlacing => _clickStopPlacing ??= () => Session?.SetTool( SculptTool.Gizmo );
	Action ClickDelete => _clickDelete ??= () => Session?.RemoveSelected();

	/// <summary>The bar's cards take the mouse wherever there's a free cursor to click with — every orbit-camera
	/// session, and a first-person one while alt frees the cursor.</summary>
	static bool BarClickable => !EditPointer.Locked || EditPointer.CursorFree;

	// Over (or holding) a hotkey-bar card. The cards don't take the pointer — the press must reach the game so the
	// held card can run off the real button + mouse (see HotkeyBar.StepCards) — so the bar hit-tests them itself.
	bool OverBarCard() => BarClickable && HintBar is { IsValid: true } bar && bar.PointerOverCard;

	// The LMB verb while placing a stamp.
	string StampVerb => Session.StampOperation switch
	{
		SdfOperation.Subtract => "Carve",
		SdfOperation.Cutout => "Cutout",
		SdfOperation.Colour => "Paint",
		_ => "Stamp",
	};

	// (The shape-tweak scrubs — A op · S blend · D round · F wildcard · G gap — and the 1–8 shape keys aren't bar cards
	// while their controls are up: each shows its key-cap
	// on the slider-strip control it drives, which is up whenever they apply.)

	// The number key that picks a shape (SculptEditSession's Slot1..7 hotkeys) — bound to the SHAPE, not its position
	// in the dock, so a dock showing fewer shapes still labels each right. Null = no key.
	static string ShapeKey( SdfShape shape ) => shape switch
	{
		SdfShape.Sphere => InputGlyphs.KeyFor( "Slot1", "1" ),
		SdfShape.Box => InputGlyphs.KeyFor( "Slot2", "2" ),
		SdfShape.Cylinder => InputGlyphs.KeyFor( "Slot3", "3" ),
		SdfShape.Cone => InputGlyphs.KeyFor( "Slot4", "4" ),
		SdfShape.Extruded => InputGlyphs.KeyFor( "Slot5", "5" ),
		SdfShape.Spline => InputGlyphs.KeyFor( "Slot6", "6" ),
		SdfShape.Text => InputGlyphs.KeyFor( "Slot7", "7" ),
		_ => null,
	};

	// The strip's press punch + click — the hotkey cards' feedback, on the control the key drives. Raw key EDGES (the
	// session reads these scrubs as Keyboard.Down; Pressed isn't reliable there), stepped from OnUpdate. Each key only
	// counts while its control is in the strip, and never while a text box has focus (the Text shape's entry).
	const float StripPunchSeconds = 0.4f;
	// Lazy: a hotload doesn't run a NEW static's initializer on an existing type (it was null → an NRE every frame).
	// The slider strip's scrub keys + the tools column's Space (Add Shape / Done) and Del (Delete). (Renamed when the
	// list grew: a hotload keeps a live static's cached value, so the old name would have kept the old list.)
	static string[] _punchKeys;
	static string[] StripKeys => _punchKeys ??= new[] { "a", "s", "d", "f", "g", "space", "delete" };
	Dictionary<string, RealTimeSince> _stripFired; // lazy — initializers never run on a hotloaded live instance
	HashSet<string> _stripDown;
	int _stripFiredSignal;

	bool StripShows( string key )
	{
		var s = Session;
		// The tools column: Add Shape (Done while placing) is always up; Delete only for a selection in the gizmo.
		if ( key == "space" )
			return s is not null && EditHudGate.Visible( HudSection.AddChip );
		if ( key == "delete" )
			return s is not null && s.Tool == SculptTool.Gizmo && Brush is not null && EditHudGate.Visible( HudSection.EditChips );

		var b = Brush;
		if ( b is null )
			return false;
		bool group = b.Shape == SdfShape.Group;
		return key switch
		{
			"a" or "d" => !group && !b.IsModifier,
			"s" => true,
			"f" => b.Shape is SdfShape.Sphere or SdfShape.Cone or SdfShape.Extruded,
			"g" => b.Operation == SdfOperation.Cutout,
			_ => false,
		};
	}

	void UpdateStripPunches()
	{
		_stripFired ??= new();
		_stripDown ??= new();

		bool live = (Session?.IsEditing ?? false) && Sandbox.UI.InputFocus.Current is null
			&& !PauseMenu.IsOpen && !TutorialDirector.HintStripHidden;
		var any = false;
		foreach ( var key in StripKeys )
		{
			bool down = Input.Keyboard.Down( key );
			bool edge = down && !_stripDown.Contains( key );
			if ( down ) _stripDown.Add( key ); else _stripDown.Remove( key );

			if ( edge && live && StripShows( key ) )
			{
				_stripFired[key] = 0f;
				any = true;
			}
		}
		if ( any )
			UiSounds.PlayHotkeyPress();

		var signal = 0;
		foreach ( var (key, since) in _stripFired )
			if ( since < StripPunchSeconds )
				signal = HashCode.Combine( signal, key );
		_stripFiredSignal = signal;
	}

	bool StripFired( string key )
		=> _stripFired is not null && _stripFired.TryGetValue( key, out var since ) && since < StripPunchSeconds;

	IEnumerable<HotkeyHint> EditHotkeys
	{
		get
		{
			var s = Session;
			if ( s is null || !s.IsEditing )
				yield break;

			if ( s.BodyKeys )
			{
				// First-person (in-place) sculpting: the crosshair is the pointer and the body keeps walking, so the
				// WASD-row scrubs are gone — R/E and the LMB grab are the whole transform scheme, and the HUD is
				// reached by holding alt for the cursor.
				if ( s.Tool == SculptTool.Sculpt )
				{
					yield return new( "LMB", s.ActiveShape == SdfShape.Spline ? (s.ChainWillLoop ? "Close Loop" : "Add Point") : StampVerb, Act( "Attack1" ) );
					yield return s.ActiveShape == SdfShape.Spline
						? new( "RMB", "Finish", Act( "Attack2" ), Hold: "space" )
						: new( "RMB", "Done", Act( "Attack2" ), Click: ClickStopPlacing );
				}
				else
				{
					yield return new( "LMB", s.SelectedBrush is not null ? "Select / Grab / Gizmo" : "Select", Act( "Attack1" ) );
					yield return new( "LMB Away", "Done" );
					yield return new( "Ctrl+LMB", "Multi-select" );
					if ( s.SelectedBrush is not null )
					{
						yield return new( "RMB", "Deselect", Act( "Attack2" ) );
						yield return new( "Del", "Delete", RawKey: "delete", Click: ClickDelete );
					}
				}
				if ( s.ActiveBrush is not null && !s.ActiveBrush.IsModifier )
				{
					yield return new( "Scroll", "Depth", Wheel: true );
					yield return new( "R", "Scale", RawKey: "r", Hold: "r" );
					yield return new( "E", "Rotate", RawKey: "e", Hold: "e" );
					yield return new( "Shift", "Snap (Standing)", RawKey: "shift", Hold: "shift" );
				}
				if ( s.SelectedBrush is not { IsModifier: true } ) // a Smooth layer doesn't convert to a shape
					yield return new( "1-7", s.Tool == SculptTool.Sculpt || s.SelectedBrush is not null ? "Shape" : "Add Shape", HotkeyActs.Slots1To7 );
				yield return new( "Alt", "Cursor + All Keys", Act( "Walk" ) );
				yield return new( "Tab", "Wireframe", Act( "ToggleWireframes" ), Click: ClickWireframe );
				yield return new( "Q", "Done", Act( "Edit" ), Click: ClickDone );
				yield break;
			}

			if ( s.Tool == SculptTool.Sculpt && s.ActiveShape == SdfShape.Spline )
			{
				// Chain placement has its own verbs: click points along the curve, right-click / Space ends it.
				yield return new( "LMB", s.ChainWillLoop ? "Close Loop" : "Add Point", Act( "Attack1" ) );
				yield return new( "RMB", "Finish (or Space)", Act( "Attack2" ), RawKey: "space", Hold: "space" );
				yield return new( "Scroll", "Depth", Wheel: true );
				yield return new( "R", "Point Size", RawKey: "r", Hold: "r" );
				yield return new( "Shift", "Snap", RawKey: "shift", Hold: "shift" );
				yield return new( "Tab", "Wireframe", Act( "ToggleWireframes" ), Click: ClickWireframe );
				yield return new( "Esc", "Cancel", Click: ClickStopPlacing );
				yield break;
			}

			if ( s.Tool == SculptTool.Sculpt )
			{
				// Placing a stamp.
				yield return new( "LMB", StampVerb, Act( "Attack1" ) );
				yield return new( "Scroll", "Depth", Wheel: true );
				yield return new( "RMB", "Done", Act( "Attack2" ), Click: ClickStopPlacing );
				yield return new( "R", "Scale", RawKey: "r", Hold: "r" );
				yield return new( "E", "Rotate", RawKey: "e", Hold: "e" );
				yield return new( "Shift", "Snap", RawKey: "shift", Hold: "shift" );
				yield return new( "Tab", "Wireframe", Act( "ToggleWireframes" ), Click: ClickWireframe );
				yield return new( "Esc", "Cancel", Click: ClickStopPlacing );
				yield break;
			}

			// The gizmo: selecting and editing shapes.
			if ( s.SplineWillLoop )
				yield return new( "Release", "Close Loop", Hot: true );
			// LMB says what it does HERE: a click on a shape selects it; anywhere else the button is the camera (a drag
			// orbits from anywhere — see AltNav — but over a shape the click is the reason you'd press it).
			yield return new( "LMB", s.HoveringShape ? "Select" : "Orbit", Act( "Attack1" ), Nav: AltNav.Gesture.Orbit );
			// The other two camera drags (AltNav: MMB pan, RMB zoom). RMB says Zoom even with a selection — a right TAP
			// deselects, but the drag is what the card teaches.
			yield return new( "MMB", "Pan", Act( "CameraPan" ), Nav: AltNav.Gesture.Pan );
			yield return new( "RMB", "Zoom", Act( "Attack2" ), Nav: AltNav.Gesture.Dolly );
			if ( s.SelectedBrush is not null && !s.SelectedBrush.IsModifier ) // a Smooth layer has no transform: no depth/move/scale/rotate
			{
				// (No Ctrl+LMB multi-select or Shift snap cards — trimmed: the modifiers are learnt, not read off a bar.)
				yield return new( "Scroll", "Depth", Wheel: true );
				yield return new( "W", "Move", RawKey: "w", Hold: "w" );
				yield return new( "R", "Scale", RawKey: "r", Hold: "r" );
				yield return new( "E", "Rotate", RawKey: "e", Hold: "e" );
			}
			yield return new( "Tab", "Wireframe", Act( "ToggleWireframes" ), Click: ClickWireframe );
			yield return new( "Q", "Done", Act( "Edit" ), Click: ClickDone );
		}
	}

