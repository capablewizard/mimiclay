	// ── Pop-in / pop-out motion (UI/PopFlex.cs) ─────────────────────────────────────────────────────────────────────
	// One motion language for everything that comes and goes with the selection: buttons POP (a bouncy scale) while
	// their row slides to make or close the room — the slider strip and the hotkey bar (stepped by HotkeyBar
	// itself); the shape dock's tiles pop UP together (they all come and go at once) — and the colour column, docked to the right edge, SLIDES in from it on the same kind of spring.
	// Lazily created: initializers never run on a hotloaded live instance.
	PopFlex _stripPops, _dockPops, _partPops;
	UiSpring _colourSlide;
	const float PopPad = 5f; // each item's side padding: the old 10px row gap, split either side
	const float DockRise = 60f; // the shape tiles pop UP from this far below (together — no cascade, they take no room)
	const float PartRise = 30f; // the Head / Weapon chips: the same rise, scaled to their smaller size

	void StepPops()
	{
		(_stripPops ??= new()).Step( SliderStackPanel, PopPad );
		var grid = ShapeDockPanel is { IsValid: true } dock && dock.ChildrenCount > 0 ? dock.GetChild( 0 ) : null;
		(_dockPops ??= new()).Step( grid, PopPad, rise: DockRise );
		(_partPops ??= new()).Step( PartDockPanel, PopPad, rise: PartRise );
		StepColourSlide();
		StepSideSlide();
		StepToolGroups();
	}

	// The side columns — the layer stack (left) and the Tools / Workshop columns (right). Opening: the right columns
	// slide in from the screen edge on the colour column's spring, and the layer stack's rows stagger in from the left
	// one after another (StepLayerStagger) rather than as one block. Closing: every column slides out whole on a
	// timed ease-in-back — a small wind-up toward the screen, then away. The old exit was the open spring run
	// backwards with its undershoot clamped off: 1 → 0 in under 0.2s, which read as a flick, not a slide.
	// 1 = home. While opening, the root carries .sides-opening so anything mounting that frame starts parked off its
	// edge (:intro) instead of flashing at home for a frame before the first offset lands.
	UiSpring _sideSlide;
	bool _sidesOn;
	float _outFrom, _outT = -1f; // the exit tween: where it started, seconds in (-1 = not running)
	const float SideOutTime = 0.3f;
	const float SideOutBack = 1.3f; // ease-in-back wind-up (~8% of the run toward the screen before leaving)

	bool SidesOpening => (Session?.IsEditing ?? false) && (_sideSlide.Value < 0.5f || _staggerT >= 0f && _staggerT < 0.05f);

	// Frame time for HUD tweens: clamped, so a hitch (leaving edit mode commits + saves the sculpt) slows the motion
	// down rather than skipping it.
	static float TweenDelta => MathF.Min( RealTime.Delta, 1f / 30f );

	void StepSideSlide()
	{
		bool on = Session?.IsEditing ?? false;
		bool opened = on && !_sidesOn;
		if ( !on && _sidesOn )
		{
			_outFrom = _sideSlide.Value;
			_outT = 0f;
		}
		_sidesOn = on;

		if ( on )
		{
			_outT = -1f;
			_sideSlide.Step( 1f, TweenDelta, 2.4f, 0.62f );
		}
		else if ( _outT >= 0f )
		{
			_outT += TweenDelta;
			var t = MathF.Min( _outT / SideOutTime, 1f );
			var c = SideOutBack;
			var e = (c + 1f) * t * t * t - c * t * t; // ease-in-back
			_sideSlide.Value = _outFrom * (1f - e);
			_sideSlide.Velocity = 0f;
			if ( t >= 1f )
				_outT = -1f;
			else if ( Closing )
				_lingerUntil = MathF.Max( _lingerUntil, RealTime.Now + 0.1f ); // a hitch never cuts the slide short
		}
		if ( _sideSlide.Value < 0f && on ) { _sideSlide.Value = 0f; _sideSlide.Velocity = 0f; }
		bool home = on && _sideSlide.SettledAt( 1f );
		float away = 1f - _sideSlide.Value;

		float sc = Panel?.ScaleFromScreen ?? 1f;
		if ( PopFlex.TraceFrames > 0 )
			Log.Info( $"[pop] sides v={_sideSlide.Value:0.00} closing={Closing} stagger={_staggerT:0.00} L[{SideDebug( LeftPanel )}] R[{SideDebug( RightPanel )}] W[{SideDebug( WorkshopPanel )}]" );

		// The layer stack never slides in as a block — its rows stagger in — so it's home whenever edit mode is on.
		SlideColumn( LeftPanel, on, p => -(p.Box.Rect.Right * sc + 40f) * away );
		SlideColumn( RightPanel, home, p => (Screen.Width - p.Box.Rect.Left) * sc * away + 40f * away );
		SlideColumn( WorkshopPanel, home, p => (Screen.Width - p.Box.Rect.Left) * sc * away + 40f * away );
		StepLayerStagger( on, opened, sc );
	}

	// The layer stack's open: the "Shapes" title then each row slides in from the left edge, StaggerStep apart, each
	// on an ease-out-back over StaggerTime (a small overshoot, like the pops). Driven through Style.Left (a relative
	// offset that moves the row without touching layout): the rows' transform belongs to the drag shuffle
	// (LayerStyle). Rows past StaggerCap share the last delay — a long stack mustn't take ages to arrive.
	float _staggerT = -1f;
	const float StaggerStep = 0.028f, StaggerTime = 0.3f, StaggerBack = 1.2f;
	const int StaggerCap = 12;
	List<Panel> _staggerItems;

	void StepLayerStagger( bool on, bool opened, float sc )
	{
		if ( opened )
			_staggerT = 0f;
		if ( _staggerT < 0f )
			return;

		(_staggerItems ??= new()).Clear();
		if ( LeftPanel is { IsValid: true } left )
		{
			foreach ( var child in left.Children )
				if ( child.HasClass( "section-title" ) )
					_staggerItems.Add( child );
			if ( LayersPanel is { IsValid: true } list )
				foreach ( var row in list.Children )
					if ( row.HasClass( "layer" ) && !row.IsDeleting )
						_staggerItems.Add( row );
		}

		// Not mounted yet (the first frame of a mount): hold the clock — :intro keeps them parked meanwhile.
		if ( _staggerItems.Count == 0 && on )
			return;

		_staggerT += TweenDelta;
		var dist = (LeftPanel?.Box.Rect.Right ?? 400f) * sc + 40f;
		var done = true;
		for ( int i = 0; i < _staggerItems.Count; i++ )
		{
			var item = _staggerItems[i];
			var t = on ? (_staggerT - MathF.Min( i, StaggerCap ) * StaggerStep) / StaggerTime : 1f;
			if ( t >= 1f )
			{
				item.Style.Left = null;
				item.Style.Position = null;
			}
			else
			{
				done = false;
				t = MathF.Max( t, 0f ) - 1f;
				var c = StaggerBack;
				var e = 1f + (c + 1f) * t * t * t + c * t * t; // ease-out-back
				item.Style.Position = PositionMode.Relative; // rows are static, and a static box ignores left
				item.Style.Left = Length.Pixels( -dist * (1f - e) );
			}
			item.Style.Dirty();
		}
		if ( PopFlex.TraceFrames > 0 && _staggerItems.Count > 0 )
			Log.Info( $"[pop] stagger t={_staggerT:0.00} n={_staggerItems.Count} first={_staggerItems[0].Box.Rect.Left:0} row1={(_staggerItems.Count > 1 ? _staggerItems[1].Box.Rect.Left : 0):0} row12={(_staggerItems.Count > 12 ? _staggerItems[12].Box.Rect.Left : 0):0}" );
		if ( done )
			_staggerT = -1f;
	}

	static string SideDebug( Panel p ) => p is { IsValid: true }
		? $"x={p.Box.Rect.Left:0} kids={p.Descendants.Count()} tf={p.ComputedStyle?.Transform is not null}"
		: "none";

	static void SlideColumn( Panel column, bool home, Func<Panel, float> offset )
	{
		if ( column is not { IsValid: true } || column.IsDeleting )
			return;
		if ( home )
		{
			column.Style.Transform = null;
		}
		else
		{
			var t = new PanelTransform();
			t.AddTranslateX( Length.Pixels( offset( column ) ) );
			column.Style.Transform = t;
		}
		column.Style.Dirty();
	}

	// The colour column's slide: 1 = home, 0 = parked just off the right edge. Same spring family as the pops, a touch
	// less bouncy (a whole column overshooting the screen edge reads as a wobble, not a pop).
	void StepColourSlide()
	{
		if ( ColourSlidePanel is not { IsValid: true } layer )
			return;

		bool on = Brush is not null && !Brush.IsModifier && (Session?.IsEditing ?? false);
		_colourSlide.Step( on ? 1f : 0f, RealTime.Delta, 2.4f, 0.62f );

		// Far enough that the widest piece (the wheel column / palette) and its shadow are fully off-screen.
		float off = MathF.Max( PickerSize, PaletteOn ? PaletteWidth : 0f ) + 24f + 40f;
		float x = (1f - _colourSlide.Value) * off;
		if ( _colourSlide.SettledAt( 1f ) && on )
		{
			layer.Style.Transform = null;
		}
		else
		{
			var t = new PanelTransform();
			t.AddTranslateX( Length.Pixels( x ) );
			layer.Style.Transform = t;
		}
		layer.Style.Dirty();
	}
