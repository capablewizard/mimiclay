@using System
@using System.Collections.Generic
@using System.Globalization
@using Sandbox
@using Sandbox.UI
@namespace Mimiclay
@inherits PanelComponent

@*
	Hunter crosshair — the dot cursor, parked dead centre. Lives on the hunter prefab's HUD child so it exists
	exactly when a hunter pawn does (rounds AND debug scenes); drawn only for the OWNING hunter in first-person
	play. Proxies draw nothing, and face-edit mode draws nothing either — the orbit camera frees the real cursor
	there, so a crosshair would just be a second dot.

	Also hosts the interaction prompts (see Interactions): when the dot is over something offering interactions,
	the prop's COLLISION GEOMETRY (SdfCollider.FramePoints) is projected into the screen rect it occupies, and a
	row of wobbling paper toasts — one per option, "E Edit", "F Turn off" — hangs under that rect's bottom edge,
	centred. Carve-aware and pose-blind by construction — see ResolvePrompt. Projection itself is the
	PlayerNameplates recipe. Debug the anchoring live with mimiclay_toast_debug 1. Two levels, deliberately: the
	float carries the position (and the centring translate), each card carries its clay jitter — they'd fight
	over `transform` on one element.
*@

<root class="hunter-crosshair">
	@if ( Visible )
	{
		<div class="dot" />

		@if ( _promptAt is { } at && _cards.Count > 0 )
		{
			<div class="possess-float" style=@PromptStyle( at ) @ref=FloatPanel>
				@foreach ( var card in _cards )
				{
					@* Two layers, because two things drive `transform`: the slot takes the code-driven clay wobble
					   (UpdateToastPose poses FloatPanel's children), the card inside springs when its key fires. *@
					<div class="toast-slot">
						<div class="paper-card key-card possess-toast @(Fired( card ) ? "fired" : "")">
							@* Mouse slots draw the input-icon art (the tutorial card's mouse glyphs) instead of a
							   "LMB" chip; keyboard slots keep the key-cap chip. Same .key-card kit as the round HUD's controls bar. *@
							@if ( InputGlyphs.MouseIcon( card.Key ) is { } icon )
							{
								<span class="key-chip mouse" style=@InputGlyphs.IconStyle( icon )></span>
							}
							else
							{
								<span class="key-chip">@card.Key</span>
							}
							<span>@card.Label</span>
						</div>
					</div>
				}
			</div>
		}
	}

	@* Toast-anchoring debug (console: mimiclay_toast_debug 1) — drawn in the SAME screen space the anchor is
	   computed in, so what you see is literally the data: cyan dots = the hovered prop's projected collider
	   frame points, the orange outline = the screen rect they span (the toast hangs under its bottom edge,
	   centred), green = the final anchor after clamping. *@
	@if ( ToastDebug && _debugValid )
	{
		<div class="toast-debug">
			<div class="dbg-rect" style=@RectStyle()></div>
			@foreach ( var p in _debugPoints )
			{
				<div class="dbg-dot" style=@AtStyle( p )></div>
			}
			@if ( _promptAt is { } anchor )
			{
				<div class="dbg-anchor" style=@AtStyle( anchor )></div>
			}
		</div>
	}
</root>

@code
{
	/// <summary>Draw the toast-anchoring debug: the hovered prop's projected collider frame points, the screen
	/// rect they span, and the chosen anchor. Hover a claimable prop to see it. Console:
	/// <c>mimiclay_toast_debug 1</c>.</summary>
	[ConVar( "mimiclay_toast_debug" )]
	public static bool ToastDebug { get; set; }

	ICrosshairOwner _hunter;

	// Where the prompt is drawn, as viewport fractions (resolution-independent — see PromptStyle), or null when
	// nothing interactive is under the dot. Recomputed every frame in OnUpdate, since it tracks the world.
	Vector2? _promptAt;

	// The cards to draw (key glyph + label), snapshotted off the hunter's hover each frame so the render
	// reads stable data; _cardsHash is their content for BuildHash.
	readonly record struct Card( string Key, string Label, InteractSlot Slot );
	readonly List<Card> _cards = new();
	int _cardsHash;

	// Debug capture from the last ResolvePrompt (only filled while ToastDebug): the projected frame points and
	// the screen rect they span — viewport fractions, the same space the anchor uses.
	readonly List<Vector2> _debugPoints = new();
	Vector2 _debugMin, _debugMax;
	bool _debugValid;

	// The pawn that owns this HUD — the hunter, or a prop on its shoulder camera (HiderController.Grab) — resolved once
	// from the hierarchy (this panel sits on the pawn's HUD child).
	ICrosshairOwner Hunter => _hunter is Component c && c.IsValid() ? _hunter : _hunter = Components.Get<ICrosshairOwner>( FindMode.InAncestors );

	// The owner's live gate (ICrosshairOwner.CrosshairVisible): ownership is read LIVE, not in OnStart — a host-spawned
	// pawn runs OnStart on the owning client before ownership replicates, so an early IsProxy read is stale. The hunter
	// also hides it during a third-person alt-orbit (the camera is off the aim axis, so a centre dot would lie).
	bool Visible => Hunter is Component c && c.IsValid() && Hunter.CrosshairVisible;

	// PreRender, not OnUpdate: the camera is composed after every OnUpdate (ICameraModifier stage), so the prompt's
	// projection ran against last frame's camera and trailed mouse-look. It also guarantees HunterController's
	// hover for this frame is already resolved (OnUpdate order between components is a HashSet). The UI lays out
	// after the scene tick, so positions set here still land this frame.
	protected override void OnPreRender()
	{
		UpdateCards();
		UpdatePressSound();
		_promptAt = _cards.Count > 0 ? ResolvePrompt() : null;
		UpdateToastPose();
	}

	void UpdateCards()
	{
		_cards.Clear();
		var hash = 0;
		if ( Visible && Hunter.HoverContext.HasValue )
		{
			foreach ( var choice in Hunter.Hover )
			{
				var card = new Card( Interactions.KeyLabel( choice.Option.Slot ), choice.Option.Label, choice.Option.Slot );
				_cards.Add( card );
				hash = HashCode.Combine( hash, card );
			}
		}
		_cardsHash = hash;
	}

	// The toasts' clay wobble, driven from ClayClock instead of the action-jitter CSS animation: it snaps
	// pose on the SAME global tick the 3D clay boils on (a CSS animation free-runs from mount and can only
	// match the rate). Card-scale amplitudes = the shared table verbatim; each card is seeded off its index so
	// neighbours hold different poses while still snapping together.
	Panel FloatPanel { get; set; }
	ClayRowPoser _toastPoser; // lazy (hotload-safe); the row remounts per hover — the poser re-poses it immediately

	void UpdateToastPose() => (_toastPoser ??= new()).Update( FloatPanel );

	// Where the prompt goes — the simple, pose-blind scheme: project the prop's COLLISION GEOMETRY
	// (SdfCollider.FramePoints — hull vertices, carved voxel-box corners, on-sphere points, captured from the
	// collider build itself), min/max the projections into the screen rect the prop occupies, and hang the
	// toast under that rect's bottom edge, centred on it. Rotation can't matter: no point set is chosen by
	// "which way is down" — the projection decides everything. And carving can't lie: the frame points carry
	// the build's own carve decisions, so a hollowed bin's rect stops at its real base (anything derived from
	// the brush list instead can't know what a subtract removed — the failure behind every earlier scheme).
	//
	// The fixed screen-space gap under the anchor is the SCSS padding on .possess-float. Points behind the
	// camera are skipped (their projections flip) — that only happens practically inside the prop. Clamped
	// into the viewport so a huge prop up close keeps the prompt visible.
	Vector2? ResolvePrompt()
	{
		_debugValid = false;

		if ( !Visible )
			return null;

		// Whatever the hunter's hover resolved (see HunterController.UpdateInteractHover): its clay is framed by
		// the collider points; something interactive WITHOUT clay falls back to its world bounds.
		if ( Hunter.HoverContext is not { } hover )
			return null;
		var cam = Scene.Camera;
		if ( !cam.IsValid() )
			return null;

		if ( ToastDebug )
			_debugPoints.Clear();

		var min = new Vector2( float.MaxValue, float.MaxValue );
		var max = new Vector2( float.MinValue, float.MinValue );
		var any = false;

		foreach ( var world in WorldFramePoints( hover ) )
		{
			var screen = cam.PointToScreenNormal( world, out var behind );
			if ( behind )
				continue;

			min = Vector2.Min( min, screen );
			max = Vector2.Max( max, screen );
			any = true;

			if ( ToastDebug )
				_debugPoints.Add( screen );
		}

		if ( !any )
			return null;

		if ( ToastDebug )
		{
			_debugMin = min;
			_debugMax = max;
			_debugValid = true;
		}

		// Bottom edge of the rect, centred (screen y grows downward, so the bottom is max.y).
		return new Vector2(
			Math.Clamp( (min.x + max.x) * 0.5f, 0.04f, 0.96f ),
			Math.Clamp( max.y, 0.06f, 0.90f ) );
	}

	// The sculpture-local points to frame: the collider's emitted geometry. Fallback for a sculpture whose
	// collider hasn't built yet (or has none): the brush bounds' corners — loose, but only ever a stand-in
	// for a frame or two.
	static IEnumerable<Vector3> WorldFramePoints( InteractContext hover )
	{
		var sculpture = hover.Sculpture;
		if ( sculpture.IsValid() )
		{
			var t = sculpture.WorldTransform;
			foreach ( var p in FramePoints( sculpture ) )
				yield return t.PointToWorld( p );
			yield break;
		}

		if ( !hover.Target.IsValid() )
			yield break;

		foreach ( var corner in hover.Target.GetBounds().Corners )
			yield return corner;
	}

	static IEnumerable<Vector3> FramePoints( SdfSculpture sculpture )
	{
		// LIVE points: stretched onto the current brushes, so the cards follow a grab's scale preview (which only
		// rebuilds the collider when it commits on release).
		var collider = sculpture.Components.Get<SdfCollider>();
		if ( collider.IsValid() && collider.FramePoints is { Count: > 0 } )
			return collider.LiveFramePoints();

		return Sdf.TryGetBounds( sculpture.Brushes, out var bounds )
			? bounds.Corners
			: Array.Empty<Vector3>();
	}

	// left/top as viewport percentages (this root is full-screen), invariant-formatted so the style parses on any
	// system locale. The SCSS translate pulls the float back to centre it on the point; the card then hangs below.
	static string PromptStyle( Vector2 at )
		=> $"left: {(at.x * 100f).ToString( "0.##", CultureInfo.InvariantCulture )}%; " +
			$"top: {(at.y * 100f).ToString( "0.##", CultureInfo.InvariantCulture )}%;";

	static string Pct( float v ) => (v * 100f).ToString( "0.##", CultureInfo.InvariantCulture );

	string RectStyle()
		=> $"left: {Pct( _debugMin.x )}%; top: {Pct( _debugMin.y )}%; " +
			$"width: {Pct( _debugMax.x - _debugMin.x )}%; height: {Pct( _debugMax.y - _debugMin.y )}%;";

	static string AtStyle( Vector2 at ) => $"left: {Pct( at.x )}%; top: {Pct( at.y )}%;";

	// The anchor moves nearly every frame, so it belongs in the hash — that's what keeps the toast glued under
	// the prop (same reasoning as PlayerNameplates hashing its plate positions). The debug layer re-renders off
	// the rect (the dots can't move without it moving).
	protected override int BuildHash()
		=> HashCode.Combine( Visible, _promptAt, _cardsHash, ToastDebug, _debugValid, _debugMin, _debugMax,
			HashCode.Combine( _debugPoints.Count, FiredSignal ) );

	// A card springs (pop-spring, _button.scss) for FiredSeconds after its slot's key fires — the class going on
	// replays the one-shot animation, coming off resets it for the next press.
	const float FiredSeconds = 0.4f;

	bool Fired( Card card )
		=> Hunter is Component c && c.IsValid() && Hunter.LastFiredSlot == card.Slot && Hunter.SinceFired < FiredSeconds;

	int FiredSignal => Hunter is Component c && c.IsValid() && Hunter.SinceFired < FiredSeconds ? (int)(Hunter.LastFiredSlot ?? 0) + 1 : 0;

	// The press click — the controls bar's sound (UiSounds.HotkeyPress), so every card press sounds the same. A new
	// press is SinceFired going back DOWN (the owner zeroes it on each stamp); only for a card that's on screen. Once per
	// press even if the same key is hammered: every press re-stamps, and each one plays.
	float _lastSinceFired = float.MaxValue;

	void UpdatePressSound()
	{
		if ( Hunter is not Component c || !c.IsValid() )
		{
			_lastSinceFired = float.MaxValue;
			return;
		}

		float since = Hunter.SinceFired;
		bool newPress = since < _lastSinceFired && since < FiredSeconds && Hunter.LastFiredSlot is not null;
		_lastSinceFired = since;
		if ( newPress && Visible )
			UiSounds.PlayHotkeyPress();
	}
}
