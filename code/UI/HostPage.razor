@using System
@using Sandbox
@using Sandbox.Network
@using Sandbox.UI
@using Sandbox.UI.Navigation
@using Microsoft.AspNetCore.Components
@namespace Mimiclay
@inherits Panel
@attribute [Route( "/host" )]

@*
	Host Game screen — set max players + privacy + a session name, then Start. Start hands off to
	MenuNetworking.Host which creates the session and loads the LOBBY; the game mode itself is chosen and
	configured there (RoundSetup), not here — the menu only makes the room people gather in.
*@

<root class="host-page menu-page">

	<WobbleText Text="Host Game" class="menu-title auto" />

	<div class="menu-content">

		@* --- Settings --- *@
		<div class="section">
			<div class="section-label"><span>Settings</span></div>

			<div class="paper-card setting-row">
				<div class="setting-name">
					<div class="mi">group</div><span>Max Players</span>
				</div>
				<div class="stepper">
					<div class="step-btn" @onclick=@(() => Step( -1 ))>remove</div>
					<div class="step-value @Nudge.Class( nameof( Step ) )">@_maxPlayers</div>
					<div class="step-btn" @onclick=@(() => Step( +1 ))>add</div>
				</div>
			</div>

			<div class="paper-card setting-row">
				<div class="setting-name">
					<div class="mi">lock</div><span>Privacy</span>
				</div>
				<div class="seg">
					<div class="pill @(_privacy == LobbyPrivacy.Public ? $"on {Nudge.Class( nameof( SetPrivacy ) )}" : "")" @onclick=@(() => SetPrivacy( LobbyPrivacy.Public ))>Public</div>
					<div class="pill @(_privacy == LobbyPrivacy.FriendsOnly ? $"on {Nudge.Class( nameof( SetPrivacy ) )}" : "")" @onclick=@(() => SetPrivacy( LobbyPrivacy.FriendsOnly ))>Friends</div>
					<div class="pill @(_privacy == LobbyPrivacy.Private ? $"on {Nudge.Class( nameof( SetPrivacy ) )}" : "")" @onclick=@(() => SetPrivacy( LobbyPrivacy.Private ))>Private</div>
				</div>
			</div>

			<div class="paper-card setting-row">
				<div class="setting-name">
					<div class="mi">badge</div><span>Session Name</span>
				</div>
				<TextEntry class="field name-field" Value:bind=@_sessionName Placeholder=@DefaultName />
			</div>
		</div>

		<div class="host-footer">
			@* The lobby's Start Game (Set Up Game): .btn-jitter, the button grows while its WobbleText letters jitter. *@
			<div class="btn-jitter @(MenuNetworking.Busy ? "disabled" : "")" @onclick=@StartGame>
				<WobbleText Text="Start Game" />
			</div>
		</div>

	</div>
</root>

@code
{
	int _maxPlayers = MenuNetworking.DefaultMaxPlayers;
	readonly PickNudge Nudge = new(); // the value wobbles toward the step (see PickNudge)
	LobbyPrivacy _privacy = LobbyPrivacy.Public;
	string _sessionName = "";

	// Placeholder shown when the host leaves the name blank — mirrors what MenuNetworking will name it.
	string DefaultName => MenuNetworking.DefaultSessionName;

	// Left-to-right order of the privacy pills, so the picked one wobbles toward the side it moved to.
	static readonly LobbyPrivacy[] PrivacyOrder = { LobbyPrivacy.Public, LobbyPrivacy.FriendsOnly, LobbyPrivacy.Private };

	void SetPrivacy( LobbyPrivacy p )
		=> Nudge.Change( nameof( SetPrivacy ), Math.Sign( Array.IndexOf( PrivacyOrder, p ) - Array.IndexOf( PrivacyOrder, _privacy ) ),
			() => _privacy, () => _privacy = p );

	void Step( int dir )
	{
		Nudge.Change( nameof( Step ), dir, () => _maxPlayers,
			() => _maxPlayers = Math.Clamp( _maxPlayers + dir, MenuNetworking.MinMaxPlayers, MenuNetworking.MaxMaxPlayers ) );
	}

	void StartGame()
	{
		if ( MenuNetworking.Busy )
			return;

		MenuNetworking.Host( _maxPlayers, _privacy, _sessionName );
		// Host() changes the scene synchronously on success; nothing more to do here.
	}

	protected override int BuildHash()
		=> HashCode.Combine( _maxPlayers, _privacy, _sessionName, MenuNetworking.Busy, Nudge.Version );
}
