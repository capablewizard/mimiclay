@using System
@using Sandbox
@using Sandbox.UI
@namespace Mimiclay
@inherits PanelComponent

@*
	The host's round-setup modal, opened with G in the lobby (host only — spawned by LobbyController.EnsureSetupHud,
	which never makes one on a client). The dialog itself (header, settings, maps, Start) is the shared
	SetupDialog component — the same panel the lobby pad's tablet screen shows — so this file is just the modal
	chrome: the blurred backdrop, the open/close state, the G toggle, and the footer Back button.

	While open it sets the static IsOpen, which PauseMenuSystem reads to force the cursor visible (the same hook the
	pause menu uses) — that also stops the lobby pawn capturing look, since the controllers only read look while the
	cursor is hidden.
*@

<root class="round-setup @(_open ? "open" : "")">
	@if ( _open )
	{
		<div class="backdrop"></div>

		<SetupDialog OnStarted=@(() => SetOpen( false )) />

		@* Back reuses the front-end menu footer (text button, claymation jitter), bottom-left; closes the modal. *@
		<div class="menu-footer">
			<div class="footer-button" @onclick=@(() => SetOpen( false ))>
				<WobbleText Text="Back" />
			</div>
		</div>
	}
</root>

@code
{
	/// <summary>True while the setup modal is up. PauseMenuSystem reads this to force the cursor visible (so the
	/// host can click), the same way it does for the pause menu.</summary>
	public static bool IsOpen { get; private set; }

	bool _open;

	bool LocalIsHost => !Networking.IsActive || Networking.IsHost;

	protected override void OnUpdate()
	{
		// Only the host configures. If a non-host somehow has this panel, keep it shut.
		if ( !LocalIsHost )
		{
			if ( _open ) SetOpen( false );
			return;
		}

		// G toggles the panel — but don't reopen once the launch countdown is already running.
		if ( Input.Keyboard.Pressed( "G" ) )
		{
			if ( !_open && (LobbyManager.Current?.Launching ?? false) )
				return;
			SetOpen( !_open );
		}
	}

	void SetOpen( bool open )
	{
		_open = open;
		IsOpen = open;
		StateHasChanged();
	}

	protected override void OnDestroy()
	{
		base.OnDestroy();
		IsOpen = false; // never leave the static stuck "open" if we're torn down (scene change)
	}

	protected override int BuildHash() => HashCode.Combine( _open );
}
