@using System
@using Sandbox
@using Sandbox.UI
@namespace Mimiclay
@inherits PanelComponent

@*
	The host's round-setup modal, opened with G in the lobby (host only — spawned by LobbyController.EnsureSetupHud,
	which never makes one on a client). Laid out to the "Set Up Game" concept: the clay title with spark dashes,
	then two fixed-size cards. Left, "What are we playing?": the game banner (key art behind < name >), the game's
	top-level choice as radio rows (prop hunt mode, charades phrase source), the three main round rules, and a
	"More rules" expander for everything else. Right, "Pick a place": the picked map big, the rest as a grid with
	Surprise me (random), then the summary pill and Start Game. Both cards keep their size across games; the left
	card scrolls if More rules runs long.

	While open it sets the static IsOpen, which PauseMenuSystem reads to force the cursor visible (the same hook the
	pause menu uses) — that also stops the lobby pawn capturing look, since the controllers only read look while the
	cursor is hidden.
*@

<root class="round-setup @(_open ? "open" : "")">
	@if ( _open )
	{
		<div class="backdrop"></div>

		<div class="dialog">
			@* Title: the big clay SET UP GAME, with sparkle dashes either side. *@
			<div class="title-block">
				<div class="sparks left"><div class="spark s1"><div class="spark-body"></div></div><div class="spark s2"><div class="spark-body"></div></div><div class="spark s3"><div class="spark-body"></div></div></div>
				<div class="title-stack">
					<WobbleText Text="Set Up Game" class="dialog-title auto" />
				</div>
				<div class="sparks right"><div class="spark s1"><div class="spark-body"></div></div><div class="spark s2"><div class="spark-body"></div></div><div class="spark s3"><div class="spark-body"></div></div></div>
			</div>

			<div class="columns">
				@* ── Left: what are we playing? ─────────────────────────────────────────────────────────────── *@
				<div class="paper-card card play-card">
					<div class="card-title">What are we playing?</div>

					@* The game banner: the key art behind it (temporary, the same for every game), < name > centred over it. *@
					<div class="game-banner">
						@* The face (art + frame + shade) and the name spring sideways on a pick; the arrows sit still on top, so
						   rapid clicking never has its target slide out from under the cursor. *@
						<div class="banner-face @GameBumpClass"><div class="art-shade full"></div></div>
						<div class="banner-arrow" @onclick=@(() => CycleGame( -1 ))><div class="mi">chevron_left</div></div>
						<div class="banner-name @GameBumpClass">@Game.Label</div>
						<div class="banner-arrow" @onclick=@(() => CycleGame( 1 ))><div class="mi">chevron_right</div></div>
					</div>

					@* Scroll fades: shown only while there is more to see in that direction (see UpdateScrollFades). *@
					<div class="scroll-wrap" @ref="PlayWrap">
					<div class="play-scroll" @ref="PlayScroll">
					@* The game's top-level choice as radio rows: prop hunt's mode, charades' phrase source.
					   Creative has none, so its blurb stands in. *@
					@if ( G == GameModeKind.PropHunt )
					{
						<div class="radio-row">
							@foreach ( var mode in RoundModes.All )
							{
								var m = mode;
								<div class="radio @(S.Mode == m.Kind ? "on" : "")" @onclick=@(() => LobbyManager.Current?.SetRoundMode( m.Kind ))>
									<div class="radio-dot"></div>
									<div class="radio-text">
										<div class="radio-label">@m.Label</div>
										<div class="radio-desc">@ModeBlurb( m.Kind )</div>
									</div>
								</div>
							}
						</div>
					}
					else if ( G == GameModeKind.Charades )
					{
						<div class="radio-row">
							@foreach ( var src in PhraseSources )
							{
								var s = src;
								<div class="radio @(Ch.Source == s.Kind ? "on" : "")" @onclick=@(() => SetCharadesSource( s.Kind ))>
									<div class="radio-dot"></div>
									<div class="radio-text">
										<div class="radio-label">@s.Label</div>
										<div class="radio-desc">@s.Blurb</div>
									</div>
								</div>
							}
						</div>
					}
					else
					{
						<div class="game-blurb">@Game.Blurb</div>
					}

					<div class="divider"></div>

					@* ── Round rules: the three that matter most ── *@
					<div class="sub-title">Round rules</div>
					@if ( G == GameModeKind.PropHunt )
					{
						<div class="option-row">
							<div class="option-name">Hunters</div>
							<div class="stepper compact">
								<div class="step-btn" @onclick=@(() => AddHunters( -1 ))>remove</div>
								<div class="step-value @Nudge.Class( nameof( AddHunters ) )">@((int)S.HunterCount)</div>
								<div class="step-btn" @onclick=@(() => AddHunters( 1 ))>add</div>
							</div>
						</div>
						<div class="option-row">
							<div class="option-name">Hide time</div>
							<div class="stepper compact">
								<div class="step-btn" @onclick=@(() => AddHide( -15f ))>remove</div>
								<div class="step-value @Nudge.Class( nameof( AddHide ) )">@Secs( S.HideSeconds )</div>
								<div class="step-btn" @onclick=@(() => AddHide( 15f ))>add</div>
							</div>
						</div>
						<div class="option-row">
							<div class="option-name">Hunt time</div>
							<div class="stepper compact">
								<div class="step-btn" @onclick=@(() => AddHunt( -15f ))>remove</div>
								<div class="step-value @Nudge.Class( nameof( AddHunt ) )">@Secs( S.HuntSeconds )</div>
								<div class="step-btn" @onclick=@(() => AddHunt( 15f ))>add</div>
							</div>
						</div>
					}
					else if ( G == GameModeKind.Charades )
					{
						<div class="option-row">
							<div class="option-name">Rounds</div>
							<div class="stepper compact">
								<div class="step-btn" @onclick=@(() => AddCharadesRounds( -1 ))>remove</div>
								<div class="step-value @Nudge.Class( nameof( AddCharadesRounds ) )">@Ch.Rounds</div>
								<div class="step-btn" @onclick=@(() => AddCharadesRounds( 1 ))>add</div>
							</div>
						</div>
						<div class="option-row">
							<div class="option-name">Sculpt time</div>
							<div class="stepper compact">
								<div class="step-btn" @onclick=@(() => AddCharadesSculpt( -15f ))>remove</div>
								<div class="step-value @Nudge.Class( nameof( AddCharadesSculpt ) )">@Secs( Ch.SculptSeconds )</div>
								<div class="step-btn" @onclick=@(() => AddCharadesSculpt( 15f ))>add</div>
							</div>
						</div>
						@if ( Ch.Source == PhraseSource.Players )
						{
							<div class="option-row">
								<div class="option-name">Write time</div>
								<div class="stepper compact">
									<div class="step-btn" @onclick=@(() => AddCharadesWrite( -15f ))>remove</div>
									<div class="step-value @Nudge.Class( nameof( AddCharadesWrite ) )">@Secs( Ch.WriteSeconds )</div>
									<div class="step-btn" @onclick=@(() => AddCharadesWrite( 15f ))>add</div>
								</div>
							</div>
						}
						else
						{
							<div class="option-row">
								<div class="option-name">Topic choices</div>
								<div class="seg compact">
									<div class="pill @(Ch.TopicChoices ? $"on {Nudge.Class( nameof( SetCharadesChoices ) )}" : "")" @onclick=@(() => SetCharadesChoices( true ))>Yes</div>
									<div class="pill @(!Ch.TopicChoices ? $"on {Nudge.Class( nameof( SetCharadesChoices ) )}" : "")" @onclick=@(() => SetCharadesChoices( false ))>No</div>
								</div>
							</div>
						}

						@* Show guessers the masked phrase shape ("_ _ _  _ _ _ _"). *@
						<div class="option-row">
							<div class="option-name">Length hints</div>
							<div class="seg compact">
								<div class="pill @(Ch.WordLengthHints ? $"on {Nudge.Class( nameof( SetCharadesHints ) )}" : "")" @onclick=@(() => SetCharadesHints( true ))>Yes</div>
								<div class="pill @(!Ch.WordLengthHints ? $"on {Nudge.Class( nameof( SetCharadesHints ) )}" : "")" @onclick=@(() => SetCharadesHints( false ))>No</div>
							</div>
						</div>
					}
					else
					{
						<div class="option-row">
							<div class="option-name">Spawn props</div>
							<div class="seg compact">
								<div class="pill @(C.SpawnProps ? $"on {Nudge.Class( nameof( SetSpawnProps ) )}" : "")" @onclick=@(() => SetSpawnProps( true ))>Yes</div>
								<div class="pill @(!C.SpawnProps ? $"on {Nudge.Class( nameof( SetSpawnProps ) )}" : "")" @onclick=@(() => SetSpawnProps( false ))>No</div>
							</div>
						</div>
					}

					@* ── The rest, always open under its own heading: prop hunt's More rules, charades' Topics ── *@
					@if ( HasMoreRules )
					{
						<div class="divider"></div>
						<div class="sub-title">@MoreLabel</div>

						<div class="more-body">
							@if ( G == GameModeKind.PropHunt )
							{
								<div class="option-row">
									<div class="option-name">Taunt timer</div>
									<div class="stepper compact">
										<div class="step-btn" @onclick=@(() => AddTaunt( -5f ))>remove</div>
										<div class="step-value @Nudge.Class( nameof( AddTaunt ) )">@SecsOrNone( S.TauntSeconds )</div>
										<div class="step-btn" @onclick=@(() => AddTaunt( 5f ))>add</div>
									</div>
								</div>
								<div class="option-row">
									<div class="option-name">Silhouette hints</div>
									<div class="stepper compact">
										<div class="step-btn" @onclick=@(() => AddHint( -15f ))>remove</div>
										<div class="step-value @Nudge.Class( nameof( AddHint ) )">@SecsOrNone( S.HintSeconds )</div>
										<div class="step-btn" @onclick=@(() => AddHint( 15f ))>add</div>
									</div>
								</div>
								<div class="option-row">
									<div class="option-name">Reveal time</div>
									<div class="stepper compact">
										<div class="step-btn" @onclick=@(() => AddReveal( -5f ))>remove</div>
										<div class="step-value @Nudge.Class( nameof( AddReveal ) )">@Secs( S.RevealSeconds )</div>
										<div class="step-btn" @onclick=@(() => AddReveal( 5f ))>add</div>
									</div>
								</div>
							}
							else if ( G == GameModeKind.Charades )
							{
								@* Standard: the built-in topics. Chips toggle; Everything lights them all. The last one
								   only goes off while a Community list is ticked (something must be left to draw from). *@
								<div class="option-name chips-label">Standard</div>
								<div class="pill-grid">
									<div class="pill all @(IsEverything ? "on" : "")"
										 @onclick=@(() => LobbyManager.Current?.SetCharadesAllTopics())>Everything</div>
									@foreach ( var topic in CharadesWords.BuiltInTopics() )
									{
										var t = topic;
										<div class="pill @(TopicOn( t.Id ) ? "on" : "")"
											 @onclick=@(() => LobbyManager.Current?.ToggleCharadesTopic( t.Id ))>@t.Title</div>
									}
								</div>

								@* Community: lists added from the Workshop (or made here). Ticked ones play alongside
								   the Standard topics. *@
								<div class="option-name chips-label">Community</div>
								<div class="pill-grid">
									@foreach ( var list in CharadesWorkshop.Added )
									{
										var id = CharadesTopics.WorkshopId( list.FileId );
										<div class="pill @(WorkshopOn( id ) ? "on" : "")"
											 @onclick=@(() => LobbyManager.Current?.ToggleCharadesWorkshopList( id ))>@list.Title</div>
									}
								</div>
								@if ( CharadesWorkshop.Added.Count == 0 )
								{
									<div class="phrases-hint">Lists other players made. Browse the Workshop or make your own.</div>
								}
								<div class="phrases-actions">
									<div class="btn btn-small" @onclick=@(() => OpenWorkshop( WorkshopListsView.Browse ))><div class="mi">public</div><span>Browse</span></div>
									<div class="btn btn-small" @onclick=@(() => OpenWorkshop( WorkshopListsView.Make ))><div class="mi">edit_note</div><span>Create a List</span></div>
								</div>
							}
						</div>
					}
					</div>
					<div class="scroll-fade top"></div>
					<div class="scroll-fade bottom"><div class="mi scroll-hint">expand_more</div></div>
					</div>
				</div>

				@* ── Right: pick a place ────────────────────────────────────────────────────────────────── *@
				<div class="paper-card card place-card">
					<div class="card-title">Pick a place</div>

					@if ( Game.UsesMaps )
					{
						@* The picked map, big, or the Surprise me card when Random is picked. *@
						@if ( SelectedMap is { } sel )
						{
							<div class="map-card featured selected @MapBumpClass">
								@if ( sel.Preview is not null )
								{
									<CoverImage class="map-img" Texture=@sel.Preview />
								}
								<div class="art-shade"></div>
								<div class="map-name">@sel.Title</div>
								<div class="map-check"><div class="mi">check</div></div>
							</div>
						}
						else
						{
							<div class="map-card featured selected surprise @MapBumpClass">
								<div class="surprise-art"><div class="spark a"></div><div class="q">?</div><div class="spark b"></div></div>
								<div class="map-name dark">Surprise me</div>
								<div class="map-check"><div class="mi">check</div></div>
							</div>
						}

						@* Scroll fades: shown only while there is more to see in that direction (see UpdateScrollFades). *@
						<div class="scroll-wrap grid-wrap" @ref="GridWrap">
						<div class="map-grid" @ref="GridScroll">
							@foreach ( var m in MapCatalog.For( G ) )
							{
								if ( IsPicked( m.ResourcePath ) )
									continue;
								var map = m;
								<div class="map-card small" @onclick=@(() => PickMap( map.ResourcePath ))>
									@if ( map.Preview is not null )
									{
										<CoverImage class="map-img" Texture=@map.Preview />
									}
									<div class="art-shade"></div>
									<div class="map-name">@map.Title</div>
								</div>
							}
							@if ( !IsPicked( MapCatalog.RandomIdent ) )
							{
								<div class="map-card small surprise" @onclick=@(() => PickMap( MapCatalog.RandomIdent ))>
									<div class="surprise-art"><div class="spark a"></div><div class="q">?</div><div class="spark b"></div></div>
									<div class="map-name dark">Surprise me</div>
								</div>
							}
						</div>
						<div class="scroll-fade top"></div>
						<div class="scroll-fade bottom"><div class="mi scroll-hint">expand_more</div></div>
						</div>
					}
					else
					{
						<div class="game-blurb">@Game.Blurb</div>
					}

					<div class="place-footer">
						<div class="summary-pill">@Summary</div>
						@* Start Game: the clay button grows on hover and its LETTERS jitter (the WobbleText inside), while the
						   button itself stays still. *@
						<div class="btn-jitter" @onclick=@StartGame><WobbleText Text="Start Game" /></div>
					</div>
				</div>
			</div>
		</div>

		@* Back reuses the front-end menu footer (text button, claymation jitter), bottom-left; closes the modal. *@
		<div class="menu-footer">
			<div class="footer-button" @onclick=@(() => SetOpen( false ))>
				<WobbleText Text="Back" />
			</div>

		</div>

		@* The workshop phrase-list window (Topics → Community → Browse / Create a List) pops over the dialog,
		   so the two panels never move. *@
		@if ( _workshopView is { } view && G == GameModeKind.Charades )
		{
			<WorkshopListsWindow View=@view OnClose=@(() => OpenWorkshop( null ))></WorkshopListsWindow>
		}
	}
</root>

@code
{
	/// <summary>True while the setup modal is up. PauseMenuSystem reads this to force the cursor visible (so the
	/// host can click), the same way it does for the pause menu.</summary>
	public static bool IsOpen { get; private set; }

	bool _open;

	// Pick feedback springs (banner nudge, map hop, stepper value wobble) — see PickNudge. Cleared on open.
	readonly PickNudge Nudge = new();
	string GameBumpClass => Nudge.Class( "game" );
	string MapBumpClass => Nudge.Class( "map", "bump" );

	// The picked map: the lobby's own setting, read straight through (the host's setters write the synced struct
	// immediately, so the cards update on click). A separate local copy used to drift from it — switching games
	// left a map the new game couldn't host on screen while the launch quietly re-rolled.
	string _picked => string.IsNullOrEmpty( S.MapIdent ) ? MapCatalog.RandomIdent : S.MapIdent;

	bool LocalIsHost => !Networking.IsActive || Networking.IsHost;

	// The live settings to display (host owns the LobbyManager, so its setters mutate the synced struct directly).
	RoundSettings S => LobbyManager.Current.IsValid() ? LobbyManager.Current.Settings : RoundSettings.Default;

	// The selected GAME (top taxonomy level) + its catalogue entry, and creative's live settings.
	GameModeKind G => LobbyManager.Current.IsValid() ? LobbyManager.Current.SelectedGame : GameModeKind.PropHunt;
	GameModeInfo Game => GameModes.Get( G );
	CreativeSettings C => LobbyManager.Current.IsValid() ? LobbyManager.Current.CreativeCfg : CreativeSettings.Default;

	// People currently in the lobby — the "y" in the hunters "x/y" readout.
	int LobbyPlayerCount => Connection.All.Count;

	// The picked map resource, or null for Random (or an unresolved path).
	MapResource SelectedMap => MapCatalog.TryGet( _picked, out var m ) ? m : null;

	protected override void OnUpdate()
	{
		if ( _open )
		{
			UpdateScrollFades( PlayWrap, PlayScroll );
			UpdateScrollFades( GridWrap, GridScroll );
		}

		// Only the host configures. If a non-host somehow has this panel, keep it shut.
		if ( !LocalIsHost )
		{
			if ( _open ) SetOpen( false );
			return;
		}

		// G toggles the panel — but don't reopen once the launch countdown is already running, and never
		// OPEN over a running tutorial (its card owns the screen; closing stays allowed so a panel that was
		// already up when the tutorial started can't trap G).
		if ( Input.Keyboard.Pressed( "G" ) )
		{
			if ( !_open && ((LobbyManager.Current?.Launching ?? false) || TutorialDirector.IsRunning) )
				return;
			SetOpen( !_open );
		}
	}

	/// <summary>Debug: print the setup panel's scroll areas (size, offset, wrapper classes) for the scroll fades.</summary>
	[ConCmd( "mimi_dbg_setup_scroll" )]
	public static void DebugScroll()
	{
		var panel = System.Linq.Enumerable.FirstOrDefault( Sandbox.Game.ActiveScene?.GetAllComponents<RoundSetup>() ?? System.Linq.Enumerable.Empty<RoundSetup>() );
		if ( panel is null )
			return;

		Log.Info( $"[setup scroll] play: wrap={(panel.PlayWrap is null ? "null" : panel.PlayWrap.Classes)} size={panel.PlayScroll?.ScrollSize} offset={panel.PlayScroll?.ScrollOffset}" );
		Log.Info( $"[setup scroll] grid: wrap={(panel.GridWrap is null ? "null" : panel.GridWrap.Classes)} size={panel.GridScroll?.ScrollSize} offset={panel.GridScroll?.ScrollOffset}" );
	}

	/// <summary>Debug: toggle the host's setup panel without pressing G (UI screenshots from tooling).
	/// Args: game ("charades", "creative", "prophunt"), then a charades phrase source ("topics", "write"),
	/// then "browse" or "create" to open the workshop list window on that view.</summary>
	[ConCmd( "mimi_dbg_setup" )]
	public static void DebugToggle( string game = "", string source = "", string window = "" )
	{
		var panel = System.Linq.Enumerable.FirstOrDefault( Sandbox.Game.ActiveScene?.GetAllComponents<RoundSetup>() ?? System.Linq.Enumerable.Empty<RoundSetup>() );
		if ( panel is null )
		{
			Log.Warning( "mimi_dbg_setup: no RoundSetup in this scene (host, in the lobby)." );
			return;
		}

		var kind = game.ToLowerInvariant() switch
		{
			"charades" => GameModeKind.Charades,
			"creative" => GameModeKind.Creative,
			"prophunt" => GameModeKind.PropHunt,
			_ => (GameModeKind?)null,
		};
		if ( kind is { } k )
			LobbyManager.Current?.SetGame( k );

		var src = source.ToLowerInvariant() switch
		{
			"topics" => PhraseSource.Topics,
			"write" => PhraseSource.Players,
			_ => (PhraseSource?)null,
		};
		if ( src is { } s )
			LobbyManager.Current?.SetCharadesSource( s );

		panel.SetOpen( kind is not null || !panel._open );

		panel._workshopView = window.ToLowerInvariant() switch
		{
			"browse" => WorkshopListsView.Browse,
			"create" => WorkshopListsView.Make,
			_ => panel._workshopView,
		};
	}

	void SetOpen( bool open )
	{
		_open = open;
		Nudge.Clear();
		if ( !open ) _workshopView = null; // the workshop popup never outlives the dialog
		IsOpen = open;
		StateHasChanged();
	}

	void StartGame()
	{
		LobbyManager.Current?.RequestStart();
		SetOpen( false );
	}

	// ── Game (which game the session plays) ─────────────────────────────────────────────────────────────────
	// Step forward/back through the games catalogue, wrapping around at the ends.
	void CycleGame( int dir )
	{
		var games = GameModes.All;
		if ( games.Length == 0 )
			return;

		var i = System.Array.FindIndex( games, g => g.Kind == G );
		if ( i < 0 ) i = 0;
		i = ((i + dir) % games.Length + games.Length) % games.Length; // wrap both directions
		LobbyManager.Current?.SetGame( games[i].Kind );
		Nudge.Poke( "game", dir );
	}

	// ── Prop hunt's mode-within-the-game (Infection / Teams) ────────────────────────────────────────────────
	// Step forward/back through the variants, wrapping around at the ends.
	void CycleMode( int dir )
	{
		var modes = RoundModes.All;
		if ( modes.Length == 0 )
			return;

		var i = System.Array.FindIndex( modes, m => m.Kind == S.Mode );
		if ( i < 0 ) i = 0;
		i = ((i + dir) % modes.Length + modes.Length) % modes.Length; // wrap both directions
		LobbyManager.Current?.SetRoundMode( modes[i].Kind );
	}

	// ── Settings steppers (clamped by the LobbyManager setters) ──────────────────────────────────────────────
	void AddHunters( int d ) => Nudge.Change( nameof( AddHunters ), MathF.Sign( d ), () => S.HunterCount, () => LobbyManager.Current?.SetHunterCount( (int)S.HunterCount + d ) );
	void AddHide( float d ) => Nudge.Change( nameof( AddHide ), MathF.Sign( d ), () => S.HideSeconds, () => LobbyManager.Current?.SetHideSeconds( S.HideSeconds + d ) );
	void AddHunt( float d ) => Nudge.Change( nameof( AddHunt ), MathF.Sign( d ), () => S.HuntSeconds, () => LobbyManager.Current?.SetHuntSeconds( S.HuntSeconds + d ) );
	void AddTaunt( float d ) => Nudge.Change( nameof( AddTaunt ), MathF.Sign( d ), () => S.TauntSeconds, () => LobbyManager.Current?.SetTauntSeconds( S.TauntSeconds + d ) );
	void AddHint( float d ) => Nudge.Change( nameof( AddHint ), MathF.Sign( d ), () => S.HintSeconds, () => LobbyManager.Current?.SetHintSeconds( S.HintSeconds + d ) );
	void AddReveal( float d ) => Nudge.Change( nameof( AddReveal ), MathF.Sign( d ), () => S.RevealSeconds, () => LobbyManager.Current?.SetRevealSeconds( S.RevealSeconds + d ) );

	// Creative's toggle (host-authority enforced by the LobbyManager setter, like everything above).
	void SetSpawnProps( bool on ) => Nudge.Change( nameof( SetSpawnProps ), on ? -1 : 1, () => C.SpawnProps, () => LobbyManager.Current?.SetSpawnProps( on ) );

	// ── Layout helpers (the concept layout: banner, radios, round rules, More rules, map cards) ─────────────
	// Short radio-row blurbs (the catalogue descriptions are sentence-long).
	static string ModeBlurb( RoundMode mode ) => mode switch
	{
		RoundMode.Infection => "Caught props become hunters.",
		RoundMode.Teams => "Caught props are out.",
		_ => RoundModes.Get( mode ).Description,
	};

	// A property, not a static field: statics survive hotload, so an edited blurb would never show until restart.
	static (PhraseSource Kind, string Label, string Blurb)[] PhraseSources => new[]
	{
		(PhraseSource.Topics, "Topics", "Pick from topic lists."),
		(PhraseSource.Players, "Write Your Own", "Everyone writes one."),
	};

	// The left card's scrolling area (everything under the banner), and the map grid; each sits in a
	// .scroll-wrap that carries the fades.
	Panel PlayScroll { get; set; }
	Panel PlayWrap { get; set; }
	Panel GridScroll { get; set; }
	Panel GridWrap { get; set; }

	// Per frame, straight onto the wrappers' classes (no rebuild): "can-up" lights the top fade once scrolled,
	// "can-down" lights the bottom fade + chevron while there's more below. ScrollSize is the furthest the
	// panel can scroll (0 when everything fits), so nothing shows on content that fits.
	static void UpdateScrollFades( Panel wrap, Panel scroll )
	{
		if ( wrap is null || scroll is null || !scroll.IsValid() )
			return;

		var max = scroll.ScrollSize.y;
		var at = scroll.ScrollOffset.y;
		wrap.SetClass( "can-up", max > 1f && at > 1f );
		wrap.SetClass( "can-down", max > 1f && at < max - 1f );
	}

	// Write Your Own has nothing beyond its round rules, so it gets no extra section.
	bool HasMoreRules => G == GameModeKind.PropHunt || (G == GameModeKind.Charades && Ch.Source != PhraseSource.Players);

	// The extra section's heading: charades' holds the topic lists, so it's called that.
	string MoreLabel => G == GameModeKind.Charades ? "Topics" : "More rules";

	// "Prop Hunt · Infection · Home" — the footer pill restating the picks.
	string Summary
	{
		get
		{
			var parts = new System.Collections.Generic.List<string> { Game.Label };
			if ( G == GameModeKind.PropHunt )
				parts.Add( RoundModes.Get( S.Mode ).Label );
			else if ( G == GameModeKind.Charades )
				parts.Add( System.Array.Find( PhraseSources, p => p.Kind == Ch.Source ).Label );
			if ( Game.UsesMaps )
				parts.Add( SelectedMap?.Title ?? "Surprise me" );
			return string.Join( " · ", parts );
		}
	}

	// ── Charades settings (host-authority enforced by the LobbyManager setters) ─────────────────────────────
	CharadesSettings Ch => LobbyManager.Current.IsValid() ? LobbyManager.Current.CharadesCfg : CharadesSettings.Default;

	void AddCharadesRounds( int d ) => Nudge.Change( nameof( AddCharadesRounds ), MathF.Sign( d ), () => Ch.Rounds, () => LobbyManager.Current?.SetCharadesRounds( Ch.Rounds + d ) );
	void AddCharadesSculpt( float d ) => Nudge.Change( nameof( AddCharadesSculpt ), MathF.Sign( d ), () => Ch.SculptSeconds, () => LobbyManager.Current?.SetCharadesSculptSeconds( Ch.SculptSeconds + d ) );
	void SetCharadesHints( bool on ) => Nudge.Change( nameof( SetCharadesHints ), on ? -1 : 1, () => Ch.WordLengthHints, () => LobbyManager.Current?.SetCharadesWordHints( on ) );
	void SetCharadesChoices( bool on ) => Nudge.Change( nameof( SetCharadesChoices ), on ? -1 : 1, () => Ch.TopicChoices, () => LobbyManager.Current?.SetCharadesTopicChoices( on ) );
	void SetCharadesSource( PhraseSource source ) => LobbyManager.Current?.SetCharadesSource( source );
	void AddCharadesWrite( float d ) => Nudge.Change( nameof( AddCharadesWrite ), MathF.Sign( d ), () => Ch.WriteSeconds, () => LobbyManager.Current?.SetCharadesWriteSeconds( Ch.WriteSeconds + d ) );

	// Built-in topic chips: the empty selection means every one is lit (that's the Everything chip).
	bool IsEverything => CharadesTopics.Parse( Ch.Topics ).Count == 0;
	bool TopicOn( string id )
	{
		var ids = CharadesTopics.Parse( Ch.Topics );
		return ids.Count == 0 || ids.Contains( id ); // NoStandard matches no topic id, so nothing lights
	}

	// Workshop list chips.
	bool WorkshopOn( string id ) => CharadesTopics.Parse( Ch.WorkshopLists ).Contains( id );

	// The workshop window over the dialog (null = closed).
	WorkshopListsView? _workshopView;
	void OpenWorkshop( WorkshopListsView? view )
	{
		_workshopView = view;
		StateHasChanged();
	}

	// Point the round's map setting at the clicked map (its ResourcePath, or RandomIdent).
	void PickMap( string ident )
	{
		LobbyManager.Current?.SetMap( ident );
		Nudge.Poke( "map" );
	}

	bool IsPicked( string ident ) => string.Equals( _picked, ident, StringComparison.OrdinalIgnoreCase );

	static string Secs( float seconds ) => $"{(int)MathF.Round( seconds )}s";

	// For the repeating timers whose setters collapse below-floor to 0 (taunts, silhouette hints): 0 reads "None".
	static string SecsOrNone( float seconds ) => seconds <= 0f ? "None" : Secs( seconds );

	protected override void OnDestroy()
	{
		base.OnDestroy();
		IsOpen = false; // never leave the static stuck "open" if we're torn down (scene change)
	}

	protected override int BuildHash()
		=> HashCode.Combine( _open, S.Mode, (int)S.HunterCount,
			HashCode.Combine( S.HideSeconds, S.HuntSeconds, S.TauntSeconds, S.HintSeconds, S.RevealSeconds ),
			HashCode.Combine( G, C.SpawnProps ),
			HashCode.Combine( Ch.Rounds, Ch.Source, Ch.Topics, Ch.SculptSeconds, Ch.TopicChoices, Ch.WriteSeconds, Ch.WordLengthHints ),
			HashCode.Combine( Ch.WorkshopLists, CharadesWorkshop.Added.Count, _workshopView, _picked, Nudge.Version ),
			LobbyPlayerCount );
}
