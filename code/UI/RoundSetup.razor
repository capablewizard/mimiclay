@using System
@using Sandbox
@using Sandbox.UI
@namespace Mimiclay
@inherits PanelComponent

@*
	The host's round-setup modal, opened with G in the lobby (host only — spawned by LobbyController.EnsureSetupHud,
	which never makes one on a client). Styled to match the front-end Host Game page: a jittering WobbleText header,
	cream paper-card panels, craft-blue setting icons, orange selection, and the shared clay "Start Game" action
	button. Left panel = round settings (hunters + phase times), right panel = map picker (placeholder preview + the
	catalogue list, Random on top).

	While open it sets the static IsOpen, which PauseMenuSystem reads to force the cursor visible (the same hook the
	pause menu uses) — that also stops the lobby pawn capturing look, since the controllers only read look while the
	cursor is hidden.

	PLACEHOLDER: the map preview is a flat tile, and every map button currently selects perftestdebug regardless of
	which you click (we just highlight the clicked one). Wire real previews + per-map selection when maps land.
*@

<root class="round-setup @(_open ? "open" : "")">
	@if ( _open )
	{
		<div class="backdrop"></div>

		<div class="dialog">
			<WobbleText Text="Set Up Game" class="dialog-title auto" />

			@* .body shrink-wraps the columns so the actions row beneath stretches to exactly the panels' width,
			   right-aligning Start to the maps panel's edge (independent of the wider title). *@
			<div class="body">
			<div class="columns">
				@* ── Left: settings ─────────────────────────────────────────── *@
				<div class="paper-card panel settings-panel">
					<div class="section-label"><span>Settings</span></div>

					@* The GAME at the top — prop hunt / creative. Everything below it is that game's own
					   setup: prop hunt's rules variant + times + maps. *@
					<div class="setting-row">
						<div class="setting-name"><div class="mi">@Game.Icon</div><span>Game</span></div>
						<div class="stepper">
							<div class="step-btn" @onclick=@(() => CycleGame( -1 ))>chevron_left</div>
							<div class="step-value mode-value">@Game.Label</div>
							<div class="step-btn" @onclick=@(() => CycleGame( 1 ))>chevron_right</div>
						</div>
					</div>

					@if ( G == GameModeKind.Creative )
					{
					@* Keep the map's pre-placed props, or start from a blank canvas. Yes/No through the same
					   < value > scrubber as every other option — with two values, both arrows just flip it. *@
					<div class="setting-row">
						<div class="setting-name"><div class="mi">weekend</div><span>Spawn Props</span></div>
						<div class="stepper">
							<div class="step-btn" @onclick=@ToggleSpawnProps>chevron_left</div>
							<div class="step-value">@(C.SpawnProps ? "Yes" : "No")</div>
							<div class="step-btn" @onclick=@ToggleSpawnProps>chevron_right</div>
						</div>
					</div>

					@* Further creative options land here — the blank space is reserved so the panel keeps
					   prop hunt's footprint (see .settings-panel min-height) instead of collapsing. *@
					<div class="options-space">
						<div class="options-hint">@Game.Blurb</div>
					</div>
					}
					else if ( G == GameModeKind.Charades )
					{
					@* How many rounds — everyone takes the stage once per round; highest score at the end wins. *@
					<div class="setting-row">
						<div class="setting-name"><div class="mi">flag</div><span>Rounds</span></div>
						<div class="stepper">
							<div class="step-btn" @onclick=@(() => AddCharadesRounds( -1 ))>remove</div>
							<div class="step-value">@Ch.Rounds</div>
							<div class="step-btn" @onclick=@(() => AddCharadesRounds( 1 ))>add</div>
						</div>
					</div>

					<div class="setting-row">
						<div class="setting-name"><div class="mi">timer</div><span>Sculpt Time</span></div>
						<div class="stepper">
							<div class="step-btn" @onclick=@(() => AddCharadesSculpt( -15f ))>remove</div>
							<div class="step-value">@Secs( Ch.SculptSeconds )</div>
							<div class="step-btn" @onclick=@(() => AddCharadesSculpt( 15f ))>add</div>
						</div>
					</div>

					@* Show guessers the masked phrase shape ("_ _ _  _ _ _ _"). *@
					<div class="setting-row">
						<div class="setting-name"><div class="mi">password</div><span>Length Hints</span></div>
						<div class="toggle">
							<div class="toggle-opt @(Ch.WordLengthHints ? "on" : "")" @onclick=@(() => SetCharadesHints( true ))>Yes</div>
							<div class="toggle-opt @(!Ch.WordLengthHints ? "on" : "")" @onclick=@(() => SetCharadesHints( false ))>No</div>
						</div>
					</div>

					@* ── Phrases: where each turn's phrase comes from, then that source's own options ── *@
					<div class="subsection-label"><div class="mi">edit_note</div><span>Phrases</span></div>
					<div class="segmented">
						<div class="seg @(Ch.Source == PhraseSource.Topics ? "on" : "")" @onclick=@(() => SetCharadesSource( PhraseSource.Topics ))>Topics</div>
						<div class="seg @(Ch.Source == PhraseSource.Players ? "on" : "")" @onclick=@(() => SetCharadesSource( PhraseSource.Players ))>Write Your Own</div>
						<div class="seg @(Ch.Source == PhraseSource.Workshop ? "on" : "")" @onclick=@(() => SetCharadesSource( PhraseSource.Workshop ))>Workshop</div>
					</div>

					@if ( Ch.Source == PhraseSource.Topics )
					{
					@* Yes = the mimic picks one of three; No = they're handed one. *@
					<div class="setting-row">
						<div class="setting-name"><div class="mi">style</div><span>Topic Choices</span></div>
						<div class="toggle">
							<div class="toggle-opt @(Ch.TopicChoices ? "on" : "")" @onclick=@(() => SetCharadesChoices( true ))>Yes</div>
							<div class="toggle-opt @(!Ch.TopicChoices ? "on" : "")" @onclick=@(() => SetCharadesChoices( false ))>No</div>
						</div>
					</div>

					@* The built-in topics — chips toggle; Everything lights them all. The last lit chip won't turn
					   off (the manager needs SOMETHING to draw from). *@
					<div class="topic-grid">
						<div class="topic-chip everything @(IsEverything ? "on" : "")"
							 @onclick=@(() => LobbyManager.Current?.SetCharadesAllTopics())>Everything</div>
						@foreach ( var topic in CharadesWords.BuiltInTopics() )
						{
							var t = topic;
							<div class="topic-chip @(TopicOn( t.Id ) ? "on" : "")"
								 @onclick=@(() => LobbyManager.Current?.ToggleCharadesTopic( t.Id ))>@t.Title</div>
						}
					</div>
					}
					else if ( Ch.Source == PhraseSource.Players )
					{
					<div class="setting-row">
						<div class="setting-name"><div class="mi">schedule</div><span>Write Time</span></div>
						<div class="stepper">
							<div class="step-btn" @onclick=@(() => AddCharadesWrite( -15f ))>remove</div>
							<div class="step-value">@Secs( Ch.WriteSeconds )</div>
							<div class="step-btn" @onclick=@(() => AddCharadesWrite( 15f ))>add</div>
						</div>
					</div>
					<div class="phrases-hint">Each round everyone writes a phrase in chat for someone else to sculpt.</div>
					}
					else
					{
					@* Same setting as under Topics: Yes = pick one of three, No = handed one. *@
					<div class="setting-row">
						<div class="setting-name"><div class="mi">style</div><span>Topic Choices</span></div>
						<div class="toggle">
							<div class="toggle-opt @(Ch.TopicChoices ? "on" : "")" @onclick=@(() => SetCharadesChoices( true ))>Yes</div>
							<div class="toggle-opt @(!Ch.TopicChoices ? "on" : "")" @onclick=@(() => SetCharadesChoices( false ))>No</div>
						</div>
					</div>

					@* The community lists added on this machine — chips toggle which ones play. *@
					<div class="topic-grid">
						@foreach ( var list in CharadesWorkshop.Added )
						{
							var id = CharadesTopics.WorkshopId( list.FileId );
							<div class="topic-chip @(WorkshopOn( id ) ? "on" : "")"
								 @onclick=@(() => LobbyManager.Current?.ToggleCharadesWorkshopList( id ))>@list.Title</div>
						}
					</div>
					@if ( CharadesWorkshop.Added.Count == 0 )
					{
						<div class="phrases-hint">No lists yet — browse the Workshop or make your own.</div>
					}
					else if ( CharadesTopics.Parse( Ch.WorkshopLists ).Count == 0 )
					{
						<div class="phrases-hint">Nothing ticked — every built-in topic will play.</div>
					}
					<div class="phrases-actions">
						<div class="btn btn-small" @onclick=@(() => OpenWorkshop( WorkshopListsView.Browse ))><div class="mi">public</div><span>Browse</span></div>
						<div class="btn btn-small" @onclick=@(() => OpenWorkshop( WorkshopListsView.Make ))><div class="mi">edit_note</div><span>Make a List</span></div>
					</div>
					}
					}
					else
					{
					@* Prop hunt's mode-within-the-game — Infection / Teams (the second taxonomy level). *@
					<div class="setting-row">
						<div class="setting-name"><div class="mi">category</div><span>Mode</span></div>
						<div class="stepper">
							<div class="step-btn" @onclick=@(() => CycleMode( -1 ))>chevron_left</div>
							<div class="step-value mode-value">@RoundModes.Get( S.Mode ).Label</div>
							<div class="step-btn" @onclick=@(() => CycleMode( 1 ))>chevron_right</div>
						</div>
					</div>

					<div class="setting-row">
						<div class="setting-name"><div class="mi">group</div><span>Hunters</span></div>
						<div class="stepper">
							<div class="step-btn" @onclick=@(() => AddHunters( -1 ))>remove</div>
							@* x / y — hunters out of the number of people currently in the lobby. *@
							<div class="step-value">@((int)S.HunterCount)/@LobbyPlayerCount</div>
							<div class="step-btn" @onclick=@(() => AddHunters( 1 ))>add</div>
						</div>
					</div>

					<div class="setting-row">
						<div class="setting-name"><div class="mi">schedule</div><span>Hide Time</span></div>
						<div class="stepper">
							<div class="step-btn" @onclick=@(() => AddHide( -15f ))>remove</div>
							<div class="step-value">@Secs( S.HideSeconds )</div>
							<div class="step-btn" @onclick=@(() => AddHide( 15f ))>add</div>
						</div>
					</div>

					<div class="setting-row">
						<div class="setting-name"><div class="mi">timer</div><span>Hunt Time</span></div>
						<div class="stepper">
							<div class="step-btn" @onclick=@(() => AddHunt( -15f ))>remove</div>
							<div class="step-value">@Secs( S.HuntSeconds )</div>
							<div class="step-btn" @onclick=@(() => AddHunt( 15f ))>add</div>
						</div>
					</div>

					<div class="setting-row">
						<div class="setting-name"><div class="mi">campaign</div><span>Taunt Timer</span></div>
						<div class="stepper">
							<div class="step-btn" @onclick=@(() => AddTaunt( -5f ))>remove</div>
							<div class="step-value">@SecsOrNone( S.TauntSeconds )</div>
							<div class="step-btn" @onclick=@(() => AddTaunt( 5f ))>add</div>
						</div>
					</div>

					@* "Who's that pokemon" — how often each prop's HUD pip flashes its disguise silhouette during
					   the Hunt. Steps below the floor read "None" (0), same as the taunt timer above. *@
					<div class="setting-row">
						<div class="setting-name"><div class="mi">question_mark</div><span>Silhouette Hints</span></div>
						<div class="stepper">
							<div class="step-btn" @onclick=@(() => AddHint( -15f ))>remove</div>
							<div class="step-value">@SecsOrNone( S.HintSeconds )</div>
							<div class="step-btn" @onclick=@(() => AddHint( 15f ))>add</div>
						</div>
					</div>

					<div class="setting-row">
						<div class="setting-name"><div class="mi">visibility</div><span>Reveal Time</span></div>
						<div class="stepper">
							<div class="step-btn" @onclick=@(() => AddReveal( -5f ))>remove</div>
							<div class="step-value">@Secs( S.RevealSeconds )</div>
							<div class="step-btn" @onclick=@(() => AddReveal( 5f ))>add</div>
						</div>
					</div>
					}
				</div>

				@if ( Game.UsesMaps )
				{
				@* ── Right: maps (from the Prop Hunt Map assets). Shared by every game that plays on a map —
				   prop hunt launches into the pick; creative stores it for when its own launch path lands. *@
				<div class="paper-card panel maps-panel">
					<div class="section-label"><span>Maps</span></div>

					<div class="map-preview">
						@* The picked map's preview image (set in code via @ref, like MiniMotors' MapCard). Falls back
						   to a label when Random is picked or the map has no image yet. *@
						<image @ref="PreviewImage" class="map-preview-img" />
						@if ( SelectedMap?.Preview is null )
						{
							<div class="map-preview-label">@SelectedLabel</div>
						}
					</div>

					<div class="map-list">
						<div class="map-row @(IsPicked( MapCatalog.RandomIdent ) ? "selected" : "")"
							 @onclick=@(() => PickMap( MapCatalog.RandomIdent ))>Random</div>

						@* Only maps that can HOST the selected game (charades maps carry a stage, etc). *@
						@foreach ( var m in MapCatalog.For( G ) )
						{
							<div class="map-row @(IsPicked( m.ResourcePath ) ? "selected" : "")"
								 @onclick=@(() => PickMap( m.ResourcePath ))>@m.Title</div>
						}
					</div>
				</div>
				}
			</div>

			@* Start sits inside the menu (not the footer), right-aligned to the panels' edge. *@
			<div class="dialog-actions">
				<div class="btn btn-action" @onclick=@StartGame><span>Start Game</span></div>
			</div>
			</div>
		</div>

		@* Back reuses the front-end menu footer (text button, claymation jitter), bottom-left; closes the modal. *@
		<div class="menu-footer">
			<div class="footer-button" @onclick=@(() => SetOpen( false ))>
				<WobbleText Text="Back" />
			</div>
		</div>

		@* The workshop phrase-list window (Phrases → Workshop → Browse / Make a List) pops over the dialog,
		   so the two panels never move. *@
		@if ( _workshopView is { } view && G == GameModeKind.Charades )
		{
			<WorkshopListsWindow View=@view OnClose=@(() => OpenWorkshop( null ))></WorkshopListsWindow>
		}
	}
</root>

@code
{
	/// <summary>True while the setup modal is up. PauseMenuSystem reads this to force the cursor visible (so the
	/// host can click), the same way it does for the pause menu.</summary>
	public static bool IsOpen { get; private set; }

	bool _open;

	// The picked map's ResourcePath (or RandomIdent). Mirrors LobbyManager.Settings.MapIdent, kept here so the
	// row highlight + preview update instantly on click.
	string _picked = MapCatalog.RandomIdent;

	// The preview <image> (set in code, like MiniMotors' MapCard ThumbImage).
	public Sandbox.UI.Image PreviewImage { get; set; }

	bool LocalIsHost => !Networking.IsActive || Networking.IsHost;

	// The live settings to display (host owns the LobbyManager, so its setters mutate the synced struct directly).
	RoundSettings S => LobbyManager.Current.IsValid() ? LobbyManager.Current.Settings : RoundSettings.Default;

	// The selected GAME (top taxonomy level) + its catalogue entry, and creative's live settings.
	GameModeKind G => LobbyManager.Current.IsValid() ? LobbyManager.Current.SelectedGame : GameModeKind.PropHunt;
	GameModeInfo Game => GameModes.Get( G );
	CreativeSettings C => LobbyManager.Current.IsValid() ? LobbyManager.Current.CreativeCfg : CreativeSettings.Default;

	// People currently in the lobby — the "y" in the hunters "x/y" readout.
	int LobbyPlayerCount => Connection.All.Count;

	// The picked map resource, or null for Random (or an unresolved path).
	MapResource SelectedMap => MapCatalog.TryGet( _picked, out var m ) ? m : null;

	string SelectedLabel => SelectedMap?.Title ?? "Random";

	protected override void OnUpdate()
	{
		// Keep the preview image in sync with the picked map (the <image> Texture is driven from code).
		// Older engines cached a panel's draw and needed MarkRenderDirty after assigning Texture or the
		// preview never drew; as of 26.09 drawing is regenerated every frame and that call is an obsolete no-op.
		if ( _open && PreviewImage is not null )
		{
			var tex = SelectedMap?.Preview;
			if ( PreviewImage.Texture != tex )
				PreviewImage.Texture = tex;
		}

		// Only the host configures. If a non-host somehow has this panel, keep it shut.
		if ( !LocalIsHost )
		{
			if ( _open ) SetOpen( false );
			return;
		}

		// G toggles the panel — but don't reopen once the launch countdown is already running, and never
		// OPEN over a running tutorial (its card owns the screen; closing stays allowed so a panel that was
		// already up when the tutorial started can't trap G).
		if ( Input.Keyboard.Pressed( "G" ) )
		{
			if ( !_open && ((LobbyManager.Current?.Launching ?? false) || TutorialDirector.IsRunning) )
				return;
			SetOpen( !_open );
		}
	}

	/// <summary>Debug: toggle the host's setup panel without pressing G (UI screenshots from tooling).
	/// Optional arg picks the game: "charades", "creative", "prophunt".</summary>
	[ConCmd( "mimi_dbg_setup" )]
	public static void DebugToggle( string game = "" )
	{
		var panel = System.Linq.Enumerable.FirstOrDefault( Sandbox.Game.ActiveScene?.GetAllComponents<RoundSetup>() ?? System.Linq.Enumerable.Empty<RoundSetup>() );
		if ( panel is null )
		{
			Log.Warning( "mimi_dbg_setup: no RoundSetup in this scene (host, in the lobby)." );
			return;
		}

		var kind = game.ToLowerInvariant() switch
		{
			"charades" => GameModeKind.Charades,
			"creative" => GameModeKind.Creative,
			"prophunt" => GameModeKind.PropHunt,
			_ => (GameModeKind?)null,
		};
		if ( kind is { } k )
			LobbyManager.Current?.SetGame( k );

		panel.SetOpen( kind is not null || !panel._open );
	}

	void SetOpen( bool open )
	{
		_open = open;
		if ( !open ) _workshopView = null; // the workshop popup never outlives the dialog
		IsOpen = open;
		StateHasChanged();
	}

	void StartGame()
	{
		LobbyManager.Current?.RequestStart();
		SetOpen( false );
	}

	// ── Game (which game the session plays) ─────────────────────────────────────────────────────────────────
	// Step forward/back through the games catalogue, wrapping around at the ends.
	void CycleGame( int dir )
	{
		var games = GameModes.All;
		if ( games.Length == 0 )
			return;

		var i = System.Array.FindIndex( games, g => g.Kind == G );
		if ( i < 0 ) i = 0;
		i = ((i + dir) % games.Length + games.Length) % games.Length; // wrap both directions
		LobbyManager.Current?.SetGame( games[i].Kind );
	}

	// ── Prop hunt's mode-within-the-game (Infection / Teams) ────────────────────────────────────────────────
	// Step forward/back through the variants, wrapping around at the ends.
	void CycleMode( int dir )
	{
		var modes = RoundModes.All;
		if ( modes.Length == 0 )
			return;

		var i = System.Array.FindIndex( modes, m => m.Kind == S.Mode );
		if ( i < 0 ) i = 0;
		i = ((i + dir) % modes.Length + modes.Length) % modes.Length; // wrap both directions
		LobbyManager.Current?.SetRoundMode( modes[i].Kind );
	}

	// ── Settings steppers (clamped by the LobbyManager setters) ──────────────────────────────────────────────
	void AddHunters( int d ) => LobbyManager.Current?.SetHunterCount( (int)S.HunterCount + d );
	void AddHide( float d ) => LobbyManager.Current?.SetHideSeconds( S.HideSeconds + d );
	void AddHunt( float d ) => LobbyManager.Current?.SetHuntSeconds( S.HuntSeconds + d );
	void AddTaunt( float d ) => LobbyManager.Current?.SetTauntSeconds( S.TauntSeconds + d );
	void AddHint( float d ) => LobbyManager.Current?.SetHintSeconds( S.HintSeconds + d );
	void AddReveal( float d ) => LobbyManager.Current?.SetRevealSeconds( S.RevealSeconds + d );

	// Creative's toggle (host-authority enforced by the LobbyManager setter, like everything above).
	void ToggleSpawnProps() => LobbyManager.Current?.SetSpawnProps( !C.SpawnProps );

	// ── Charades settings (host-authority enforced by the LobbyManager setters) ─────────────────────────────
	CharadesSettings Ch => LobbyManager.Current.IsValid() ? LobbyManager.Current.CharadesCfg : CharadesSettings.Default;

	void AddCharadesRounds( int d ) => LobbyManager.Current?.SetCharadesRounds( Ch.Rounds + d );
	void AddCharadesSculpt( float d ) => LobbyManager.Current?.SetCharadesSculptSeconds( Ch.SculptSeconds + d );
	void SetCharadesHints( bool on ) => LobbyManager.Current?.SetCharadesWordHints( on );
	void SetCharadesChoices( bool on ) => LobbyManager.Current?.SetCharadesTopicChoices( on );
	void SetCharadesSource( PhraseSource source ) => LobbyManager.Current?.SetCharadesSource( source );
	void AddCharadesWrite( float d ) => LobbyManager.Current?.SetCharadesWriteSeconds( Ch.WriteSeconds + d );

	// Built-in topic chips: the empty selection means every one is lit (that's the Everything chip).
	bool IsEverything => CharadesTopics.Parse( Ch.Topics ).Count == 0;
	bool TopicOn( string id )
	{
		var ids = CharadesTopics.Parse( Ch.Topics );
		return ids.Count == 0 || ids.Contains( id );
	}

	// Workshop list chips.
	bool WorkshopOn( string id ) => CharadesTopics.Parse( Ch.WorkshopLists ).Contains( id );

	// The workshop window over the dialog (null = closed).
	WorkshopListsView? _workshopView;
	void OpenWorkshop( WorkshopListsView? view )
	{
		_workshopView = view;
		StateHasChanged();
	}

	// Point the round's map setting at the clicked map (its ResourcePath, or RandomIdent).
	void PickMap( string ident )
	{
		_picked = ident;
		LobbyManager.Current?.SetMap( ident );
	}

	bool IsPicked( string ident ) => string.Equals( _picked, ident, StringComparison.OrdinalIgnoreCase );

	static string Secs( float seconds ) => $"{(int)MathF.Round( seconds )}s";

	// For the repeating timers whose setters collapse below-floor to 0 (taunts, silhouette hints): 0 reads "None".
	static string SecsOrNone( float seconds ) => seconds <= 0f ? "None" : Secs( seconds );

	protected override void OnDestroy()
	{
		base.OnDestroy();
		IsOpen = false; // never leave the static stuck "open" if we're torn down (scene change)
	}

	protected override int BuildHash()
		=> HashCode.Combine( _open, S.Mode, (int)S.HunterCount,
			HashCode.Combine( S.HideSeconds, S.HuntSeconds, S.TauntSeconds, S.HintSeconds, S.RevealSeconds ),
			HashCode.Combine( G, C.SpawnProps ),
			HashCode.Combine( Ch.Rounds, Ch.Source, Ch.Topics, Ch.SculptSeconds, Ch.TopicChoices, Ch.WriteSeconds, Ch.WordLengthHints ),
			HashCode.Combine( Ch.WorkshopLists, CharadesWorkshop.Added.Count, _workshopView, _picked ),
			LobbyPlayerCount );
}
