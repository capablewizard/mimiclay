@using System
@using System.Collections.Generic
@using System.Linq
@using Sandbox
@using Sandbox.UI
@namespace Mimiclay
@inherits PanelComponent

@*
	The main player HUD — ONE shared panel for the whole game: lobby + every round phase, hunters + props. It binds
	to RoundContext.Active (whichever of LobbyController / RoundManager is live), so it follows the scene change
	between lobby and map for free and shows nothing it can't resolve.

	Layout:
	  • top-centre — the phase name + the big timer (the hide/hunt countdowns AND the lobby launch countdown). When
	    nothing is timing (idle lobby, pre-start) it just reads 0, as asked.
	  • below the timer — the local player's role chip.
	  • right edge — the hotkey hints (PLACEHOLDER: hard-coded keys/labels, context-switched lobby vs in-round; wire
	    these to real input actions when the controls firm up).

	Class name kept as RoundHud so the scenes that already reference it don't break — think of it as the player HUD.
*@

<root class="round-hud">
	@* Debug overlay — networking/round/pawn state. Off by default; toggle with `mimiclay_debug_hud` in console. *@
	@if ( DebugHud )
	{
		<div style="position: absolute; top: 90px; left: 24px; flex-direction: column; color: #ffcc00; font-family: Consolas; font-size: 18px; text-shadow: 0px 1px 2px black;">
			<div>host=@DbgHost  isActive=@Networking.IsActive</div>
			<div>phase=@Phase</div>
			<div>mode=@DbgMode</div>
			<div>pawns(self/proxy)=@DbgSelfPawns/@DbgProxyPawns</div>
			@* Thumbnail tally. tally = is the rail drawn at all; faces = hunter pawns whose Face sculpt resolved
			   right now (how many portraits CAN draw); cached = how many we've ever resolved. If faces is 0 the
			   problem is pawn/face lookup; if it's 2 and you still see no portraits, it's the panel or its CSS. *@
			<div>tally=@ShowTally hunters=@HunterCount props=@PropsLeft faces=@FaceSignal cached=@_faceCache.Count</div>
		</div>
	}

	@* THUMBNAIL BISECT — `mimiclay_debug_thumb true`. One SdfThumbnail per player in the game, with the plainest
	   styling that can work: no absolute positioning, no transform, no overflow clipping (all three of which the
	   real pips depend on). The magenta border draws each panel's LAYOUT BOX, so "not laid out" reads differently
	   from "laid out but rendered nothing".

	   Several panels at once is the point: that's the case the HUD actually hits, and each one owns a whole
	   SceneWorld. Anyone whose face we can't resolve falls back to a plain sphere so there's always something to
	   draw — a blank cell then means the RENDER failed, not the lookup. *@
	@if ( DebugThumb )
	{
		<div class="thumb-test">
			@foreach ( var player in DebugPlayers )
			{
				var face = FaceOf( player.Connection );

				<div class="thumb-test-cell">
					@* Not Live: these render on change like the real pips do. Re-rendering every panel's scene
					   every frame was only there so a console toggle showed up immediately, and SdfThumbnail
					   now watches mimiclay_thumb_post itself. Set Live=@true here if you need a live view.
					   Source wins when it's valid, so Brushes is only the fallback for an unresolved player. *@
					<SdfThumbnail Source=@face Brushes=@DebugHeadBrushes class="thumb-test-panel" @key=@player.Connection />
					<div class="thumb-test-label">@player.Name@(face.IsValid() ? "" : " (no face — sphere)")</div>
				</div>
			}
		</div>
	}

	<div class="top-centre">
		@* Header above the clock ONLY in the lobby (LOBBY / STARTING GAME). In a round there's no header — the
		   caption under the clock carries the context instead. Static WobbleText for the per-letter clay emboss. *@
		@if ( Phase == RoundPhase.Lobby )
		{
			<WobbleText Text=@PhaseLabel class="phase-name" @key=@PhaseLabel />
		}

		@if ( ShowLobbyStatus )
		{
			@* Idle lobby (before the host starts): the jittering status line stands in for the timer entirely. *@
			<WobbleText Text=@LobbyStatus class="lobby-status auto" Strength=@WobbleText.JitterStrength.Soft @key=@LobbyStatus />
		}
		else
		{
			@* The clock and its two rails. Fixed-width rails keep the timer dead centre on screen however many
			   icons either side is carrying. Left = props still hiding, right = the hunters after them. *@
			<div class="clock-row">
				<div class="rail rail-left">
					@if ( ShowTally )
					{
						@for ( var i = 0; i < ShownProps; i++ )
						{
							<div class="pip prop-pip"></div>
						}
						@if ( HiddenProps > 0 )
						{
							<div class="pip-more">+@HiddenProps</div>
						}
					}
				</div>

				<div class="timer">@TimerText</div>

				<div class="rail rail-right">
					@if ( ShowTally )
					{
						@foreach ( var hunter in ShownHunters )
						{
							var face = FaceOf( hunter.Connection );
							if ( face.IsValid() )
							{
								@* Keyed by connection so the razor rebuild (this panel re-renders every second as
								   the clock ticks) REUSES the panel. A new panel means a new SceneWorld. *@
								<div class="pip hunter-pip">
									<SdfThumbnail Source=@face class="pip-render" @key=@hunter.Connection />
								</div>
							}
							else
							{
								<div class="pip hunter-pip generic"><div class="mi">person</div></div>
							}
						}
						@if ( HiddenHunters > 0 )
						{
							<div class="pip-more">+@HiddenHunters</div>
						}
					}
				</div>
			</div>

			@if ( Phase != RoundPhase.Lobby )
			{
				@* Round context, under the clock (replaces the phase header). *@
				<div class="clock-caption">@ClockCaption</div>

				@if ( LocalRole is PlayerRole.Hunter or PlayerRole.Prop )
				{
					<div class="role-chip role-@(LocalRole.ToString().ToLower())">@LocalRole.ToString().ToUpper()</div>
				}
			}
		}
	</div>

	@* Hidden while sculpt-editing: the edit HUD owns the screen (and its own hint strip) — the lobby/round
	   hotkey hints ("Swap to Hunter", "Set Up Game"…) are noise there. *@
	@if ( SculptEditSession.Current?.IsEditing != true )
	{
	<div class="hotkeys">
		<div class="hotkeys-title">Controls</div>
		@foreach ( var hint in Hotkeys )
		{
			<div class="hotkey">
				@* Colour inline, not in the scss: the stylesheet's .key colour never reached the glyph in-game
				   (rendered white despite the rule), and inline wins the cascade unconditionally. *@
				<div class="key" style="color: #2c2418;">@hint.Key</div>
				<div class="label">@hint.Label</div>
			</div>
		}
	</div>
	}

	@if ( ShowModeCard && SculptEditSession.Current?.IsEditing != true )
	{
		@* Bottom-right: the active game mode + its blurb. Appears once Start is pressed and persists for the whole
		   round. Title is a static WobbleText (per-letter clay emboss, like the phase header). Hidden while
		   sculpt-editing — the edit HUD's colour stack owns the bottom-right corner. *@
		<div class="mode-card">
			<WobbleText Text=@ModeLabel class="mode-title" @key=@ModeLabel />
			<div class="mode-blurb">@ModeDescription</div>
		</div>
	}
</root>

@code
{
	readonly record struct HotkeyHint( string Key, string Label );

	RoundPhase Phase => RoundContext.Active?.Phase ?? RoundPhase.Lobby;

	string PhaseLabel => Phase switch
	{
		// In the lobby the header reads "Lobby" while idle, but flips to "Starting Game" once the launch countdown
		// is running (HasTimer) — the same moment the timer replaces the status line.
		RoundPhase.Lobby => (RoundContext.Active?.HasTimer ?? false) ? "Starting Game" : "Lobby",
		RoundPhase.Starting => "Get Ready",
		RoundPhase.Hide => "Hide",
		RoundPhase.Hunt => "Hunt",
		RoundPhase.Reveal => "Reveal",
		RoundPhase.Consolidation => "Results",
		_ => "",
	};

	// The caption shown UNDER the clock during a round (the phase header is gone there). Tells you what the timer is
	// counting toward.
	string ClockCaption => Phase switch
	{
		RoundPhase.Starting => "Get Ready",
		RoundPhase.Hide => "Until Hunt Begins",
		RoundPhase.Hunt => "Time Left",
		RoundPhase.Reveal => "Revealing",       // not specified — sensible default
		RoundPhase.Consolidation => "Results",  // not specified — sensible default
		_ => "",
	};

	// The big top-centre timer. mm:ss while a phase is counting down (hide / hunt / lobby launch); a plain "0" when
	// nothing is timing — i.e. the idle lobby before the host hits start.
	string TimerText
	{
		get
		{
			if ( RoundContext.Active is null || !RoundContext.Active.HasTimer )
				return "0";

			var t = MathF.Ceiling( RoundContext.Active.TimeRemaining );
			var m = (int)(t / 60f);
			var s = (int)(t % 60f);
			return $"{m}:{s:00}";
		}
	}

	// ── The tally either side of the clock ─────────────────────────────────────────────────────────────────────
	// Left: one pip per prop still hiding. Right: one per hunter, showing that hunter's actual sculpted head where
	// we can resolve it (SdfThumbnail renders it live off an offscreen SdfStage) and a generic glyph where we
	// can't — a remote player's face brushes aren't replicated, so only pawns this machine has get a portrait.
	const int MaxPips = 8;

	// Roles only exist from Starting onward, and Consolidation has its own results readout.
	bool ShowTally => RoundManager.Current.IsValid()
		&& Phase is RoundPhase.Starting or RoundPhase.Hide or RoundPhase.Hunt or RoundPhase.Reveal;

	int PropsLeft => RoundManager.Current.IsValid() ? RoundManager.Current.AliveProps : 0;
	int ShownProps => Math.Min( PropsLeft, MaxPips );
	int HiddenProps => Math.Max( 0, PropsLeft - MaxPips );

	int HunterCount => RoundManager.Current.IsValid() ? RoundManager.Current.Hunters : 0;
	IEnumerable<PlayerInfo> ShownHunters => RoundManager.Current.IsValid()
		? RoundManager.Current.HunterRoster.Take( MaxPips )
		: Enumerable.Empty<PlayerInfo>();
	int HiddenHunters => Math.Max( 0, HunterCount - MaxPips );

	// Last face we managed to resolve per player. Losing a face for even ONE frame used to swap the razor branch
	// from portrait to generic glyph, which deletes the SdfThumbnail panel — and with it a whole SceneWorld, to be
	// rebuilt from scratch the moment the pawn came back. That churn is what a thumbnail "flashing up for a second"
	// looks like. A pawn blinking out is never a reason to forget whose face it was, so we don't.
	readonly Dictionary<Guid, SdfSculpture> _faceCache = new();

	// The face SCULPTURE for a roster row, or null if this machine has never had a pawn for them. Handing over
	// the sculpture rather than its brushes is what lets the thumbnail update on commit instead of following a
	// live drag — see SdfThumbnail.Source.
	SdfSculpture FaceOf( Guid connection )
	{
		foreach ( var h in Scene.GetAllComponents<HunterController>() )
		{
			if ( !h.IsValid() || !h.Face.IsValid() )
				continue;

			// A pawn that hasn't gone on the wire yet has no Network.Owner — if it isn't a proxy, it's ours.
			var owner = h.GameObject.Network.Owner?.Id ?? (h.IsProxy ? (Guid?)null : Connection.Local?.Id);
			if ( owner != connection )
				continue;

			if ( h.Face.Brushes is { Count: > 0 } )
				_faceCache[connection] = h.Face;

			break;
		}

		var cached = _faceCache.GetValueOrDefault( connection );
		return cached.IsValid() ? cached : null;
	}

	// How many hunter faces this machine can currently resolve. Folded into BuildHash so a pawn spawning (or its
	// sculpt arriving) triggers a re-render — otherwise the portraits would stay on the generic glyph until some
	// unrelated change happened to force one.
	int FaceSignal
	{
		get
		{
			var n = 0;
			foreach ( var h in Scene.GetAllComponents<HunterController>() )
				if ( h.IsValid() && h.Face.IsValid() && h.Face.Brushes is { Count: > 0 } )
					n++;
			return n;
		}
	}

	// Idle lobby — no phase timer running. The status line replaces the timer here; the moment the host starts, the
	// launch countdown sets HasTimer and the timer takes back over.
	bool ShowLobbyStatus => Phase == RoundPhase.Lobby && !(RoundContext.Active?.HasTimer ?? false);

	// True for the host (and for the non-networked editor session, which is effectively the host).
	bool LocalIsHost => !Networking.IsActive || Networking.IsHost;

	// What the idle lobby tells the local player to do — the host sets the game up + starts it; everyone else waits.
	string LobbyStatus => LocalIsHost ? "Press G to set up game" : "Waiting for host to start the game";

	// The active game mode. Both managers are NetworkSpawn'd, so their [Sync] Settings reach every client —
	// the lobby no longer needs the launch broadcast to smuggle the mode across.
	RoundMode CurrentMode
	{
		get
		{
			if ( RoundManager.Current.IsValid() ) return RoundManager.Current.Settings.Mode;
			if ( LobbyManager.Current.IsValid() ) return LobbyManager.Current.Settings.Mode;
			return RoundMode.Infection;
		}
	}

	string ModeLabel => RoundModes.Get( CurrentMode ).Label;
	string ModeDescription => RoundModes.Get( CurrentMode ).Description;

	// The mode card shows from Start onward — the lobby launch countdown and every in-map phase — but not in the
	// idle lobby (before the host starts).
	bool ShowModeCard
	{
		get
		{
			if ( RoundContext.Active is null ) return false;
			if ( Phase == RoundPhase.Lobby ) return RoundContext.Active.HasTimer; // launching countdown only
			return true; // any in-map phase
		}
	}

	// The local player's role, read from the pawn they're actually controlling — not the host-side roster, which
	// doesn't reach clients here. Everyone owns exactly one live pawn (IsProxy == false), and a found prop that
	// respawned as a hunter shows Hunter automatically because its pawn type changed.
	PlayerRole LocalRole
	{
		get
		{
			if ( Scene.GetAllComponents<HunterController>().Any( c => c.IsValid() && !c.IsProxy ) )
				return PlayerRole.Hunter;
			if ( Scene.GetAllComponents<HiderController>().Any( c => c.IsValid() && !c.IsProxy ) )
				return PlayerRole.Prop;

			return PlayerRole.Unassigned;
		}
	}

	// PLACEHOLDER hotkey hints, context-switched by phase. In the lobby these mirror the temporary debug keys on
	// LobbyController; in a round they're the pawn controls. Replace with real input-action bindings later.
	IEnumerable<HotkeyHint> Hotkeys
	{
		get
		{
			if ( Phase == RoundPhase.Lobby )
			{
				yield return new( "P", LocalRole == PlayerRole.Prop ? "Swap to Hunter" : "Swap to Prop" );
				yield return new( "N", "Nominate to Hunt" );
				yield return new( "G", "Set Up Game (Host)" );
				yield return new( "Q", "Edit Mode" );
				yield break;
			}

			// In a round: shared movement + role-specific actions.
			yield return new( "WASD", "Move" );
			yield return new( "Alt", "Orbit Camera" );

			if ( LocalRole == PlayerRole.Hunter )
				yield return new( "LMB", "Shoot" );

			yield return new( "Q", LocalRole == PlayerRole.Prop ? "Edit Disguise" : "Edit Face" );
			yield return new( "Tab", "Toggle Wireframes" );
			yield return new( "Esc", "Pause" );
		}
	}

	// TEMP DEBUG helpers — concealment ground-truth readout.
	/// <summary>Shows the yellow state overlay (networking / phase / pawn counts). Console: `mimiclay_debug_hud true`.</summary>
	[ConVar( "mimiclay_debug_hud" )]
	public static bool DebugHud { get; set; }

	/// <summary>Draws one large centred <see cref="SdfThumbnail"/> with plain styling, to isolate whether the
	/// thumbnail panel can render at all. Console: `mimiclay_debug_thumb true`.</summary>
	[ConVar( "mimiclay_debug_thumb" )]
	public static bool DebugThumb { get; set; }

	// Everyone the game knows about, from whichever manager is live, in a stable order (NetDictionary
	// enumeration isn't). Falls back to a single synthetic row so the bisect still draws something when there's
	// no roster at all — solo, or before roles are assigned.
	IEnumerable<PlayerInfo> DebugPlayers
	{
		get
		{
			var roster = RoundManager.Current.IsValid() ? RoundManager.Current.Players.Values
				: LobbyManager.Current.IsValid() ? LobbyManager.Current.Players.Values
				: null;

			if ( roster is null )
				return new[] { new PlayerInfo { Name = "(no roster)" } };

			var rows = roster.OrderBy( p => p.Connection ).ToList();
			return rows.Count > 0 ? rows : new List<PlayerInfo> { new() { Name = "(empty roster)" } };
		}
	}

	int DebugPlayerCount => DebugThumb ? DebugPlayers.Count() : 0;

	List<SdfBrush> _debugHead;

	// Your own saved head, read straight off the slot so this works in the lobby with no pawn spawned. Falls back
	// to a single sphere: the test is "can this panel draw anything", which shouldn't depend on having sculpted.
	List<SdfBrush> DebugHeadBrushes =>
		_debugHead ??= SculptLibrary.Load( SculptLibrary.HeadSlot )?.Brushes
			?? new List<SdfBrush> { new SdfBrush { Shape = SdfShape.Sphere, Size = 24f } };

	bool DbgHost => Networking.IsHost;
	string DbgMode => RoundManager.Current.IsValid() ? RoundManager.Current.Settings.Mode.ToString() : "(no manager)";
	int DbgSelfPawns => Scene.GetAllComponents<HiderController>().Count( c => c.IsValid() && !c.IsProxy )
		+ Scene.GetAllComponents<HunterController>().Count( c => c.IsValid() && !c.IsProxy );
	int DbgProxyPawns => Scene.GetAllComponents<HiderController>().Count( c => c.IsValid() && c.IsProxy )
		+ Scene.GetAllComponents<HunterController>().Count( c => c.IsValid() && c.IsProxy );

	// Re-render when anything visible changes. Hotkeys derive from Phase + LocalRole, so they're covered.
	protected override int BuildHash()
		=> HashCode.Combine( HashCode.Combine( Phase, TimerText, LocalRole, ShowLobbyStatus, LocalIsHost, ShowModeCard, CurrentMode ),
			HashCode.Combine( DbgMode, DbgSelfPawns, DbgProxyPawns, DebugHud,
				SculptEditSession.Current?.IsEditing ?? false ), // hotkey hints hide while sculpt-editing
			HashCode.Combine( ShowTally, PropsLeft, HunterCount, FaceSignal, _faceCache.Count, DebugThumb, DebugPlayerCount ) );
}
