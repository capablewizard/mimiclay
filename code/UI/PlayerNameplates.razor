@using System
@using System.Collections.Generic
@using System.Globalization
@using Sandbox
@using Sandbox.UI
@namespace Mimiclay
@inherits PanelComponent

@*
	Player nameplates — team names floated above other players' heads. SCREEN panels, not world panels: each
	visible pawn's head anchor is projected to the screen every frame and a label is absolutely positioned there
	on the overlay.

	ONE overlay per machine, spawned by NameplateSystem — never on a pawn. It used to live on a "Pawn HUD" child
	of both pawn prefabs, each copy gated to draw only when its pawn was "ours" (!IsProxy) — and an UNOWNED pawn
	slips that gate: released props (creative pop-outs, decoys, a leaver's surviving work) are networked but
	ownerless, and ownerless reads !IsProxy on the HOST (engine NetworkObject.UpdateIsProxy). Every prop a player
	released woke another dormant full-screen copy on the host's machine — identical plates stacked per overlay,
	scene scans multiplied per overlay — which is what melted the host's framerate late in long creative
	sessions. A machine-level singleton has no dormant copies to wake and needs no ownership gate at all.

	Everything shown is networked state: pawns are enumerated from the scene's networked proxies (an infection
	prop hides by not being on the wire at all, so its name can't leak; a concealed HUNTER — and a Teams prop
	during prep — is networked but filtered by its controller's Concealed), the role IS the replicated pawn type
	(HunterController vs HiderController — more truthful than the roster row, and it works in debug scenes too),
	and the name comes from the round's [Sync]'d roster, falling back to the pawn's Network.Owner display name. A released prop draws nothing anywhere: on the
	host it's neither a proxy nor a bot pawn, and on clients it's a proxy with no owner and no roster row, so it
	has no name to show.

	Visibility is team-scoped per RoundMode:
	  • Infection — hunter names show to EVERYONE (hunters see each other; a prop sees the hunters), and prop
	    names never show to anyone — that's the hiding.
	  • Teams — you see your own team only (hunters see hunters, props see props).
	No RoundManager (debug scenes, lobby) falls back to the Infection rule.

	Voice indicators live here too, since this is the machine's full-screen player overlay:
	  • A speaker icon on a plate while that player's voice is playing (PlayerVoice.IsSpeaking — playback-driven,
	    so it works for any proxy). Icons only ever appear on plates that render at all, so a hidden infection
	    prop's speech reveals it by EAR (the 3D voice), never by UI.
	  • A fixed mic icon bottom-centre while OUR OWN mic is transmitting (IsRecording is owner-only truth, read
	    off our own pawn's voice).
*@

<root class="player-nameplates">
	@foreach ( var p in _plates )
	{
		<div class="plate" style=@PlateStyle( p ) @key=@p.PawnId>
			@if ( p.Speaking )
			{
				<i class="speaker" style=@NameStyle()>volume_up</i>
			}
			<div class="name" style=@NameStyle()>@p.Name</div>
		</div>
	}
	@if ( SelfMicLive )
	{
		<i class="self-mic">mic</i>
	}
</root>

@code
{
	/// <summary>The one live overlay, or null. <see cref="NameplateSystem"/> spawns one when this is empty.</summary>
	public static PlayerNameplates Current { get; private set; }

	/// <summary>Extra world-space clearance between the top of the head/disguise bounds and the label.</summary>
	[Property] public float HeadClearance { get; set; } = 5f;

	/// <summary>Uniform scale on the nameplate text. 1 = the base size (<see cref="BaseNameSize"/> px, before the
	/// ScreenPanel's resolution scaling); 2 = double, etc.</summary>
	[Property] public float NameplateScale { get; set; } = 2f;

	// The un-scaled label size in panel px. Set here (not the SCSS) so NameplateScale has a base to multiply —
	// the inline style below always overrides a stylesheet font-size anyway.
	const float BaseNameSize = 18f;

	// One drawn label: which pawn it belongs to (@key, so the razor diff tracks plates across frames), the name,
	// the projected screen position as viewport fractions (resolution-independent — see PlateStyle), and whether
	// that player's voice is currently playing (drives the speaker icon).
	readonly record struct Plate( Guid PawnId, string Name, Vector2 Screen, bool Speaking );

	readonly List<Plate> _plates = new();

	// Other players' pawns gathered this frame, before plates are built — the pass that finds them is also the
	// pass that finds OUR pawn, and TeamVisible needs our role before any plate can be judged.
	readonly List<(GameObject Pawn, PlayerRole Role)> _candidates = new();

	// OUR pawn this frame — the body we're actually driving, re-resolved every update because pawns respawn,
	// convert and swap constantly. Sources the local role (team visibility) and the self-mic indicator.
	GameObject _ownPawn;
	PlayerRole _ownRole;

	// OUR pawn's voice, for the self-mic indicator. IsRecording = the mic is genuinely open and capturing right
	// now (it already folds in push-to-talk state and the user's voip_mode preference — a disabled/undepressed
	// mic never records). Owner-only truth, and _ownPawn is the one body we own.
	PlayerVoice OwnVoice => _ownPawn.IsValid() ? _ownPawn.Components.Get<PlayerVoice>() : null;

	bool SelfMicLive => OwnVoice.IsValid() && OwnVoice.IsRecording;

	// Settings is [Sync]'d, so this reads correctly on every machine incl. late-joiners.
	RoundMode Mode => RoundManager.Current.IsValid() ? RoundManager.Current.Settings.Mode : RoundMode.Infection;

	// There can only be one — the same self-healing PauseMenu uses, in case a stale copy is ever serialised into
	// an asset again (this component used to live on both pawn prefabs).
	protected override void OnAwake()
	{
		base.OnAwake();

		if ( Current.IsValid() && Current != this )
		{
			Log.Warning( $"PlayerNameplates: a second instance appeared on '{GameObject.Name}' — destroying it. " +
				"NameplateSystem spawns the only one; nothing else should carry this component." );
			Destroy();
			return;
		}

		Current = this;
	}

	protected override void OnDestroy()
	{
		base.OnDestroy();

		if ( Current == this )
			Current = null;
	}

	protected override void OnUpdate()
	{
		_plates.Clear();
		_candidates.Clear();
		_ownPawn = null;
		_ownRole = PlayerRole.Unassigned;

		var cam = Scene.Camera;
		if ( !cam.IsValid() )
			return;

		GatherPawns();

		var mode = Mode;

		foreach ( var (pawn, role) in _candidates )
		{
			if ( !TeamVisible( role, _ownRole, mode ) )
				continue;

			var name = NameFor( pawn );
			if ( string.IsNullOrWhiteSpace( name ) )
				continue;

			var screen = cam.PointToScreenNormal( AnchorFor( pawn ), out var behind );
			if ( behind || screen.x < -0.05f || screen.x > 1.05f || screen.y < -0.05f || screen.y > 1.05f )
				continue;

			var voice = pawn.Components.Get<PlayerVoice>();
			_plates.Add( new Plate( pawn.Id, name, screen, voice.IsValid() && voice.IsSpeaking ) );
		}

		// Stable order so the razor diff matches plates by @key, not by enumeration luck.
		_plates.Sort( ( a, b ) => a.PawnId.CompareTo( b.PawnId ) );
	}

	// One walk over every pawn controller in the scene, sorting each body into exactly one of three bins:
	//
	//   • Somebody else's → a plate candidate. "(IsProxy || IsBotPawn)": another player's pawn is a proxy, and a
	//     host-held test bot is neither a proxy nor ours (see RoundManager.IsBotPawn).
	//   • OURS → the local role + the self-mic voice. Resolved through RosterIdOf, which already encodes the
	//     awkward cases: an un-networked pawn on this machine answers as ours (a concealed infection prop before
	//     the Hunt), and an ownerless orphan on the wire answers as NOBODY's (a released prop on the host reads
	//     !IsProxy but is not our body and must never source our role).
	//   • Nobody's (that released prop, on any machine) → ignored entirely.
	//
	// PROPS conceal by never being networked, so a hidden one doesn't exist here at all and its name cannot leak.
	// HUNTERS are networked throughout (the round needs to address them, and their own RPCs have to resolve) and
	// conceal by rendering instead — so they ARE enumerable during prep and have to be filtered explicitly. That
	// asymmetry is deliberate; the two roles hide by different means.
	void GatherPawns()
	{
		var localId = Connection.Local?.Id;

		foreach ( var h in Scene.GetAllComponents<HunterController>() )
		{
			if ( !h.IsValid() )
				continue;

			if ( h.IsProxy || RoundManager.IsBotPawn( h.GameObject ) )
			{
				if ( !h.Concealed )
					_candidates.Add( (h.GameObject, PlayerRole.Hunter) );
			}
			else if ( !_ownPawn.IsValid() && RoundManager.RosterIdOf( h.GameObject ) == localId )
			{
				_ownPawn = h.GameObject;
				_ownRole = PlayerRole.Hunter;
			}
		}

		foreach ( var h in Scene.GetAllComponents<HiderController>() )
		{
			if ( !h.IsValid() )
				continue;

			if ( h.IsProxy || RoundManager.IsBotPawn( h.GameObject ) )
			{
				// Teams props ride the wire from round start and conceal by RENDERING on hunter machines during
				// prep — so, like the hunters above, an enumerable prop is no longer proof of a visible one and
				// has to be filtered explicitly. (TeamVisible would catch today's cases too — a concealed prop
				// is only ever concealed from the other team — but a plate must never outlive its body.)
				if ( !h.Concealed )
					_candidates.Add( (h.GameObject, PlayerRole.Prop) );
			}
			else if ( !_ownPawn.IsValid() && RoundManager.RosterIdOf( h.GameObject ) == localId )
			{
				_ownPawn = h.GameObject;
				_ownRole = PlayerRole.Prop;
			}
		}
	}

	// The mode's team rule. Infection: hunters are public — everyone sees their names — and props are secret from
	// everyone. Teams: fixed sides, you see your own side only.
	static bool TeamVisible( PlayerRole pawnRole, PlayerRole localRole, RoundMode mode )
		=> mode == RoundMode.Infection
			? pawnRole == PlayerRole.Hunter
			: pawnRole == localRole;

	// Prefer the round roster's snapshotted name (it's [Sync]'d and survives odd connection states); fall back to
	// the owning connection's display name so debug scenes and the lobby still label pawns. Resolved through
	// RosterIdOf, not Network.Owner: bot pawns are all host-owned, so the owner's name would label every one of
	// them (and only the host's row would ever be found) — "Bot 3" comes from its row.
	string NameFor( GameObject pawn )
	{
		var id = RoundManager.RosterIdOf( pawn );

		if ( id is not null
			&& RoundManager.Current.IsValid()
			&& RoundManager.Current.Players.TryGetValue( id.Value, out var info )
			&& !string.IsNullOrWhiteSpace( info.Name ) )
			return info.Name;

		return pawn.Network.Owner?.DisplayName;
	}

	// Where the plate anchors in the world: the top of the pawn's OWN sculpture bounds — the hunter's Head sits
	// at its eye and the prop's Disguise IS its body, so "top of the sculpture" is the head for both — plus
	// clearance. The sculpture comes from the controller's own wiring (Face / DisguiseSculpture, both resolved
	// on every machine in their OnStart), NEVER from a descendant search: the pawn also carries gun-clone
	// sculptures now, and a search kept finding the gun and hovering the name over it. A pawn with no resolved
	// sculpture falls back to a rough standing height above its root.
	Vector3 AnchorFor( GameObject pawn )
	{
		var sculpt = AnchorSculpture( pawn );
		if ( sculpt.IsValid() && Sdf.TryGetBounds( sculpt.Brushes, out var bounds ) )
		{
			var topLocal = bounds.Center.WithZ( bounds.Maxs.z );
			return sculpt.WorldTransform.PointToWorld( topLocal ) + Vector3.Up * HeadClearance;
		}

		return pawn.WorldPosition + Vector3.Up * 80f;
	}

	// THE pawn's body sculpture, straight from its controller — the same objects the controllers themselves
	// edit/network, so this can never pick up an attachment by accident.
	static SdfSculpture AnchorSculpture( GameObject pawn )
	{
		var hunter = pawn.Components.Get<HunterController>();
		if ( hunter.IsValid() )
			return hunter.Face;

		var hider = pawn.Components.Get<HiderController>();
		return hider.IsValid() ? hider.DisguiseSculpture : null;
	}

	// left/top as viewport percentages (the overlay root is full-screen), invariant-formatted so the style parses
	// on any system locale. The SCSS translate pulls the plate back over the point (centred, sitting above it).
	static string PlateStyle( Plate p )
		=> $"left: {(p.Screen.x * 100f).ToString( "0.##", CultureInfo.InvariantCulture )}%; " +
			$"top: {(p.Screen.y * 100f).ToString( "0.##", CultureInfo.InvariantCulture )}%;";

	// The label's font-size, from the scale property. Scaling the FONT (not a panel transform) keeps the SCSS
	// centring translate intact and lets the plate's layout box grow with the text.
	string NameStyle()
		=> $"font-size: {(BaseNameSize * NameplateScale).ToString( "0.#", CultureInfo.InvariantCulture )}px;";

	// Positions move nearly every frame, so hashing the plate list keeps the labels glued to the heads; @key stops
	// the diff from rebuilding the label panels themselves.
	protected override int BuildHash()
	{
		var hash = new HashCode();
		hash.Add( NameplateScale ); // live-tunable in the editor — re-render when it changes
		hash.Add( SelfMicLive );
		foreach ( var p in _plates )
		{
			hash.Add( p.PawnId );
			hash.Add( p.Name );
			hash.Add( p.Screen );
			hash.Add( p.Speaking );
		}
		return hash.ToHashCode();
	}
}
