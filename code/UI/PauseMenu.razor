@using System
@using Sandbox
@using Sandbox.UI
@namespace Mimiclay
@inherits PanelComponent

@*
	In-game pause menu. Mirrors the landing menu's big text buttons, but centred (and growing from the centre on
	hover), over a full-screen blur. Toggled with Escape — we CONSUME Input.EscapePressed in OnUpdate (which runs in
	the scene tick, before the s&box menu DLL's LateTick reads it), so OUR menu opens instead of the platform pause
	menu. Spawned per gameplay scene by PauseMenuSystem.
*@

<root class="pause-menu @(_open ? "open" : "")">
	@if ( _open )
	{
		@* Captures input so the game behind can't be clicked, and blurs the scene. *@
		<div class="pause-backdrop"></div>

		<div class="pause-options">
			@if ( _confirm != ConfirmKind.None )
			{
				@* The host leaving kills the session for everyone — make sure that's what they meant. *@
				<div class="confirm-note">You're the host — leaving ends the game for everyone here.</div>
				<div class="menu-button" @onclick=@ConfirmLeave><WobbleText Text="Leave Anyway" /></div>
				<div class="menu-button" @onclick=@CancelConfirm><WobbleText Text="Cancel" /></div>
			}
			else
			{
				<div class="menu-button" @onclick=@Resume><WobbleText Text="Resume" /></div>
				<div class="menu-button" @onclick=@OpenSettings><WobbleText Text="Options" /></div>
				<div class="menu-button" @onclick=@ExitToMenu><WobbleText Text="Main Menu" /></div>
				<div class="menu-button" @onclick=@Quit><WobbleText Text="Quit" /></div>
			}
		</div>
	}
</root>

@code
{
	bool _open;

	// Which destructive action is waiting on the host's "you'll strand everyone" confirmation.
	enum ConfirmKind { None, Menu, Quit }
	ConfirmKind _confirm;

	/// <summary>True while the pause overlay is up. The game's systems read this to go inert and hand the cursor to
	/// the menu while paused — the edit HUD drops pointer-events (so its buttons don't hover behind the overlay),
	/// the orbit camera stops reading nav, and PauseMenuSystem forces the cursor visible.</summary>
	public static bool IsOpen { get; private set; }

	protected override void OnUpdate()
	{
		// Consume Escape before the menu DLL's LateTick sees it (otherwise BOTH our menu and the s&box pause menu
		// would open on one press). Toggling here means Escape opens AND closes our menu, never the platform one.
		if ( Input.EscapePressed )
		{
			Input.EscapePressed = false;

			// One Escape = one intent, resolved here because this is the single Escape consumer (component
			// update order vs. the edit session is arbitrary): close the pause menu if it's open; else
			// cancel a held stamp (drop back to plain editing); else open the pause menu.
			if ( !_open && SculptEditSession.Current is { IsEditing: true, Tool: SculptTool.Sculpt } placing )
				placing.SetTool( SculptTool.Gizmo );
			else
				SetOpen( !_open );
		}
	}

	void SetOpen( bool open )
	{
		_open = open;
		IsOpen = open;   // drives the cursor force (PauseMenuSystem) + the edit HUD / camera going inert
		_confirm = ConfirmKind.None; // opening or closing always lands on the main options, never a stale confirm
		StateHasChanged();
	}

	void Resume() => SetOpen( false );

	// Reuse s&box's own settings overlay (graphics/audio/controls) until we build our own Options screen.
	void OpenSettings() => Game.Overlay.ShowSettingsModal();

	// A host with other players connected ends the session for all of them by leaving — gate that behind an
	// explicit confirmation. Clients (and a solo host) leave freely.
	bool LeaveStrandsOthers => Networking.IsActive && Networking.IsHost && Connection.All.Count > 1;

	// Leave the session and return to our front-end menu scene.
	void ExitToMenu()
	{
		if ( LeaveStrandsOthers )
		{
			_confirm = ConfirmKind.Menu;
			StateHasChanged();
			return;
		}

		SetOpen( false );
		MenuNetworking.ExitToMenu();
	}

	// Leave the game entirely (back to the s&box main menu).
	void Quit()
	{
		if ( LeaveStrandsOthers )
		{
			_confirm = ConfirmKind.Quit;
			StateHasChanged();
			return;
		}

		Game.Close();
	}

	void ConfirmLeave()
	{
		var kind = _confirm;
		SetOpen( false );
		if ( kind == ConfirmKind.Quit )
			Game.Close();
		else
			MenuNetworking.ExitToMenu();
	}

	void CancelConfirm()
	{
		_confirm = ConfirmKind.None;
		StateHasChanged();
	}

	// If we're torn down while open (ExitToMenu / scene change), clear the static so it never sticks "paused".
	protected override void OnDestroy()
	{
		base.OnDestroy();
		IsOpen = false;
	}

	protected override int BuildHash() => HashCode.Combine( _open, _confirm );
}
