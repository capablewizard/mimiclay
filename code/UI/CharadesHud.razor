@using System
@using System.Collections.Generic
@using System.Linq
@using Sandbox
@using Sandbox.UI
@namespace Mimiclay
@inherits PanelComponent

@*
	The Charades player HUD — one panel for the whole game, bound to CharadesManager.Current. Spawned
	programmatically by the manager (Ensure below), so charades maps need no HUD wiring of their own.

	Layout:
	  • top-centre — phase caption + timer + the word strip: the mimic sees their word, guessers see the
	    masked hint, the reveal shows everyone the answer.
	  • bottom centre — the mimic's three word buttons during Choosing (keyed 1/2/3), or the guessers'
	    "press Enter" hint during the sculpt. Guessing itself lives in the ENGINE chat overlay — the
	    familiar Enter box — with CharadesManager censoring correct guesses host-side (IChatEvent).
	  • right edge — the scoreboard with the target score, always up (it IS the game's tension).

	Hidden wholesale while the local player sculpt-edits (the mimic keeps a slim word reminder only) —
	the edit HUD owns the screen there, same deal as RoundHud's hotkey strip.
*@

<root class="charades-hud">
	@* Off-screen icon renderers for the scoreboard heads. FIRST, so it exists before any SdfIcon asks it. *@
	<SdfIconFarm class="icon-farm" />

	@if ( Manager is null )
	{
		<div class="top-centre">
			<WobbleText Text="Setting up" class="status-line" LockStep=@true />
		</div>
	}
	else if ( Editing )
	{
		@* Mimic, in the editor: everything gets out of the edit HUD's way except what they must not
		   forget — the word and the clock. *@
		<div class="mimic-strip">
			<div class="strip-word">@(Manager.LocalWord ?? "")</div>
			<div class="strip-timer">@TimerText</div>
		</div>
	}
	else
	{
		<div class="top-centre">
			@* The lobby's status line (shared .status-line), re-keyed so each new caption starts fresh. *@
			<WobbleText Text=@PhaseCaption class="status-line" LockStep=@true @key=@PhaseCaption />
			@if ( HasTimer )
			{
				<div class="timer">@TimerText</div>
			}

			@if ( WordStrip != "" )
			{
				<div class="word-strip @(Manager.Phase == CharadesPhase.TurnReveal ? "revealed" : "") @(WordStrip.Length > 16 ? "long" : "")">@WordStrip</div>
			}
		</div>

		@* Writing (players-write rounds): everyone types a phrase for someone else — through the chat, which
		   the host swallows and answers privately. The card says where the verb is and who's handed one in. *@
		@if ( Manager.Phase == CharadesPhase.Writing )
		{
			<div class="writing-card paper-card">
				<div class="choice-title">Round @Manager.Round — write a phrase for someone else to sculpt!</div>
				@if ( LocalSubmitted )
				{
					<div class="writing-line done">✍ Sent! Press <span class="key">Enter</span> and type again to change it.</div>
				}
				else
				{
					<div class="writing-line">press <span class="key">Enter</span> and type your phrase</div>
				}
				<div class="writing-count">@SubmittedCount / @WriterCount handed in</div>
			</div>
		}

		@* Choosing: the mimic picks — bottom centre, by click or the 1/2/3 keys (they're standing on the
		   stage as their prop, so the hands stay on the movement keys). A players-write round offers ONE
		   phrase — the one written for them — so the card is a read-it-then-go. Everyone else watches the name. *@
		@if ( Manager.Phase == CharadesPhase.Choosing )
		{
			@if ( Manager.LocalIsMimic && Manager.OfferedWords.Count == 1 )
			{
				<div class="word-choice paper-card single">
					<div class="choice-title">Your phrase:</div>
					<div class="single-phrase">@Manager.OfferedWords[0]</div>
					<div class="choice-row">
						<div class="btn choice-btn" onclick=@( () => Manager.ChooseWord( 0 ) )>
							<div class="choice-key">1</div>
							<span>Let's go!</span>
						</div>
					</div>
				</div>
			}
			else if ( Manager.LocalIsMimic && Manager.OfferedWords.Count > 0 )
			{
				<div class="word-choice paper-card">
					<div class="choice-title">Sculpt one:</div>
					<div class="choice-row">
						@foreach ( var (word, i) in Manager.OfferedWords.Select( ( w, i ) => (w, i) ) )
						{
							<div class="btn choice-btn" onclick=@( () => Manager.ChooseWord( i ) )>
								<div class="choice-key">@(i + 1)</div>
								<span>@word</span>
							</div>
						}
					</div>
				</div>
			}
		}

		@* Podium: the standings, big. *@
		@if ( Manager.Phase == CharadesPhase.Podium )
		{
			<div class="podium paper-card">
				<div class="podium-title">@WinnerLine</div>
				@foreach ( var (p, i) in Manager.Scoreboard.Take( 8 ).Select( ( p, i ) => (p, i) ) )
				{
					<div class="podium-row rank-@i">
						<div class="rank">@(i + 1)</div>
						<div class="name">@p.Name</div>
						<div class="score">@p.Score</div>
					</div>
				}
			</div>
		}

		@* Scoreboard — right edge, always on: the Set Up Game title (clay WobbleText + spark dashes, smaller) saying where we are
		   in the game, over one paper card with a ruled row per player. Each row leads with the player's rendered
		   head, the turn badge (🎨 miming · ✍ wrote it · 🥇🥈✅ guessed) pinned to its corner where the roster pips
		   wear their 🎨 edit palette. The mimic's row is an inset, rounded selection-orange block. *@
		<div class="scoreboard">
			<div class="board-heading">
				<div class="sparks small left"><div class="spark s1"><div class="spark-body"></div></div><div class="spark s2"><div class="spark-body"></div></div><div class="spark s3"><div class="spark-body"></div></div></div>
				<WobbleText Text=@RoundLine class="board-title auto" @key=@RoundLine />
				<div class="sparks small right"><div class="spark s1"><div class="spark-body"></div></div><div class="spark s2"><div class="spark-body"></div></div><div class="spark s3"><div class="spark-body"></div></div></div>
			</div>

			<div class="paper-card board-card">
				@foreach ( var (p, i) in Manager.Scoreboard.Take( 10 ).Select( ( p, i ) => (p, i) ) )
				{
					var icon = _icons.Of( Scene, p.Connection, facesOnly: true );
					var badge = BadgeFor( p );
					@if ( i > 0 )
					{
						<div class="divider"></div>
					}
					<div class="board-row @(p.Connection == Manager.MimicId ? "selected" : "")" style="z-index: @(RowZ( i ))">
						@* Correct guess: the outer box springs up like a hovered button and the inner body (head +
						   badge) jitters — two elements because both animations drive `transform`. *@
						<div class="player-icon @(IsCelebrating( p.Connection ) ? "celebrate" : "")">
							<div class="icon-body">
								@if ( icon.HasPicture )
								{
									<SdfIcon Key=@p.Connection Source=@icon.Sculpture Brushes=@icon.Fallback Pose=@icon.Pose Frozen=@icon.Editing OutlineWidth=@IconOutline Supersample=@RoundHud.IconSupersample class="icon-render" />
								}
								else
								{
									<div class="generic">person</div>
								}

								@* Always mounted, revealed by .on — a removed element can't animate out. The glyph keeps the
								   last badge it showed so the shrink-out doesn't blank first. *@
								<div class="corner-badge @(badge != "" ? "on" : "")">
									<div class="badge-glyph">@BadgeGlyph( p.Connection, badge )</div>
								</div>
							</div>
						</div>
						<div class="name">@p.Name</div>
						<div class="score">@p.Score</div>
					</div>
				}
			</div>
		</div>

		@* Guessing happens in the ENGINE chat (Enter) — the HUD just reminds guessers where the verb is.
		   The phrase's author knows the answer, so they get told to sit this one out instead. *@
		@if ( Manager.Phase == CharadesPhase.Sculpting && !Manager.LocalIsMimic )
		{
			@if ( LocalIsAuthor )
			{
				<div class="guess-hint">✍ you wrote this one — enjoy the show!</div>
			}
			else
			{
				<div class="guess-hint">press <span class="key">Enter</span> and type your guess</div>
			}
		}
	}
</root>

@code
{
	/// <summary>Bring the HUD up in this scene if it isn't already — called by CharadesManager.OnEnabled,
	/// the SpeechBubbleHud.Ensure pattern, so charades maps need no scene wiring.</summary>
	public static void Ensure( Scene scene )
	{
		if ( scene is null || scene.IsEditor || scene.GetAllComponents<CharadesHud>().Any() )
			return;

		var go = new GameObject( true, "Charades HUD" );
		go.Flags |= GameObjectFlags.NotSaved; // runtime-only: never let this end up serialised into an asset
		var panel = go.Components.Create<ScreenPanel>();
		panel.ZIndex = 60; // gameplay HUD: under the EditHud (100) and every dialog
		go.Components.Create<CharadesHud>();
	}

	CharadesManager Manager => CharadesManager.Current;

	// The local player is in the sculpt editor (as the mimic, or somehow otherwise) — the edit HUD owns the
	// screen, this panel slims down to the reminder strip.
	bool Editing => SculptEditSession.Current?.IsEditing == true;

	protected override void OnUpdate()
	{
		// The mimic's 1/2/3 word pick — keyboard-direct (like RoundSetup's G) so it works while they drive
		// their prop around the stage; the on-screen buttons stay clickable for mouse people.
		if ( Manager is null || Manager.Phase != CharadesPhase.Choosing
			|| !Manager.LocalIsMimic || Manager.OfferedWords.Count == 0 )
			return;

		for ( var i = 0; i < Math.Min( 3, Manager.OfferedWords.Count ); i++ )
		{
			if ( Input.Keyboard.Pressed( (i + 1).ToString() ) )
				Manager.ChooseWord( i );
		}
	}

	bool HasTimer => Manager is not null && Manager.Phase != CharadesPhase.Waiting;

	string TimerText
	{
		get
		{
			if ( Manager is null || !HasTimer )
				return "0";

			var t = MathF.Ceiling( MathF.Max( 0f, Manager.PhaseEndsAt ) );
			return $"{(int)(t / 60f)}:{(int)(t % 60f):00}";
		}
	}

	// The status line, in the lobby's voice: plain sentence case, no ellipses or dashes ("Press G to set up game").
	string PhaseCaption => Manager?.Phase switch
	{
		CharadesPhase.Waiting => Manager.AwaitingPlayers
			? $"Loading players ({Manager.LoadedPlayers}/{Manager.ExpectedPlayers})"
			: $"Waiting for players ({Manager.Players.Count}/{Manager.Settings.MinPlayers})",
		CharadesPhase.Starting => "Starting game",
		CharadesPhase.Writing => "Write a phrase for someone else",
		CharadesPhase.Choosing when SingleOffer => Manager.LocalIsMimic ? "Here's your phrase" : $"{Manager.MimicName} is reading their phrase",
		CharadesPhase.Choosing => Manager.LocalIsMimic ? "Pick a phrase" : $"{Manager.MimicName} is picking a phrase",
		CharadesPhase.Sculpting => Manager.LocalIsMimic ? "Sculpt it" : $"{Manager.MimicName} is sculpting, guess in chat",
		CharadesPhase.TurnReveal => "The phrase was",
		CharadesPhase.Podium => "Final standings",
		_ => "",
	} ?? "";

	// The mimic is handed ONE phrase (write-your-own, or Topic Choices off) rather than picking from three.
	bool SingleOffer => Manager is not null && (Manager.Settings.Source == PhraseSource.Players
		|| !Manager.Settings.TopicChoices);
	bool LocalIsAuthor => Manager is not null && Manager.AuthorId != Guid.Empty && Connection.Local?.Id == Manager.AuthorId;

	bool LocalSubmitted
		=> Manager is not null && Connection.Local is { } me && Manager.Players.TryGetValue( me.Id, out var row ) && row.Submitted;

	// Writing progress: humans only (bots hand theirs in instantly).
	int WriterCount => Manager?.Players.Values.Count( p => !p.Bot ) ?? 0;
	int SubmittedCount => Manager?.Players.Values.Count( p => !p.Bot && p.Submitted ) ?? 0;

	// The scoreboard's header: where the game is.
	string RoundLine => Manager switch
	{
		null => "",
		{ Phase: CharadesPhase.Podium } => "Final",
		{ Round: <= 0 } => $"{Manager.Settings.Rounds} round{(Manager.Settings.Rounds == 1 ? "" : "s")}",
		_ => $"Round {Manager.Round} of {Manager.Settings.Rounds}",
	};

	// The word strip under the clock: your word (mimic), the letter-spaced hint (guessers), the answer (reveal).
	string WordStrip
	{
		get
		{
			if ( Manager is null )
				return "";

			if ( Manager.Phase == CharadesPhase.TurnReveal )
				return Manager.RevealedWord;

			if ( Manager.Phase != CharadesPhase.Sculpting )
				return "";

			if ( Manager.LocalIsMimic )
				return Manager.LocalWord ?? "";

			// "___ _____" reads better letter-spaced: "_ _ _   _ _ _ _ _".
			return string.Join( " ", (Manager.WordHint ?? "").Select( c => c == ' ' ? " " : c.ToString() ) );
		}
	}

	// The row badge: the mimic's easel, the phrase's author (writing-round hand-in, or the turn's writer), or
	// the guess-place medal (faster = shinier).
	static string BadgeFor( CharadesPlayer p )
	{
		var m = CharadesManager.Current;
		if ( m.IsValid() && p.Connection == m.MimicId )
			return "🎨";

		if ( m.IsValid() && m.Phase == CharadesPhase.Writing )
			return p.Submitted ? "✍" : "";

		if ( m.IsValid() && m.AuthorId != Guid.Empty && p.Connection == m.AuthorId )
			return "✍";

		return p.GuessedPlace switch { 0 => "", 1 => "🥇", 2 => "🥈", _ => "✅" }; // ✅ not ✔: emoji colour comes from the font, and ✔ draws purple
	}

	// Player heads for the scoreboard — the same resolver the round HUD's pips use, faces only: the mimic's
	// borrowed prop is the puzzle, not who they are (their row keeps the face it last saw them wear).
	readonly RosterIcons _icons = new();

	// Ink outline on the heads, in screen px — the house 2px, matching the round HUD's pips.
	const float IconOutline = 2f;

	// Paint order for the board's rows: TOP row drawn LAST, so each row's head + badge (which overhang downward)
	// land over the row below — z-index only sorts siblings, and a badge and the next row's head are cousins.
	// The engine's sibling key is SiblingIndex + ZIndex (unstable sort); row i is sibling 2i (a divider between
	// each), so z = 1000 − 3i gives keys 1000 − i: strictly descending, and far above the dividers (≤ 20).
	static int RowZ( int row ) => 1000 - 3 * row;

	// Correct-guess celebration: when each player's started (CharadesManager.AnnounceCorrect calls Celebrate on
	// every machine). Their head springs + jitters for CelebrateSeconds, then eases back.
	const float CelebrateSeconds = 2f;
	readonly Dictionary<Guid, RealTimeSince> _celebrating = new();

	/// <summary>Play the correct-guess celebration on this player's scoreboard head.</summary>
	public void Celebrate( Guid player ) => _celebrating[player] = 0;

	bool IsCelebrating( Guid player )
		=> _celebrating.TryGetValue( player, out var since ) && since < CelebrateSeconds;

	// Folded into BuildHash so the class goes on AND comes off (the end is time-driven, nothing else changes).
	int CelebratingSignal => _celebrating.Aggregate( 0, ( h, kv ) => kv.Value < CelebrateSeconds ? h ^ kv.Key.GetHashCode() : h );

	// Last non-empty badge per player, so a badge shrinking away (turn over) still shows its glyph on the way out.
	readonly Dictionary<Guid, string> _lastBadge = new();

	string BadgeGlyph( Guid player, string badge )
	{
		if ( badge != "" )
			_lastBadge[player] = badge;

		return _lastBadge.GetValueOrDefault( player, "" );
	}

	string WinnerLine
	{
		get
		{
			var top = Manager?.Scoreboard.FirstOrDefault();
			return top is { Name.Length: > 0 } ? $"🏆 {top.Value.Name} wins!" : "Game over!";
		}
	}

	protected override int BuildHash()
		=> Manager is null
			? 0
			: HashCode.Combine(
				HashCode.Combine( Manager.Phase, TimerText, Manager.MimicId, Manager.WordHint, Manager.RevealedWord ),
				HashCode.Combine( Manager.OfferedWords.Count, Manager.LocalWord, Editing, PhaseCaption ),
				HashCode.Combine( Manager.Round, Manager.AuthorId, Manager.Settings.Rounds ),
				// Scores/guess places/hand-ins move without anything above noticing.
				Manager.Scoreboard.Aggregate( 17, ( h, p ) => HashCode.Combine( h, p.Connection, p.Score, p.GuessedPlace, p.Submitted ) ),
				Manager.Players.Count,
				// Heads: a pawn spawning / its sculpt arriving / a body swap (see RosterIcons.Signal).
				HashCode.Combine( RosterIcons.Signal( Scene ), _icons.CachedCount, RoundHud.IconSupersample, CelebratingSignal ) );
}
