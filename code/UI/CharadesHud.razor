@using System
@using System.Collections.Generic
@using System.Linq
@using Sandbox
@using Sandbox.UI
@namespace Mimiclay
@inherits PanelComponent

@*
	The Charades player HUD — one panel for the whole game, bound to CharadesManager.Current. Spawned
	programmatically by the manager (Ensure below), so charades maps need no HUD wiring of their own.

	Layout:
	  • top-centre — prop hunt's clock column, in EVERY state: mm:ss clock, status line, the word strip (the
	    mimic sees their word, guessers the masked hint, the reveal the answer), and the lobby countdown for a
	    timed phase's last five seconds.
	  • bottom centre — the mimic's three word buttons during Choosing (keyed 1/2/3), or the guessers'
	    "press Enter" hint during the sculpt. Guessing itself lives in the ENGINE chat overlay — the
	    familiar Enter box — with CharadesManager censoring correct guesses host-side (IChatEvent).
	  • right edge — the scoreboard with the target score, always up (it IS the game's tension).

	Everything BUT the top-centre column hides while the local player sculpt-edits — the edit HUD owns the
	screen there, same deal as RoundHud's hotkey strip; the clock column sits in the centre corridor it leaves.
*@

<root class="charades-hud">
	@* Off-screen icon renderers for the scoreboard heads. FIRST, so it exists before any SdfIcon asks it. *@
	<SdfIconFarm class="icon-farm" />

	@* Top centre — prop hunt's clock column (RoundHud's .timer), the SAME in every state, sculpt-editing
	   included: a one-or-two-word clay title (the scoreboard heading's look), the mm:ss clock under it, then the
	   word strip. For a timed phase's last five seconds the clock itself becomes the lobby countdown: one big
	   digit that springs in fresh each second, with Countdown's tick/tock. *@
	<div class="top-centre">
		@* The scoreboard heading's look: the shared .clay-title between .sparks.small, re-keyed so each new title
		   starts fresh. *@
		<div class="phase-heading">
			<div class="sparks small left"><div class="spark s1"><div class="spark-body"></div></div><div class="spark s2"><div class="spark-body"></div></div><div class="spark s3"><div class="spark-body"></div></div></div>
			<WobbleText Text=@PhaseCaption class="clay-title auto" @key=@PhaseCaption />
			<div class="sparks small right"><div class="spark s1"><div class="spark-body"></div></div><div class="spark s2"><div class="spark-body"></div></div><div class="spark s3"><div class="spark-body"></div></div></div>
		</div>
		@* The clock in the standard clay header (the scoreboard title's WobbleText look), at the round-clock size.
		   Counting down, it's re-keyed per digit so each one is a new element and its spring replays. *@
		@if ( ShowCountdown )
		{
			<WobbleText Text=@TimerText class="timer clock-timer counting auto" @key=@TimerText />
		}
		else
		{
			<WobbleText Text=@TimerText class="timer clock-timer auto" />
		}

		@if ( WordStrip != "" )
		{
			var revealed = Manager.Phase == CharadesPhase.TurnReveal || LocalSolved;
			@* The spring lives on a wrapper: the card's own jitter already owns its `transform`. It plays once as
			   .revealed goes on (the switch to the uppercase answer). *@
			<div class="word-pop @(revealed ? "popped" : "")">
			<div class="word-strip paper-card @(revealed ? "revealed" : "") @((Manager.LocalIsMimic && Manager.Phase is CharadesPhase.Sculpting or CharadesPhase.Choosing) || Manager.Phase == CharadesPhase.Writing ? "mine" : "") @(WordStrip.Length > 12 ? "long" : "")">
				<div class="word">
					@foreach ( var w in WordStripWords )
					{
						<div class="word-group">
							@foreach ( var c in w )
							{
								<div class="ch">@c</div>
							}
						</div>
					}
				</div>
				<div class="pencil badge-glyph">✏️</div>
			</div>
			</div>
		}
	</div>

	@if ( Manager is not null && !Editing )
	{
		@* Writing (players-write rounds): everyone types a phrase for someone else — through the chat, which the
		   host swallows and answers privately. Charades' usual pieces carry it: "WRITE!" over the clock, YOUR
		   hand-in on the word card once sent (WordStrip), the ✏️ badges on the board for who's in, and this —
		   the guess hint's plain line, saying where the verb is and how many are handed in. *@
		@if ( Manager.Phase == CharadesPhase.Writing )
		{
			<div class="guess-hint">
				<span>Press</span>
				<div class="key-chip">Enter</div>
				<span>@(LocalSubmitted ? "to change your phrase." : "to write a phrase.")</span>
				<span class="hint-count">@SubmittedCount / @WriterCount handed in</span>
			</div>
		}

		@* Choosing between several phrases: the mimic picks with the big centre buttons or the 1/2/3 keys. A
		   single phrase (players-write, or Topic Choices off) is no choice at all — that beat is a short READ:
		   the phrase sits on the word card (WordStrip) while the clock counts it down, then the sculpt opens. *@
		@if ( Manager.Phase == CharadesPhase.Choosing )
		{
			@if ( Manager.LocalIsMimic && Manager.OfferedWords.Count > 1 )
			{
				@* The pick: the lobby's clay Start button (.btn-jitter) per phrase, in a row under the prop. Play holds
				   still and the cursor shows until one's chosen (CharadesManager.LocalPicking); 1/2/3 still pick
				   (OnUpdate), each button wearing its key. *@
				<div class="pick-stack">
					@foreach ( var (word, i) in Manager.OfferedWords.Select( ( w, i ) => (w, i) ) )
					{
						<div class="btn-jitter pick-btn" onclick=@( () => Manager.ChooseWord( i ) )>
							<div class="key-chip">@(i + 1)</div>
							<WobbleText Text=@word />
						</div>
					}
				</div>
			}
		}

		@* Podium: the final standings, centre stage — the scoreboard's own pieces at full size: the winner line as
		   the clay title between spark dashes, then a ruled card of the top rows (heads, medal badges, rank, name,
		   score), the winner's row lit in the selection highlight. The corner board steps aside meanwhile. *@
		@if ( Manager.Phase == CharadesPhase.Podium )
		{
			<div class="podium">
				<div class="board-heading">
					<div class="sparks small left"><div class="spark s1"><div class="spark-body"></div></div><div class="spark s2"><div class="spark-body"></div></div><div class="spark s3"><div class="spark-body"></div></div></div>
					<WobbleText Text=@WinnerLine class="clay-title auto" @key=@WinnerLine />
					<div class="sparks small right"><div class="spark s1"><div class="spark-body"></div></div><div class="spark s2"><div class="spark-body"></div></div><div class="spark s3"><div class="spark-body"></div></div></div>
				</div>

				<div class="paper-card board-card">
					@foreach ( var (row, i) in RankedRows( PodiumCap ).Select( ( r, i ) => (r, i) ) )
					{
						var p = row.Player;
						var icon = _icons.Of( Scene, p.Connection, facesOnly: true );
						var medal = MedalFor( row.Rank );
						@if ( i > 0 )
						{
							<div class="divider"></div>
						}
						<div class="board-row @(row.Rank == 1 ? "selected" : "")" style="z-index: @(RowZ( i ))">
							<div class="player-icon">
								<div class="icon-body">
									@if ( icon.HasPicture )
									{
										<SdfIcon Key=@p.Connection Source=@icon.Sculpture Brushes=@icon.Fallback Pose=@icon.Pose Frozen=@icon.Editing OutlineWidth=@IconOutline Supersample=@RoundHud.IconSupersample class="icon-render" />
									}
									else
									{
										<div class="generic">person</div>
									}
									<div class="corner-badge @(medal != "" ? "on" : "")">
										<div class="badge-glyph">@medal</div>
									</div>
									@* Talking on voice chat — top-right, the round HUD's 🔊 spot. *@
									<div class="corner-badge speak @(_speakers.Contains( p.Connection ) ? "on" : "")">
										<div class="speak-tilt"><div class="badge-glyph">🔊</div></div>
									</div>
								</div>
							</div>
							<div class="rank">@(row.Rank).</div>
							<div class="name">@p.Name</div>
							<div class="score">@p.Score</div>
						</div>
					}
				</div>
			</div>
		}

		@* Scoreboard — right edge, always on: the Set Up Game title (clay WobbleText + spark dashes, smaller) saying where we are
		   in the game, over one paper card with a ruled row per player. Each row leads with the player's rendered
		   head, the turn badge (🎨 miming · ✏️ wrote it · 🥇🥈✅ guessed) pinned to its corner where the roster pips
		   wear their 🎨 edit palette. The mimic's row is an inset, rounded selection-orange block. *@
		@* Not during the podium — it shows the standings centre stage. *@
		@if ( Manager.Phase != CharadesPhase.Podium )
		{
		<div class="scoreboard">
			<div class="board-heading">
				<div class="sparks small left"><div class="spark s1"><div class="spark-body"></div></div><div class="spark s2"><div class="spark-body"></div></div><div class="spark s3"><div class="spark-body"></div></div></div>
				<WobbleText Text=@RoundLine class="clay-title auto" @key=@RoundLine />
				<div class="sparks small right"><div class="spark s1"><div class="spark-body"></div></div><div class="spark s2"><div class="spark-body"></div></div><div class="spark s3"><div class="spark-body"></div></div></div>
			</div>

			@* The board, then — only when you rank below its cap — a second card holding just YOUR row, so your own
			   score is always on screen however big the lobby. *@
			@foreach ( var card in BoardCards )
			{
			<div class="paper-card board-card @(card.Self ? "self-card" : "")">
				@foreach ( var (row, i) in card.Rows.Select( ( r, i ) => (r, i) ) )
				{
					var p = row.Player;
					var icon = _icons.Of( Scene, p.Connection, facesOnly: true );
					var badge = BadgeFor( p );
					@if ( i > 0 )
					{
						<div class="divider"></div>
					}
					<div class="board-row @(p.Connection == Manager.MimicId ? "selected" : "")" style="z-index: @(RowZ( i ))">
						@* Correct guess: the outer box springs up like a hovered button and the inner body (head +
						   badge) jitters — two elements because both animations drive `transform`. *@
						<div class="player-icon @(IsCelebrating( p.Connection ) ? "celebrate" : "")">
							<div class="icon-body">
								@if ( icon.HasPicture )
								{
									<SdfIcon Key=@p.Connection Source=@icon.Sculpture Brushes=@icon.Fallback Pose=@icon.Pose Frozen=@icon.Editing OutlineWidth=@IconOutline Supersample=@RoundHud.IconSupersample class="icon-render" />
								}
								else
								{
									<div class="generic">person</div>
								}

								@* Always mounted, revealed by .on — a removed element can't animate out. The glyph keeps the
								   last badge it showed so the shrink-out doesn't blank first. *@
								<div class="corner-badge @(badge != "" ? "on" : "")">
									<div class="badge-glyph">@BadgeGlyph( p.Connection, badge )</div>
								</div>
								@* Talking on voice chat — the one free corner, top-right (the round HUD's 🔊 spot; turn badge
								   bottom-right, "+X" top-left). Inside .icon-body so it rides the celebration jitter with the head. *@
								<div class="corner-badge speak @(_speakers.Contains( p.Connection ) ? "on" : "")">
									<div class="speak-tilt"><div class="badge-glyph">🔊</div></div>
								</div>
							</div>
							@* +points, on the head's top-left corner (the roster's nominate-hand spot) when they score — the
							   corner-badge lifecycle (always mounted, sprung in by .on, the glyph jittering once it lands), so it
							   shrinks away when the jitter stops. AFTER the head so it paints over it. *@
							<div class="corner-badge score-pop @(IsPopping( p.Connection ) ? "on" : "")">
								<div class="badge-glyph">@ScorePopText( p.Connection )</div>
							</div>
						</div>
						<div class="rank">@(row.Rank).</div>
						<div class="name">@p.Name</div>
						<div class="score">@p.Score</div>
					</div>
				}
			</div>
			}
		</div>
		}

		@* Guessing happens in the ENGINE chat (Enter) — the HUD just reminds guessers where the verb is.
		   The phrase's author knows the answer, so they get told to sit this one out instead. *@
		@if ( Manager.Phase == CharadesPhase.Sculpting && !Manager.LocalIsMimic )
		{
			@* A plain line over the scene, bottom centre, with the house keycap (.key-chip, _controls.scss) for Enter.
			   Gone once you've got it — the host swallows anything further you type until the reveal. *@
			@if ( LocalIsAuthor )
			{
				<div class="guess-hint"><span>✏️ You wrote this one!</span></div>
			}
			else if ( string.IsNullOrEmpty( Manager.SolvedWord ) )
			{
				<div class="guess-hint"><span>Press</span><div class="key-chip">Enter</div><span>to type your guess</span></div>
			}
		}
	}
</root>

@code
{
	/// <summary>Bring the HUD up in this scene if it isn't already — called by CharadesManager.OnEnabled,
	/// the SpeechBubbleHud.Ensure pattern, so charades maps need no scene wiring.</summary>
	public static void Ensure( Scene scene )
	{
		if ( scene is null || scene.IsEditor || scene.GetAllComponents<CharadesHud>().Any() )
			return;

		var go = new GameObject( true, "Charades HUD" );
		go.Flags |= GameObjectFlags.NotSaved; // runtime-only: never let this end up serialised into an asset
		var panel = go.Components.Create<ScreenPanel>();
		panel.ZIndex = 60; // gameplay HUD: under the EditHud (100) and every dialog
		go.Components.Create<CharadesHud>();
	}

	CharadesManager Manager => CharadesManager.Current;

	// The local player is in the sculpt editor (as the mimic, or somehow otherwise) — the edit HUD owns the
	// screen, this panel slims down to the reminder strip.
	bool Editing => SculptEditSession.Current?.IsEditing == true;

	protected override void OnUpdate()
	{
		TickTypingSound();
		TickCountdownSound();

		// The mimic's 1/2/3 word pick — keyboard-direct (like RoundSetup's G) so it works while they drive
		// their prop around the stage; the on-screen buttons stay clickable for mouse people.
		if ( Manager is null || Manager.Phase != CharadesPhase.Choosing
			|| !Manager.LocalIsMimic || Manager.OfferedWords.Count < 2 ) // a single phrase is a read beat, not a pick
			return;

		for ( var i = 0; i < Math.Min( 3, Manager.OfferedWords.Count ); i++ )
		{
			if ( Input.Keyboard.Pressed( (i + 1).ToString() ) )
				Manager.ChooseWord( i );
		}
	}

	bool HasTimer => Manager is not null && Manager.Phase != CharadesPhase.Waiting;

	// The clock turns into the lobby countdown for a timed phase's last five seconds.
	const float CountdownSeconds = 5f;
	// Not during the reveal ("It was..."): that pause is for reading the answer, not a race.
	bool ShowCountdown => HasTimer && Manager.Phase != CharadesPhase.TurnReveal
		&& Manager.PhaseEndsAt > 0f && Manager.PhaseEndsAt <= CountdownSeconds;
	int CountdownDigit => Math.Max( 1, (int)MathF.Ceiling( Manager.PhaseEndsAt ) );

	// Countdown's tick/tock as each digit lands. Starts at 0 (never a real digit) so the first one sounds too.
	int _soundedDigit;

	void TickCountdownSound()
	{
		if ( !ShowCountdown )
		{
			_soundedDigit = 0;
			return;
		}

		var digit = CountdownDigit;
		if ( digit == _soundedDigit )
			return;

		_soundedDigit = digit;
		Countdown.PlayTick( digit );
	}

	string TimerText
	{
		get
		{
			if ( Manager is null || !HasTimer )
				return "0:00"; // untimed (Waiting, or no manager yet): the clock still holds its place

			// The last five seconds: one digit, the lobby countdown's way (floored at 1 — see Countdown.Digit).
			if ( ShowCountdown )
				return CountdownDigit.ToString();

			var t = MathF.Ceiling( MathF.Max( 0f, Manager.PhaseEndsAt ) );
			return $"{(int)(t / 60f)}:{(int)(t % 60f):00}";
		}
	}

	// The title over the clock — kept to a word or two ("Sculpt it!", "Guess!"): the clock, word strip and the
	// cards below carry the detail.
	string PhaseCaption => Manager is null ? "Setting up!" : Manager.Phase switch
	{
		CharadesPhase.Waiting => Manager.AwaitingPlayers
			? $"Loading ({Manager.LoadedPlayers}/{Manager.ExpectedPlayers})"
			: $"Waiting ({Manager.Players.Count}/{Manager.Settings.MinPlayers})",
		CharadesPhase.Starting => "Starting!",
		CharadesPhase.Writing => "Write!",
		CharadesPhase.Choosing when SingleOffer => Manager.LocalIsMimic ? "Your phrase!" : "Reading!",
		CharadesPhase.Choosing => Manager.LocalIsMimic ? "Pick one!" : "Picking!",
		CharadesPhase.Sculpting => Manager.LocalIsMimic ? "Sculpt it!" : "Guess!",
		CharadesPhase.TurnReveal => "It was...",
		CharadesPhase.Podium => "Final scores!",
		_ => "",
	} ?? "";

	// The mimic is handed ONE phrase (write-your-own, or Topic Choices off) rather than picking from three.
	bool SingleOffer => Manager is not null && (Manager.Settings.Source == PhraseSource.Players
		|| !Manager.Settings.TopicChoices);
	bool LocalIsAuthor => Manager is not null && Manager.AuthorId != Guid.Empty && Connection.Local?.Id == Manager.AuthorId;

	bool LocalSubmitted
		=> Manager is not null && Connection.Local is { } me && Manager.Players.TryGetValue( me.Id, out var row ) && row.Submitted;

	// Writing progress: humans only (bots hand theirs in instantly).
	int WriterCount => Manager?.Players.Values.Count( p => !p.Bot ) ?? 0;
	int SubmittedCount => Manager?.Players.Values.Count( p => !p.Bot && p.Submitted ) ?? 0;

	// The scoreboard's header: where the game is.
	string RoundLine => Manager switch
	{
		null => "",
		{ Phase: CharadesPhase.Podium } => "Final",
		{ Round: <= 0 } => $"{Manager.Settings.Rounds} round{(Manager.Settings.Rounds == 1 ? "" : "s")}",
		_ => $"Round {Manager.Round} of {Manager.Settings.Rounds}",
	};

	// The word strip under the clock: your word (mimic), the letter-spaced hint (guessers), the answer (reveal).
	string WordStrip
	{
		get
		{
			if ( Manager is null )
				return "";

			if ( Manager.Phase == CharadesPhase.TurnReveal )
				return Manager.RevealedWord;

			// Writing: the phrase you handed in (echoed back by the host), once you have — yours, uppercase like the
			// mimic's brief.
			if ( Manager.Phase == CharadesPhase.Writing )
				return Manager.LocalSubmission ?? "";

			// A single-phrase turn's read beat: the mimic's phrase, before the sculpt opens.
			if ( Manager.Phase == CharadesPhase.Choosing )
				return Manager.LocalIsMimic && Manager.OfferedWords.Count == 1 ? Manager.OfferedWords[0] : "";

			if ( Manager.Phase != CharadesPhase.Sculpting )
				return "";

			if ( Manager.LocalIsMimic )
				return Manager.LocalWord ?? "";

			// Solved: the answer, typed into the box over the mask, one slot at a time.
			if ( Manager.SolvedWord is { Length: > 0 } solved )
			{
				var typed = TypedCount( solved );
				return new string( solved.Select( ( c, i ) => c == ' ' ? ' ' : i < typed ? c : '_' ).ToArray() );
			}

			return Manager.WordHint ?? "";
		}
	}

	// The strip drawn as words of fixed-width character slots (see .ch in the sheet): a "_" and the letter that
	// replaces it take the same room, so the box never resizes as a solved answer types in — and the mask, the
	// mimic's word and the reveal all share one spacing.
	IEnumerable<string> WordStripWords => WordStrip.Split( ' ', StringSplitOptions.RemoveEmptyEntries );

	// The local guesser's correct answer typing itself out: one character per TypeSeconds from the moment this
	// machine first sees it (CharadesManager.SolvedWord, sent by targeted RPC on the correct guess).
	const float TypeSeconds = 0.08f;
	string _typingWord;
	RealTimeSince _typingSince;

	int TypedCount( string word )
	{
		if ( word != _typingWord )
		{
			_typingWord = word;
			_typingSince = 0;
		}

		return Math.Min( word.Length, (int)(_typingSince / TypeSeconds) + 1 );
	}

	// The speech bubbles' typewriter tick as each letter of the solved answer lands — at most one per frame,
	// like theirs. Spaces type silently.
	int _soundedTyped;

	void TickTypingSound()
	{
		var word = Manager is not null && Manager.Phase == CharadesPhase.Sculpting && !Manager.LocalIsMimic
			? Manager.SolvedWord
			: null;

		if ( string.IsNullOrEmpty( word ) )
		{
			_soundedTyped = 0;
			return;
		}

		var typed = TypedCount( word );
		if ( typed <= _soundedTyped )
			return;

		if ( word[typed - 1] != ' ' )
			UiSounds.TypeBlip();

		_soundedTyped = typed;
	}

	// The word box lights up (the reveal's highlight, uppercase) once the local guesser's answer has finished
	// typing AND sat there for SolvedPause — a beat to read what was typed before it flips to the revealed look.
	// The last letter lands at (length − 1) × TypeSeconds (TypedCount shows the first one immediately).
	const float SolvedPause = 0.4f;

	bool LocalSolved => Manager is not null && Manager.Phase == CharadesPhase.Sculpting && !Manager.LocalIsMimic
		&& Manager.SolvedWord is { Length: > 0 } w && TypedCount( w ) >= w.Length
		&& _typingSince >= (w.Length - 1) * TypeSeconds + SolvedPause;

	// The row badge: the mimic's easel, the phrase's author (writing-round hand-in, or the turn's writer), or
	// the guess-place medal (faster = shinier).
	static string BadgeFor( CharadesPlayer p )
	{
		var m = CharadesManager.Current;
		if ( m.IsValid() && p.Connection == m.MimicId )
			return "🎨";

		if ( m.IsValid() && m.Phase == CharadesPhase.Writing )
			return p.Submitted ? "✏️" : "";

		if ( m.IsValid() && m.AuthorId != Guid.Empty && p.Connection == m.AuthorId )
			return "✏️";

		return p.GuessedPlace switch { 0 => "", 1 => "🥇", 2 => "🥈", _ => "✅" }; // ✅ not ✔: emoji colour comes from the font, and ✔ draws purple
	}

	// Player heads for the scoreboard — the same resolver the round HUD's pips use, faces only: the mimic's
	// borrowed prop is the puzzle, not who they are (their row keeps the face it last saw them wear).
	readonly RosterIcons _icons = new();

	// Ink outline on the heads, in screen px — the house 2px, matching the round HUD's pips.
	const float IconOutline = 2f;

	// The board: the top BoardCap rows. When the local player ranks below them, a second card follows holding
	// only THEIR row (with their real rank), so you can always see your own score however big the lobby.
	const int BoardCap = 10;

	readonly record struct BoardRow( CharadesPlayer Player, int Rank );
	readonly record struct BoardCard( List<BoardRow> Rows, bool Self );

	List<BoardCard> BoardCards
	{
		get
		{
			var all = Manager.Scoreboard;

			// Competition ranking ("1, 2, 2, 4"): one more than the number of players strictly ahead, so ties share
			// a place rather than the seat order deciding who's "2nd" on equal points.
			int RankOf( int index ) => 1 + all.Count( q => q.Score > all[index].Score );

			var top = new List<BoardRow>( BoardCap );
			for ( var i = 0; i < Math.Min( all.Count, BoardCap ); i++ )
				top.Add( new BoardRow( all[i], RankOf( i ) ) );

			var cards = new List<BoardCard> { new( top, false ) };

			var me = Connection.Local?.Id ?? Guid.Empty;
			var mine = all.FindIndex( q => q.Connection == me );
			if ( mine >= BoardCap )
				cards.Add( new BoardCard( new List<BoardRow> { new( all[mine], RankOf( mine ) ) }, true ) );

			return cards;
		}
	}

	// Paint order for the board's rows: TOP row drawn LAST, so each row's head + badge (which overhang downward)
	// land over the row below — z-index only sorts siblings, and a badge and the next row's head are cousins.
	// The engine's sibling key is SiblingIndex + ZIndex (unstable sort); row i is sibling 2i (a divider between
	// each), so z = 1000 − 3i gives keys 1000 − i: strictly descending, and far above the dividers (≤ 20).
	static int RowZ( int row ) => 1000 - 3 * row;

	// Correct-guess celebration (CharadesManager.AnnounceCorrect, on every machine): the guesser's head springs +
	// jitters for CelebrateSeconds, then eases back. Points pop separately — a green "+X" on the head's corner for
	// the same span — because the sculptor scores too (+1 per early guess) without a head celebration of their own.
	const float CelebrateSeconds = 2f;
	readonly Dictionary<Guid, RealTimeSince> _celebrating = new();

	// Pop entries outlive their showing span so the +X keeps its number while it shrinks away.
	readonly Dictionary<Guid, (RealTimeSince Since, int Points)> _pops = new();

	/// <summary>Play the correct-guess celebration on this player's scoreboard head, popping +<paramref name="points"/>.</summary>
	public void Celebrate( Guid player, int points )
	{
		_celebrating[player] = 0;
		AwardPoints( player, points );
	}

	/// <summary>Pop +<paramref name="points"/> on this player's head. Points landing while a pop is still up add to
	/// it (two quick guesses read "+2" on the sculptor) and restart its span.</summary>
	public void AwardPoints( Guid player, int points )
	{
		var total = IsPopping( player ) ? _pops[player].Points + points : points;
		_pops[player] = (0, total);
	}

	bool IsCelebrating( Guid player )
		=> _celebrating.TryGetValue( player, out var since ) && since < CelebrateSeconds;

	bool IsPopping( Guid player )
		=> _pops.TryGetValue( player, out var p ) && p.Since < CelebrateSeconds;

	string ScorePopText( Guid player )
		=> _pops.TryGetValue( player, out var p ) ? $"+{p.Points}" : "";

	// Folded into BuildHash so the classes go on AND come off (the ends are time-driven, nothing else changes),
	// and a pop's total changing re-renders its number.
	int CelebratingSignal
		=> _celebrating.Aggregate( 0, ( h, kv ) => kv.Value < CelebrateSeconds ? h ^ kv.Key.GetHashCode() : h )
		^ _pops.Aggregate( 17, ( h, kv ) => kv.Value.Since < CelebrateSeconds ? h ^ HashCode.Combine( kv.Key, kv.Value.Points ) : h );

	// Last non-empty badge per player, so a badge shrinking away (turn over) still shows its glyph on the way out.
	readonly Dictionary<Guid, string> _lastBadge = new();

	string BadgeGlyph( Guid player, string badge )
	{
		if ( badge != "" )
			_lastBadge[player] = badge;

		return _lastBadge.GetValueOrDefault( player, "" );
	}

	// The podium's title: the winner by name, or a tie when the top score is shared (competition ranks — several
	// players can be "1."). Plain words: it's a clay WobbleText, and an emoji there would take the letter emboss.
	string WinnerLine
	{
		get
		{
			var all = Manager?.Scoreboard;
			if ( all is not { Count: > 0 } || string.IsNullOrEmpty( all[0].Name ) )
				return "Game over!";

			return all.Count( p => p.Score == all[0].Score ) > 1 ? "It's a tie!" : $"{all[0].Name} wins!";
		}
	}

	// How many standings the podium card lists.
	const int PodiumCap = 8;

	// The top `take` players with their competition ranks (see BoardCards for the "1, 2, 2, 4" rule).
	List<BoardRow> RankedRows( int take )
	{
		var all = Manager.Scoreboard;
		return all.Take( take )
			.Select( ( p, i ) => new BoardRow( p, 1 + all.Count( q => q.Score > p.Score ) ) )
			.ToList();
	}

	// The podium's corner badge by finishing place — the guess medals, plus bronze for third.
	static string MedalFor( int rank ) => rank switch { 1 => "🥇", 2 => "🥈", 3 => "🥉", _ => "" };

	// Who's talking on voice chat (roster ids, with the badge hold) — drives the 🔊 corner badges. Refreshed in
	// BuildHash, which runs every frame, so the render reads the same set the hash saw.
	HashSet<Guid> _speakers = new();

	int SpeakersSignal()
	{
		_speakers = PlayerVoice.Speakers( Scene );
		return _speakers.Aggregate( 31, ( h, id ) => h ^ id.GetHashCode() );
	}

	protected override int BuildHash()
		=> Manager is null
			? 0
			: HashCode.Combine(
				SpeakersSignal(),
				HashCode.Combine( Manager.Phase, TimerText, Manager.MimicId, Manager.WordHint, Manager.RevealedWord ),
				HashCode.Combine( Manager.OfferedWords.Count, Manager.LocalWord, Editing, PhaseCaption ),
				HashCode.Combine( Manager.Round, Manager.AuthorId, Manager.Settings.Rounds, WordStrip, LocalSolved ), // the solved answer types out, then flips after a pause — both time-driven
				// Scores/guess places/hand-ins move without anything above noticing.
				Manager.Scoreboard.Aggregate( 17, ( h, p ) => HashCode.Combine( h, p.Connection, p.Score, p.GuessedPlace, p.Submitted ) ),
				Manager.Players.Count,
				// Heads: a pawn spawning / its sculpt arriving / a body swap (see RosterIcons.Signal).
				HashCode.Combine( RosterIcons.Signal( Scene ), _icons.CachedCount, RoundHud.IconSupersample, CelebratingSignal ) );
}
